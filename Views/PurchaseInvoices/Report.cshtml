@model NewsApp2.ViewModels.Purchasing.PurchaseReportVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@{
    ViewData["Title"] = "تقرير المشتريات";
}

<h1>تقرير المشتريات</h1>

<form method="get" class="row g-3 mb-3">
    <div class="col-md-3">
        <label class="form-label">@L["From"]</label>
        <input type="text" name="from" value="@(Model.From?.ToString("dd/MM/yyyy"))" class="form-control" placeholder="dd/MM/yyyy" />
    </div>
    <div class="col-md-3">
        <label class="form-label">@L["To"]</label>
        <input type="text" name="to" value="@(Model.To?.ToString("dd/MM/yyyy"))" class="form-control" placeholder="dd/MM/yyyy" />
    </div>
    <div class="col-md-3 align-self-end">
        <button type="submit" class="btn btn-primary">تصفية</button>
        <a asp-action="Report" class="btn btn-secondary">إعادة تعيين</a>
    </div>
</form>

<div class="mb-3">
    <strong>إجمالي المشتريات:</strong> @Model.SumDinar.ToString("0.00") دينار
</div>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@L["Number"]</th>
                <th>@L["Date"]</th>
                <th>الحالة</th>
                <th>الإجمالي</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            var localizedStatus = string.IsNullOrWhiteSpace(row.Status) ? "-" : L[row.Status].Value;
            <tr>
                <td>@row.Number</td>
                <td><span dir="ltr">@row.InvoiceDate.ToString("dd/MM/yyyy")</span></td>
                <td>@localizedStatus</td>
                <td>@row.TotalDinar.ToString("0.00")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

