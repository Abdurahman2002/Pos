@model NewsApp2.ViewModels.Inventory.PricingPolicyVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@{
    ViewData["Title"] = L["Pricing Policy"];
    var canManagePricingPolicy = ViewBag.CanManagePricingPolicy is bool b && b;
}

<h1>@L["Pricing Policy"]</h1>
<p class="text-muted mb-3">@L["Set item sale prices and cashier discount limit."]</p>

<form asp-action="Index" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="card mb-3">
        <div class="card-body row g-3 align-items-end">
            <div class="col-md-4">
                <label asp-for="MaxCashierDiscountPercent" class="form-label">@L["Max Cashier Discount (%)"]</label>
                <input asp-for="MaxCashierDiscountPercent" class="form-control" type="number" step="0.01" min="0" max="100" readonly="@(canManagePricingPolicy ? null : "readonly")" />
                <span asp-validation-for="MaxCashierDiscountPercent" class="text-danger"></span>
            </div>
            <div class="col-md-8 text-muted">
                @if (canManagePricingPolicy)
                {
                    @L["Cashier can only apply percent discount up to this limit."]
                }
                else
                {
                    @L["You can set price only for unpriced items. Discount policy is controlled by admin."]
                }
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header fw-semibold">@L["Item Sale Prices (LYD)"]</div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>@L["Item"]</th>
                        <th>@L["Category"]</th>
                        <th style="width:220px;">@L["Default Sale Price LYD"]</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        var currentPrice = Model.Items[i].DefaultSalePriceLyd.GetValueOrDefault();
                        var canEditThisItem = canManagePricingPolicy || currentPrice <= 0;
                        <tr>
                            <td>
                                @Model.Items[i].ItemName
                                <input asp-for="Items[i].ItemId" type="hidden" />
                                <input asp-for="Items[i].ItemName" type="hidden" />
                                <input asp-for="Items[i].CategoryName" type="hidden" />
                            </td>
                            <td>@(Model.Items[i].CategoryName ?? "-")</td>
                            <td>
                                <input asp-for="Items[i].DefaultSalePriceLyd" class="form-control" type="number" step="0.01" min="0" readonly="@(canEditThisItem ? null : "readonly")" />
                                <span asp-validation-for="Items[i].DefaultSalePriceLyd" class="text-danger"></span>
                                @if (!canEditThisItem)
                                {
                                    <small class="text-muted">@L["Already priced by admin"]</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@L["Save"]</button>
        <a asp-controller="SalesInvoices" asp-action="Create" class="btn btn-outline-secondary">@L["Go To POS"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
