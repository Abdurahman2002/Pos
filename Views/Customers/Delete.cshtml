@model NewsApp2.Models.Entities.Customer
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L

<h2>@L["Delete Customer"]</h2>
<hr />
<div class="alert alert-warning">
    @L["Are you sure you want to delete this customer?"]
</div>
@if (ViewBag.Message != null)
{
    <div class="alert alert-danger">@ViewBag.Message</div>
}
<dl class="row">
    <dt class="col-sm-2">@L["Name"]</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">@L["Phone"]</dt>
    <dd class="col-sm-10">@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">@L["Delete"]</button>
    <a asp-action="Index" class="btn btn-secondary">@L["Cancel"]</a>
</form>

