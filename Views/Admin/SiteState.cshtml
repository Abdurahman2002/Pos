@model SiteState

@{
    ViewData["Title"] = "حالة الموقع";
}

<h4>حالة الموقع</h4>
<hr />
<div class="container" style="min-height:67vh;">

    <div class="row">
        <div class="col-md-6">
            @if (@Model.State == true)
            {
                <div class="alert alert-success" style="text-align:center">
                    <p>الموقع مُفعّل الآن</p>
                </div>
            }
            else
            {
                <div class="alert alert-danger" style="text-align:center">
                    <p>الموقع مغلق حالياً</p>
                </div>
            }
            <form asp-action="SiteState">
            

                <div class="form-group mt-3">
                    <button type="submit" name="Save" value="Activating Site" class="btn btn-success">تفعيل الموقع</button>
                    <button type="submit" name="Save" value="Deactivate Site" class="btn btn-danger"
                            onclick="return confirm('سيؤدي هذا إلى إغلاق الموقع أمام المستخدمين. هل أنت متأكد؟');">إيقاف الموقع</button>
                </div>

                <div class="form-group mt-5">
                    <label asp-for="ClosingMessage" class="control-label">رسالة الإغلاق</label>
                    <textarea type="text" asp-for="ClosingMessage" rows="4" class="form-control"></textarea>
                </div>
                <div class="form-group mt-3">
                    <button type="submit" name="Save" value="Update colsing message" class="btn btn-primary">تحديث رسالة الإغلاق</button>
                </div>

                @* <input type="submit" name="Save" asp-action="SiteState" value="Update colsing message" class="btn btn-primary" /> *@

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success" style="text-align:center">
                        <p>@ViewBag.Message</p>
                    </div>
                }

                <div class="alert alert-info mt-3" role="alert" style="width:max-content;">
                    <p>
                        <b>تاريخ الإنشاء:</b>
                        @Html.DisplayFor(model => model.Created)
                        @Html.HiddenFor(model => model.Created)
                    </p>
                    <p>
                        <b>تاريخ التعديل:</b>
                        @Html.DisplayFor(model => model.Modified)
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


