@model ChangePasswordVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L

@{
    ViewBag.Title = L["Change Password"];
}

<style>
    .fade-slide {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity .6s ease, transform .6s ease;
    }

        .fade-slide.show {
            opacity: 1;
            transform: translateY(0);
        }
</style>

<div class="container mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-lg border-0 rounded-4 fade-slide" id="changeCard">

                <div class="card-header text-center bg-light border-0 rounded-top-4 py-4">
                    <h3 class="fw-bold text-secondary">@L["Change Password"]</h3>
                </div>

                <div class="card-body px-4 py-4">
                    <form asp-action="ChangePassword" asp-controller="Account" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3 position-relative">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                            <input asp-for="CurrentPassword" class="form-control form-control-lg" id="curpass" />
                            <i class="bi bi-eye-slash position-absolute top-50 end-0 me-3 translate-middle-y text-secondary"
                               style="cursor:pointer" onclick="toggle('curpass', this)"></i>
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3 position-relative">
                            <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                            <input asp-for="NewPassword" class="form-control form-control-lg" id="newpass" />
                            <i class="bi bi-eye-slash position-absolute top-50 end-0 me-3 translate-middle-y text-secondary"
                               style="cursor:pointer" onclick="toggle('newpass', this)"></i>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3 position-relative">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmPassword" class="form-control form-control-lg" id="confpass" />
                            <i class="bi bi-eye-slash position-absolute top-50 end-0 me-3 translate-middle-y text-secondary"
                               style="cursor:pointer" onclick="toggle('confpass', this)"></i>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 mt-4">
                            @L["Update Password"]
                        </button>
                    </form>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function toggle(id, icon) {
            const input = document.getElementById(id);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            }
        }

        // تشغيل الحركة بعد تحميل الصفحة
        window.addEventListener('load', () => {
            document.getElementById('changeCard').classList.add('show');
        });
    </script>
}

