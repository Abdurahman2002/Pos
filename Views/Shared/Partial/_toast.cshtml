
<style>
    .custom-toast {
        border-radius: 14px !important;
        overflow: hidden;
        padding: 0 !important;
        font-size: 15px;
        backdrop-filter: blur(6px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.12);
        opacity: 0;
        transform: translateX(50px);
        transition: all .45s ease;
        min-width: 280px;
    }

        .custom-toast.show {
            opacity: 1;
            transform: translateX(0);
        }

    .toast-header {
        padding: 10px 14px !important;
        font-size: 16px;
        font-weight: 600;
        color: #fff;
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .toast-body {
        padding: 14px 18px !important;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #fff;
        font-size: 15px;
    }

    .toast-success {
        background: rgba(63, 201, 149, 0.9) !important;
    }

    .toast-error {
        background: rgba(220, 53, 69, 0.9) !important;
    }

    .btn-close {
        filter: brightness(0) invert(1);
    }
</style>


<div class="toast-container position-fixed top-0 end-0 p-4" style="z-index: 1080;">

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="toastsuccess" class="toast custom-toast toast-success"
             role="alert"
             style="background:rgba(63,201,149,0.45)">

            <div class="toast-header" style="background:rgba(63,201,149,0.45)">
                <strong class="me-auto">✔ Done</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>

            <div class="toast-body" style="color:#fff;">
                <i class="bi bi-check-circle"></i>
                @TempData["SuccessMessage"]
            </div>

        </div>

    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div id="toastdanger" class="toast custom-toast toast-error"
             role="alert"
             style="background:rgba(255,110,110,0.45)">

            <div class="toast-header" style="background:rgba(255,130,130,0.45)">
                <strong class="me-auto">⚠ Error</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>

            <div class="toast-body" style="color:#fff;">
                <i class="bi bi-x-circle"></i>
                @TempData["ErrorMessage"]
            </div>

        </div>

    }

</div>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        new bootstrap.Toast(document.getElementById("toastsuccess")).show();
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        new bootstrap.Toast(document.getElementById("toastdanger")).show();
    </script>
}
