@model NewsApp2.ViewModels.Inventory.ItemLabelPrintVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@{
    ViewData["Title"] = L["Print Item Label"];
    var selectedPrice = Model.Price.HasValue ? Model.Price.Value.ToString("0.00") : "";
}

<h2>@L["Print Label"]</h2>
<div class="row g-3">
    <div class="col-lg-4">
        <form method="get" asp-action="PrintLabel" class="card">
            <div class="card-body">
                <input type="hidden" name="id" value="@Model.ItemId" />

                <div class="mb-3">
                    <label class="form-label">@L["Item"]</label>
                    <input class="form-control" value="@Model.ItemName" readonly />
                </div>

                <div class="mb-3">
                    <label for="code" class="form-label">@L["Barcode"]</label>
                    <select id="code" name="code" class="form-select">
                        @foreach (var code in Model.AvailableCodes)
                        {
                            if (code == Model.SelectedCode)
                            {
                                <option value="@code" selected>@code</option>
                            }
                            else
                            {
                                <option value="@code">@code</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label for="price" class="form-label">@L["Price"]</label>
                    <input id="price" name="price" class="form-control" type="number" step="0.01" min="0" value="@selectedPrice" />
                </div>

                <div class="mb-3">
                    <label for="copies" class="form-label">@L["Copies"]</label>
                    <input id="copies" name="copies" class="form-control" type="number" step="1" min="1" max="200" value="@Model.Copies" />
                </div>

                <button type="submit" class="btn btn-primary w-100">@L["Refresh Preview"]</button>
                <button type="button" class="btn btn-success w-100 mt-2" id="print-label-btn">@L["Print"]</button>
            </div>
        </form>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="small text-muted mb-2">@L["Preview uses a common thermal-label size (50mm x 30mm)."]</div>
                <div id="labels-wrapper" class="d-flex flex-wrap gap-2"></div>
            </div>
        </div>
    </div>
</div>

<p class="mt-3">
    <a asp-action="Details" asp-route-id="@Model.ItemId" class="btn btn-secondary">@L["Back To Item"]</a>
</p>

<style>
    .item-label {
        width: 189px;
        height: 113px;
        border: 1px dashed #999;
        background: #fff;
        padding: 5px 6px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
    }

    .item-label-shop {
        display: flex;
        align-items: center;
        gap: 6px;
        min-height: 18px;
    }

    .item-label-shop img {
        width: 18px;
        height: 18px;
        object-fit: contain;
    }

    .item-label-shop-name {
        font-size: 10px;
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .item-label-name {
        font-size: 11px;
        font-weight: 700;
        line-height: 1.2;
        height: 26px;
        overflow: hidden;
    }

    .item-label-price {
        font-size: 11px;
        font-weight: 700;
        text-align: right;
        line-height: 1;
    }

    .item-label-code {
        font-size: 9px;
        text-align: center;
        margin-top: 1px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @@media print {
        body * {
            visibility: hidden;
        }

        #labels-wrapper,
        #labels-wrapper * {
            visibility: visible;
        }

        #labels-wrapper {
            position: absolute;
            left: 0;
            top: 0;
            gap: 0;
        }

        .item-label {
            border: 0;
            margin: 0;
            page-break-inside: avoid;
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <script>
        (function () {
            var labelsWrapper = document.getElementById('labels-wrapper');
            var printBtn = document.getElementById('print-label-btn');
            var codeInput = document.getElementById('code');
            var copiesInput = document.getElementById('copies');
            var priceInput = document.getElementById('price');

            if (!labelsWrapper || !codeInput || !copiesInput || !priceInput) {
                return;
            }

            function htmlEncode(value) {
                return (value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function renderLabels() {
                var code = (codeInput.value || '').trim();
                var copies = parseInt(copiesInput.value || '1', 10);
                var price = (priceInput.value || '').trim();

                if (!Number.isFinite(copies) || copies < 1) {
                    copies = 1;
                    copiesInput.value = '1';
                }

                if (copies > 200) {
                    copies = 200;
                    copiesInput.value = '200';
                }

                labelsWrapper.innerHTML = '';
                if (!code) {
                    return;
                }

                var shopLogo = '@(Model.ShopLogoUrl ?? string.Empty)';
                var shopName = htmlEncode('@(Model.ShopName ?? L["Shop"].Value)');
                var itemName = htmlEncode('@Model.ItemName');
                var priceText = price ? ('@L["Price"]: ' + htmlEncode(price)) : '';

                for (var i = 0; i < copies; i++) {
                    var label = document.createElement('div');
                    label.className = 'item-label';
                    label.innerHTML =
                        '<div class="item-label-shop">' +
                            (shopLogo ? ('<img src="' + shopLogo + '" alt="logo" />') : '') +
                            '<div class="item-label-shop-name">' + shopName + '</div>' +
                        '</div>' +
                        '<div class="item-label-name">' + itemName + '</div>' +
                        '<svg class="barcode-svg"></svg>' +
                        '<div class="item-label-code">' + htmlEncode(code) + '</div>' +
                        '<div class="item-label-price">' + priceText + '</div>';

                    labelsWrapper.appendChild(label);

                    var svg = label.querySelector('.barcode-svg');
                    JsBarcode(svg, code, {
                        format: 'CODE128',
                        lineColor: '#111',
                        width: 1.4,
                        height: 28,
                        displayValue: false,
                        margin: 0
                    });
                }
            }

            codeInput.addEventListener('change', renderLabels);
            copiesInput.addEventListener('input', renderLabels);
            priceInput.addEventListener('input', renderLabels);

            if (printBtn) {
                printBtn.addEventListener('click', function () {
                    window.print();
                });
            }

            renderLabels();
        })();
    </script>
}

