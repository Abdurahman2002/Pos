    <script>
        (function () {
            function initSelect(el) {
                if (!el || el.tomselect || el.dataset.noTs !== undefined) return;
                new TomSelect(el, {
                    create: false,
                    allowEmptyOption: true,
                    sortField: { field: "text", direction: "asc" },
                    dropdownParent: 'body',
                    placeholder: el.dataset.placeholder || '',
                    hidePlaceholder: true
                });
            }

            document.querySelectorAll('select.form-select').forEach(initSelect);
            document.addEventListener('ts:refresh', () => {
                document.querySelectorAll('select.form-select').forEach(initSelect);
            });
        })();
    </script>
    
    @* --------------------------------- *@
    <partial name="Partial/_toast"></partial>
    @* --------------------------------- *@
 
    @await RenderSectionAsync("Scripts", required: false)


    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Smart Active Menu Highlighting
            const currentPath = window.location.pathname.toLowerCase();
            const segments = currentPath.split('/').filter(x => x);
            const baseRoute = segments.length > 0 ? '/' + segments[0] : '/';

            const links = document.querySelectorAll('.sidebar .nav-item .nav-link');
            let bestMatch = null;
            let longestMatch = 0;

            links.forEach(link => {
                const href = link.getAttribute('href');
                if (!href || href === '#') return;
                
                const hrefLower = href.toLowerCase();
                
                // Exact Match
                if (currentPath === hrefLower) {
                    bestMatch = link;
                    longestMatch = 1000;
                } 
                // Prefix Match (e.g. /SalesInvoices/Create -> /SalesInvoices matches)
                else if (currentPath.startsWith(hrefLower) && hrefLower.length > longestMatch) {
                    bestMatch = link;
                    longestMatch = hrefLower.length;
                }
            });

            if (bestMatch) {
                // Add active to link
                bestMatch.classList.add('active');
                
                // Open parent collapse
                let parentCollapse = bestMatch.closest('.collapse');
                if (parentCollapse) {
                    parentCollapse.classList.add('show');
                    // Set parent nav-item active to keep arrow rotated
                    const parentNavItem = parentCollapse.closest('.nav-item');
                    if (parentNavItem) {
                        const parentLink = parentNavItem.querySelector('[data-bs-toggle="collapse"]');
                        if (parentLink) {
                            parentLink.setAttribute('aria-expanded', 'true');
                            parentLink.classList.remove('collapsed');
                        }
                    }
                }
            }
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Smart Menu Highlighting based on Controller
            var currentPath = window.location.pathname.toLowerCase().split('?')[0];
            var segments = currentPath.split('/').filter(Boolean);
            var currentController = segments.length > 0 ? segments[0] : 'home';

            var links = document.querySelectorAll('.sidebar .nav-item .nav-link');
            var bestMatch = null;
            var highestScore = -1;

            links.forEach(function(link) {
                var href = link.getAttribute('href');
                if (!href || href === '#' || href.includes('javascript:')) return;
                
                var hrefLower = href.toLowerCase().split('?')[0];
                var score = -1;
                
                // Exact Match
                if (currentPath === hrefLower || currentPath === hrefLower + '/index') {
                    score = 100;
                }
                // Controller Match (e.g. /SalesInvoices/Create -> /SalesInvoices/Index)
                else {
                    var hrefSegments = hrefLower.split('/').filter(Boolean);
                    var hrefController = hrefSegments.length > 0 ? hrefSegments[0] : 'home';
                    if (currentController === hrefController) {
                        score = 50;
                    }
                }

                if (score > highestScore) {
                    highestScore = score;
                    bestMatch = link;
                }
            });

            if (bestMatch && highestScore > 0) {
                bestMatch.classList.add('active');
                
                var parentCollapse = bestMatch.closest('.collapse');
                if (parentCollapse) {
                    parentCollapse.classList.add('show');
                    var toggleLink = document.querySelector('[href="#' + parentCollapse.id + '"]');
                    if (toggleLink) {
                        toggleLink.setAttribute('aria-expanded', 'true');
                        toggleLink.classList.remove('collapsed');
                    }
                }
            }
        });
    </script>
</body>
