@model News

@{
    ViewData["Title"] = ViewContext.RouteData.Values["controller"]?.ToString()
    + "-" + ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="container main-panel">
    <h4>
        @ViewData["Title"]
    </h4>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Title" class="control-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Details" class="control-label"></label>
                    <textarea rows="5" cols="5" asp-for="Details" class="form-control" name="Details"></textarea>
                    <span asp-validation-for="Details" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SectionId" class="control-label"></label>
                    <select asp-for="SectionId" class="form-control" asp-items="ViewBag.Sections">
                        @* <option value="">---------Select Section---------</option> *@
                    </select>
                    <span asp-validation-for="SectionId" class="text-danger"></span>
                </div>

                <!-------------------------------File&Image------------------------->
                <div class="form-group">
                    <label class="control-label">News Picture</label>
                    <input id="input1" type="file" asp-for="File" onchange="UploadImageFile(this,'img1','isThereImg1');" class="form-control custom-file-input" />
                    <input type="hidden" name="isThereImg1" id="isThereImg1" value="..." />
                </div>

                <div class="form-group position-relative image-box">
                    <button type="button" class="btn-close" aria-label="Close" onclick="return clearFile('input1','img1','isThereImg1');"></button>

                    <img id="img1"
                         src="~/@(string.IsNullOrEmpty(Model.ImageUrl) ? "img/News.jpg" : $"Upload/{Model.ImageUrl}")"
                         onclick="return clickFile('input1');"
                         class="img-thumbnail w-100"
                         style="height:300px; cursor:pointer; object-fit:cover;" />


                    <input type="hidden" asp-for="ImageUrl" />

                    @if (string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <p id="defaultText" class="text-muted mt-1 text-center">The default picture</p>
                    }
                </div>

                <!-------------------------------------------------------------------->
                <div class="alert alert-info" role="alert" style="width:max-content;">
                    <p>
                        <b>@Html.DisplayNameFor(model => model.Created):</b>
                        @Html.DisplayFor(model => model.Created)
                        @Html.HiddenFor(model => model.Created) @*لارجاع تاريخ الإنشاء*@
                    </p>
                    <p>
                        <b>@Html.DisplayNameFor(model => model.Modified):</b>
                        @Html.DisplayFor(model => model.Modified)
                    </p>
                </div>
                <!---------------------------switch------------------------------------->
                @if (Model.State == true)
                {
                    <div class="alert alert-success  ps-4 pe-4" role="alert" style="width:max-content;">
                        <div class="form-check form-switch">
                            <input asp-for="State" class="form-check-input me-3" type="checkbox" id="State">
                            <label asp-for="State" class="form-check-label" for="State"></label>
                            @* <input name="State" type="hidden" value="false" /> *@
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger  ps-4 pe-4" role="alert" style="width:max-content;">
                        <div class="form-check form-switch">
                            <input asp-for="State" class="form-check-input me-3" type="checkbox" id="State">
                            <label asp-for="State" class="form-check-label" for="State"></label>
                        </div>
                    </div>
                }

                <!-------------------------------الازرار-------------------------------->
                <div class="form-group mt-5 d-flex justify-content-center align-items-center gap-3">
                    <!-- حفظ -->
                    <input type="submit" value="Save" class="btn btn-primary px-5 py-3" />

                    <!-- حذف -->
                    <button data-bs-toggle="modal" data-bs-target="#DeleteModal" type="button" class="btn btn-danger px-5 py-3">
                        <i class="fa fa-trash-alt me-2"></i> Delete
                    </button>

                    <!-- رجوع -->
                    <a asp-action="Index" class="btn btn-outline-primary px-4 py-3">
                        <i class="fa fa-arrow-left me-2"></i> Back to List
                    </a>
                </div>
                <!---------------------------------------------------------------------->

            </form>

            <!-- استدعاء Partial -->
            @await Html.PartialAsync("Partial/_deleteModal", Model.Id)

        </div>

        <!------------------------------------------------------------------------------->
        @*  <input type="submit" onclick="return confirm('Are you sure you want to delete this?')"
                    asp-action="Delete" asp-route-id="@Model.Id" value="Delete" class="btn btn-danger"> *@
        @* <a href="@Url.Action("Index", "News")" class="ajax-link btn btn-outline-primary ps-4 pe-4 me-3">Back to List</a> *@
        @* @Html.ActionLink("Save", "Edit", "News", new { Id = Model.Id }, new { @Class = "ajax-link btn btn-info" }) *@
        <!------------------------------------------------------------------------------->

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/inputfileimage.js"></script>
    <script src="~/js/stateswitch.js"></script>
}


