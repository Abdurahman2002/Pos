@model IEnumerable<NewsApp2.Models.Entities.PurchaseInvoice>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@{
    ViewData["Title"] = "فواتير الشراء";
}

<h1>فواتير الشراء</h1>
<p>
    <a class="btn btn-primary" asp-action="Create">فاتورة شراء جديدة</a>
    <a class="btn btn-outline-secondary" asp-action="Report">تقرير</a>
</p>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@L["Number"]</th>
                <th>@L["Date"]</th>
                <th>الحالة</th>
                <th>الإجمالي</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model)
        {
            var localizedStatus = string.IsNullOrWhiteSpace(row.Status) ? "-" : L[row.Status].Value;
            <tr>
                <td>@row.Number</td>
                <td><span dir="ltr">@row.InvoiceDate.ToString("dd/MM/yyyy")</span></td>
                <td>@localizedStatus</td>
                <td>@row.TotalDinar.ToString("0.00")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@row.Id">@L["Details"]</a>
                    @if ((User.IsInRole("Admin") || User.IsInRole("Prog")) && string.Equals(row.Status, "Posted", StringComparison.OrdinalIgnoreCase))
                    {
                        <span> | </span><a asp-action="Edit" asp-route-id="@row.Id">@L["Edit"]</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

