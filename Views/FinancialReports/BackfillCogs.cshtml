@{
    ViewData["Title"] = "ترحيل تكلفة المبيعات للفواتير السابقة";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="card-title mb-3">@ViewData["Title"]</h4>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="alert alert-warning">
                <strong>تنبيه:</strong> هذه العملية ستقوم بترحيل قيود تكلفة البضاعة المباعة (COGS) لجميع الفواتير
                المنشورة سابقًا والتي لم يتم ترحيل تكلفتها بعد. سيتم إضافة قيد محاسبي مزدوج:
                <hr />
                <code>5001 تكلفة البضاعة المباعة (مدين) ← 1301 المخزون (دائن)</code>
                <br /><br />
                يمكن تنفيذها مرة واحدة فقط. الفواتير التي تم ترحيلها مسبقًا سيتم تخطيها تلقائيًا.
            </div>

            <form method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">للتأكيد، اكتب "نعم" في الحقل أدناه:</label>
                    <input type="text" name="confirm" class="form-control" required autocomplete="off" />
                </div>
                <button type="submit" class="btn btn-primary">بدء الترحيل</button>
                <a asp-action="TrialBalance" class="btn btn-secondary">عودة لميزان المراجعة</a>
            </form>
        </div>
    </div>
</div>
