@inject IUnitOfWork<SiteInfo> _siteInfo
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@using System.Globalization


<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta name="viewport" content="width=device-width" />
    @* --------------------------------------------------------------- *@
    @{
        var siteInfo = _siteInfo.Repository.GetAll().SingleOrDefault();
        ViewBag.SiteName = @siteInfo?.Name;
        ViewBag.LogoUrl = @siteInfo?.LogoUrl;
        var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    }


    <partial name="Partial/_title"></partial>
    @* --------------------------------------------------------------- *@

    @if (isRtl)
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    }
    else
    {
        <environment include="Development">
            <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
        </environment>
        <environment include="Staging,Production">
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        </environment>
    }


    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    @* <link href="~/css/template.css" rel="stylesheet" /> *@
    <link href="~/css/site1.css" rel="stylesheet" />
    <link href="~/css/date-inputs.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet" />
    @if (isRtl)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
        <link href="~/css/rtl-support.css" rel="stylesheet" />
        <style>
            body { font-family: 'Cairo', sans-serif; }
        </style>
    }

</head>
<body class="bodycolre">
    <header>
        <nav class="navbar navbar-expand-lg fixed-top bg-white border-bottom">
            <div class="container-fluid position-relative">
                @* --------------------------------- *@
                <partial name="Partial/_navbrand"></partial>
                @* ---------------------------------*@
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @*  <li class="nav-item active">
                        <a class="nav-link" asp-action="Index" asp-controller="Home">@L["Home"]</a>
                        </li> *@
                    </ul>
                    <div class="me-3">
                        <partial name="Partial/_LanguageSwitcher"></partial>
                    </div>
                    @*  <ul class="navbar-nav me-5">
                    <li><a class="nav-link" asp-action="Login" asp-controller="Account">@L["Login"]</a></li>
                    </ul> *@
                    @* --------------------------------- *@
                    <partial name="Partial/_navUser"></partial>
                    @* --------------------------------- *@

                </div>
            </div>
        </nav>
    </header>

    @* <div class="pb-5 pt-5"> *@
    <div class="container pb-5 pt-5" style="margin-top:50px;">
        @RenderBody()
    </div>


    <environment include="Development">
        <script src="~/lib/jquery/jquery.min.js"></script>
        <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    </environment>
    <environment include="Staging,Production">
        <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    </environment>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ar.js"></script>
    <script src="~/js/date-picker.js"></script>

    
    @RenderSection("Scripts", required: false)

    @* ------------partial-------------- *@
    <partial name="Partial/_toast"></partial>
    @* <partial name="Partial/_footer"></partial> *@
    @* --------------------------------- *@
</body>
</html>


