@model NewsApp2.ViewModels.Financial.ProfitLossReportVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@{
    ViewData["Title"] = "التقرير المالي الشامل";
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2 print-hidden">
    <h2 class="h3 text-gray-800"><i class="mdi mdi-chart-box-outline text-primary me-2"></i> @ViewData["Title"]</h2>
    <div>
        <button type="button" class="btn btn-outline-secondary shadow-sm" onclick="window.print()">
            <i class="mdi mdi-printer me-1"></i> طباعة التقرير
        </button>
    </div>
</div>

<div class="card shadow-sm mb-4 print-hidden border-start border-4 border-primary">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label text-muted fw-bold">الفترة من</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="mdi mdi-calendar"></i></span>
                    <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted fw-bold">الفترة إلى</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="mdi mdi-calendar"></i></span>
                    <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1 shadow-sm"><i class="mdi mdi-filter me-1"></i> تصفية البيانات</button>
                <a asp-action="ProfitLoss" class="btn btn-light border flex-grow-1">إعادة ضبط</a>
            </div>
        </form>
        <div class="mt-2 text-muted small">
            يتم احتساب تكلفة البضاعة المباعة (COGS) بطريقة <strong>FIFO</strong> المستمرة من فواتير الشراء والمبيعات المرحلة.
        </div>
    </div>
</div>

<h5 class="text-primary mb-3"><i class="mdi mdi-finance me-1"></i> ملخص الأداء المالي والأرباح</h5>
<div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0 border-bottom border-4 border-success h-100">
            <div class="card-body text-center">
                <div class="text-muted small fw-bold mb-1">إجمالي المبيعات (الإيراد)</div>
                <div class="fs-3 fw-bolder text-success">@Model.RevenueDinar.ToString("0.00") <small class="text-muted fs-6">د.ل</small></div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0 border-bottom border-4 border-danger h-100">
            <div class="card-body text-center">
                <div class="text-muted small fw-bold mb-1">تكلفة المبيعات (COGS)</div>
                <div class="fs-3 fw-bolder text-danger">@Model.CogsDinar.ToString("0.00") <small class="text-muted fs-6">د.ل</small></div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0 border-bottom border-4 @(Model.GrossProfitDinar >= 0 ? "border-primary" : "border-warning") h-100 bg-light">
            <div class="card-body text-center">
                <div class="text-muted small fw-bold mb-1">مجمل الربح / الخسارة</div>
                <div class="fs-3 fw-bolder @(Model.GrossProfitDinar >= 0 ? "text-primary" : "text-warning")">@Model.GrossProfitDinar.ToString("0.00") <small class="text-muted fs-6">د.ل</small></div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0 border-bottom border-4 border-info h-100">
            <div class="card-body text-center">
                <div class="text-muted small fw-bold mb-1">هامش الربح</div>
                <div class="fs-3 fw-bolder text-info">@Model.MarginPercent.ToString("0.00")%</div>
            </div>
        </div>
    </div>
</div>

<h5 class="text-danger mb-3"><i class="mdi mdi-cash-remove me-1"></i> المصروفات والتدفقات الخارجة</h5>
<div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0 border-bottom border-4 border-secondary h-100">
            <div class="card-body text-center">
                <div class="text-muted small fw-bold mb-1">مصروفات عامة</div>
                <div class="fs-4 fw-bolder text-secondary">@Model.GeneralExpensesDinar.ToString("N2") <small class="text-muted fs-6">د.ل</small></div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0 border-bottom border-4 border-primary h-100">
            <div class="card-body text-center">
                <div class="text-muted small fw-bold mb-1">مرتبات الموظفين</div>
                <div class="fs-4 fw-bolder text-primary">@Model.SalariesDinar.ToString("N2") <small class="text-muted fs-6">د.ل</small></div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0 border-bottom border-4 border-warning h-100">
            <div class="card-body text-center">
                <div class="text-muted small fw-bold mb-1">سلف الموظفين</div>
                <div class="fs-4 fw-bolder text-warning">@Model.AdvancesDinar.ToString("N2") <small class="text-muted fs-6">د.ل</small></div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0 border-bottom border-4 border-danger h-100 bg-light">
            <div class="card-body text-center">
                <div class="text-muted small fw-bold mb-1">صافي الربح بعد المصروفات</div>
                <div class="fs-4 fw-bolder @(Model.NetProfitAfterExpensesDinar >= 0 ? "text-success" : "text-danger")">@Model.NetProfitAfterExpensesDinar.ToString("N2") <small class="text-muted fs-6">د.ل</small></div>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-light border d-flex justify-content-between align-items-center mb-4">
    <span class="fw-semibold text-muted">إجمالي المصروفات التشغيلية (مصروفات + مرتبات + سلف)</span>
    <span class="fw-bold fs-5 text-danger">@Model.TotalOperatingOutflowsDinar.ToString("N2") د.ل</span>
</div>

<div class="row g-4 mb-5">
    <div class="col-lg-8">
        <h5 class="text-secondary mb-3"><i class="mdi mdi-cash-multiple me-1"></i> المبيعات والإيرادات حسب طرق الدفع</h5>
        <div class="row g-3">
            <div class="col-sm-6 col-md-3">
                <div class="card border-0 shadow-sm text-center bg-light">
                    <div class="card-body p-3">
                        <i class="mdi mdi-cash display-6 text-success d-block mb-1"></i>
                        <span class="d-block text-muted small fw-bold">مبيعات نقدية</span>
                        <h5 class="mb-0 fw-bold mt-1">@Model.CashSalesDinar.ToString("N2")</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="card border-0 shadow-sm text-center bg-light">
                    <div class="card-body p-3">
                        <i class="mdi mdi-credit-card-outline display-6 text-primary d-block mb-1"></i>
                        <span class="d-block text-muted small fw-bold">مبيعات بطاقة</span>
                        <h5 class="mb-0 fw-bold mt-1">@Model.CardSalesDinar.ToString("N2")</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="card border-0 shadow-sm text-center bg-light">
                    <div class="card-body p-3">
                        <i class="mdi mdi-bank-transfer display-6 text-info d-block mb-1"></i>
                        <span class="d-block text-muted small fw-bold">تحويل بنكي</span>
                        <h5 class="mb-0 fw-bold mt-1">@Model.TransferSalesDinar.ToString("N2")</h5>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="card border-0 shadow-sm text-center bg-light">
                    <div class="card-body p-3">
                        <i class="mdi mdi-account-clock-outline display-6 text-warning d-block mb-1"></i>
                        <span class="d-block text-muted small fw-bold">مبيعات آجلة (ديون)</span>
                        <h5 class="mb-0 fw-bold mt-1">@Model.CreditSalesDinar.ToString("N2")</h5>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.ReturnsDinar > 0)
        {
            <div class="alert alert-danger mt-3 py-2 d-flex justify-content-between align-items-center shadow-sm">
                <span><i class="mdi mdi-undo-variant me-1"></i> إجمالي المرتجعات</span>
                <span class="fw-bold fs-5 text-danger">@Model.ReturnsDinar.ToString("N2") د.ل</span>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <h5 class="text-secondary mb-3"><i class="mdi mdi-warehouse me-1"></i> حركة المشتريات والمخزون</h5>
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div class="pe-2">
                    <div class="text-muted small fw-bold">مشتريات الفترة</div>
                    <div class="text-secondary" style="font-size:0.75rem;">إجمالي فواتير الشراء المرحلة</div>
                </div>
                <div class="fs-4 fw-bold text-dark text-nowrap">@Model.PostedPurchasesInPeriodDinar.ToString("N2")</div>
            </div>
        </div>
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                    <span class="text-muted small fw-bold mt-1">قيمة المخزون المتبقي <br><small>(حسب سعر التكلفة)</small></span>
                    <span class="fs-5 fw-bold text-primary mt-1 text-nowrap">@Model.RemainingStockValueDinar.ToString("N2") د.ل</span>
                </div>
                <div class="d-flex justify-content-between pt-1">
                    <span class="text-muted small fw-bold mt-1">كمية المخزون المتبقي</span>
                    <span class="fw-bold fs-5 mt-1 text-nowrap">@Model.RemainingStockQty.ToString("N2") <small class="text-muted fs-6">وحدة</small></span>
                </div>
            </div>
        </div>
    </div>
</div>

<h5 class="text-primary mb-3 print-hidden"><i class="mdi mdi-format-list-bulleted me-1"></i> تفاصيل المبيعات للأصناف (FIFO)</h5>
<div class="card shadow-sm border-0 print-hidden">
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 480px;">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark small text-uppercase sticky-top shadow-sm">
                    <tr>
                        <th class="ps-3">الصنف</th>
                        <th class="text-end">الكمية المباعة</th>
                        <th class="text-end text-success">الإيراد</th>
                        <th class="text-end text-danger">التكلفة (FIFO)</th>
                        <th class="text-end text-primary">مجمل الربح</th>
                        <th class="text-end">المتبقي (كمية)</th>
                        <th class="text-end pe-3">قيمة المتبقي (التكلفة)</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Rows.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">لا يوجد مبيعات أو تفاصيل أصناف لهذه الفترة.</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-secondary">@row.ItemName</td>
                            <td class="text-end">@row.SoldQty.ToString("0.##")</td>
                            <td class="text-end fw-bold text-success">@row.RevenueDinar.ToString("0.00")</td>
                            <td class="text-end fw-bold text-danger">@row.CogsDinar.ToString("0.00")</td>
                            <td class="text-end fw-bold text-primary">@row.GrossProfitDinar.ToString("0.00")</td>
                            <td class="text-end">@row.RemainingQty.ToString("0.##")</td>
                            <td class="text-end pe-3 text-secondary">@row.RemainingValueDinar.ToString("0.00")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        .print-hidden,
        .print-hidden * {
            display: none !important;
        }
        h5,
        .card,
        .card *,
        .alert,
        .alert * {
            visibility: visible;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
    }
</style>
