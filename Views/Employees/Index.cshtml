@model IEnumerable<Employee>

@{
    ViewBag.Title = "Employees Management";
    var userRoles = ViewData["UserRoles"] as Dictionary<string, List<string>> ?? new Dictionary<string, List<string>>();
}

<partial name="Partial/_datatables-css" />

<style>
    .stats-card {
        transition: 0.2s;
        border-radius: 14px;
        border: none;
    }

        .stats-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 14px rgba(0,0,0,0.15);
        }

    .stats-icon {
        font-size: 38px;
        opacity: 0.85;
    }

    tr {
        height: 55px;
    }

    #table1 {
        border-radius: 12px !important;
    }
</style>

<div class="container-fluid" style="min-height:75vh">

    <h3 class="fw-bold mb-4">
        Employees Management
    </h3>

    <!-- Top Buttons -->
    <div class="d-flex justify-content-between mb-3 flex-wrap gap-2">
        <div class="d-flex gap-2">
            <a asp-action="CreateEmployee" class="btn btn-primary px-4">+ Create Employee</a>
            <a asp-action="Pending" class="btn btn-outline-warning px-4">Pending Approval</a>
        </div>
    </div>

    <div class="card shadow-sm p-2 bg-body-tertiary">
        <table id="table1" class="table table-hover table-striped table-bordered w-100">
            <thead style="background-color:#E0ECEB">
                <tr class="align-middle">
                    <th>#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int i = 0;
                }

                @foreach (var item in Model)
                {
                    i++;
                    <tr class="align-middle">
                        <td class="text-center">@i</td>

                        <td>
                            <a asp-action="EditEmployee" asp-route-id="@item.Id" class="fw-semibold">
                                @item.Name
                            </a>
                        </td>
                        <td>@item.ApplicationUser.Email</td>
                        <td>
                            @{
                                var roles = userRoles.TryGetValue(item.UserId, out var assignedRoles)
                                ? assignedRoles.Where(r => r != "Employee").ToList()
                                : new List<string>();
                            }
                            @(roles.Any() ? string.Join(", ", roles) : "-")
                        </td>
                        <td>
                            @if (item.ApplicationUser.Approval == true)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>

                        <td class="text-center">
                            @if (item.ApplicationUser.Approval == false)
                            {
                                <a asp-action="Approve" asp-route-id="@item.Id" class="btn btn-success btn-sm px-3">Approve</a>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="Partial/_datatables-js" />

<script>
    new DataTable('#table1', {
        language: {
            // url: '//cdn.datatables.net/plug-ins/2.0.3/i18n/ar.json',
        },
        scrollX: true
    });
</script>


