@model EditRoleVM
@{
    ViewBag.Title = "Edit Role";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height:75vh;">
    <div class="card shadow-lg p-4" style="max-width:450px; width:100%; border-radius:20px;">

        <div class="text-center mb-4">
            <h3 class="fw-bold text-warning">
                <i class="bi bi-pencil-square"></i> Edit Role
            </h3>
            <p class="text-muted">Update the role information below</p>
        </div>

        <form asp-action="EditRole" method="post">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="RoleName" class="form-label fw-semibold"></label>
                <input asp-for="RoleName" class="form-control form-control-lg shadow-sm" placeholder="Enter role name..." />
                <span asp-validation-for="RoleName" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-warning btn-lg shadow mb-3">
                    <i class="bi bi-check-circle"></i> Update Role
                </button>

                <a asp-action="Index" class="btn btn-outline-primary btn-lg">
                    Back to Roles <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

