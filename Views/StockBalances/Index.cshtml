@model IEnumerable<NewsApp2.Models.Entities.InvStockBalance>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@{
    var lowThreshold = ViewBag.LowThreshold != null ? (decimal)ViewBag.LowThreshold : 5m;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2>@L["Stock Overview"]</h2>
    <div class="d-flex gap-2">
        <a asp-action="Movement" class="btn btn-outline-secondary">@L["Movement Report"]</a>
        <a asp-controller="FinancialReports" asp-action="ProfitLoss" class="btn btn-outline-primary">@L["Financial Report"]</a>
    </div>
    <form class="d-flex flex-wrap gap-2 stock-filter-form" method="get" asp-action="Index">
        <select name="categoryId" class="form-select" asp-items="@(ViewData["Categories"] as SelectList)">
            <option value="">@L["All categories"]</option>
        </select>
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="@L["Search item"]" />
        <input type="number" name="lowThreshold" value="@lowThreshold" class="form-control" step="1" min="0" inputmode="numeric" placeholder="@L["Low threshold"]" />
        <div class="form-check align-self-center">
            <input type="checkbox" class="form-check-input" id="lowOnly" name="lowOnly" value="true" @(ViewBag.LowOnly == true ? "checked" : "") />
            <label class="form-check-label" for="lowOnly">@L["Low only"]</label>
        </div>
        <button class="btn btn-outline-primary" type="submit">@L["Apply"]</button>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="text-muted">@L["Total lines"]</div>
                        <div class="fs-4 fw-bold">@ViewBag.TotalCount</div>
                    </div>
                    <i class="bi bi-box-seam fs-2 text-primary"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="text-muted">@L["Low stock"]</div>
                        <div class="fs-4 fw-bold text-danger">@ViewBag.LowCount</div>
                        <small class="text-muted">@L["Threshold"]: @lowThreshold</small>
                    </div>
                    <i class="bi bi-exclamation-triangle fs-2 text-danger"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="text-muted">@L["Out of stock"]</div>
                        <div class="fs-4 fw-bold text-dark">@ViewBag.OutOfStockCount</div>
                        <small class="text-muted">@L["Zero qty items"]</small>
                    </div>
                    <i class="bi bi-box2 fs-2 text-danger"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th class="d-none d-md-table-cell">@L["Category"]</th>
                <th>@L["Item"]</th>
                <th class="text-end">@L["Qty"]</th>
                <th class="d-none d-lg-table-cell text-end">@L["Reorder"]</th>
                <th>@L["Status"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model)
        {
            var reorder = row.Item?.ReorderLevel ?? 0m;
            var limit = reorder > 0 ? reorder : lowThreshold;
            var statusKey = row.QuantityOnHand <= 0 ? "Out" : row.QuantityOnHand <= limit ? "Low" : "OK";
            var status = L[statusKey].Value;
            var badge = statusKey == "Out" ? "bg-dark" : statusKey == "Low" ? "bg-danger" : "bg-success";
            <tr>
                <td class="d-none d-md-table-cell">@row.Item?.Category?.Name</td>
                <td>
                    @if (row.ItemId != Guid.Empty)
                    {
                        <a asp-action="ItemCard" asp-route-id="@row.ItemId" class="text-decoration-none fw-semibold">
                            @row.Item?.Name
                        </a>
                    }
                    else
                    {
                        @row.Item?.Name
                    }
                </td>
                <td class="text-end">@row.QuantityOnHand.ToString("0")</td>
                <td class="d-none d-lg-table-cell text-end">@(reorder > 0 ? reorder.ToString("0") : "-")</td>
                <td><span class="badge @badge">@status</span></td>
            </tr>
        }
        </tbody>
    </table>
</div>

<partial name="Partial/_Pagination" model="@(ViewBag.Pagination as NewsApp2.ViewModels.Common.PaginationVM)" />

