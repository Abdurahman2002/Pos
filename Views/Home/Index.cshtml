@model List<Section>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L

@{
    // ViewData["Title"] = "Home";
}

<!--  Latest News  -->
<section class="latest-news bg-black py-5 fade-slide">
    <div class="container">
        <div class="row text-center mb-4">
            <h1 class="text-white-50">@L["Latest News"]</h1>
            <p class="text-secondary">@L["Stay updated with the newest headlines"]</p>
        </div>
        <div class="latest-news-carousel owl-carousel">
            @foreach (var secItem in Model)
            {
                foreach (var news in secItem.News)
                {
                    <div class="latest-news-item bg-light shadow-sm rounded overflow-hidden fade-slide hover-card">
                        <div class="position-relative">
                            <img src="@(news.ImageUrl != null ? Url.Content($"~/upload/{news.ImageUrl}") : Url.Content("~/img/news.jpg"))"
                                 class="img-fluid w-100 hover-img" style="height:180px; object-fit:cover; filter: brightness(0.8);" />
                            <span class="badge bg-dark position-absolute top-0 start-0 m-2">@secItem.Name</span>
                        </div>
                        <div class="p-3">
                            <a asp-action="News" asp-controller="Home" asp-route-id="@news.Id" class="text-decoration-none">
                                <h5 class="text-dark fw-bold">@news.Title?.Substring(0, Math.Min(news.Title.Length, 40))@(news.Title.Length > 40 ? "..." : "")</h5>
                            </a>
                            <div class="d-flex justify-content-between align-items-center mt-2 text-muted small">
                                <span><i class="fas fa-calendar-alt me-1"></i>@news.Created.ToString("dd/MM/yyyy")</span>
                                @* <span><i class="bi bi-eye"></i> @news.Views</span> *@
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!--  News Sections & Featured News  -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <!-- Left Column: News Sections -->
            <div class="col-lg-4 mb-5 mb-lg-0 mr-lg-3 ">
                <div class="bg-white shadow-sm rounded p-4" style="max-height:1200px; overflow-y:auto;">
                    <h3 class="text-center text-dark mb-4"><i class="bi bi-grid-3x3-gap-fill text-primary"></i> News Sections</h3>
                    @foreach (var secItem in Model)
                    {
                        if (secItem.News.Any())
                        {
                            <div class="border-bottom p-3 mb-3 fade-slide hover-card">
                                <a asp-action="Section" asp-controller="Home" asp-route-id="@secItem.Id"
                                   class="d-block text-decoration-none">
                                    <h5 class="fw-bold text-primary">@secItem.Name <small class="text-muted">( @secItem.News.Count() )</small></h5>
                                </a>
                                <div class="owl-carousel owl-carousel-3 carousel-item-1 mt-3 ">
                                    @foreach (var news in secItem.News)
                                    {
                                        <a asp-action="News" asp-controller="Home" asp-route-id="@news.Id" class="text-decoration-none">
                                            <div class="card border-0 fade-slide hover-card">
                                                <img src="@(news.ImageUrl != null ? Url.Content($"~/upload/{news.ImageUrl}") : Url.Content("~/img/news.jpg"))"
                                                     class="card-img-top rounded hover-img" style="height:140px; object-fit:cover;" />
                                                <div class="card-body p-2">
                                                    <p class="small text-dark" style="white-space: normal; word-wrap: break-word;">
                                                        @news.Title?.Substring(0, Math.Min(news.Title.Length, 100))@(news.Title.Length > 100 ? "..." : "")
                                                    </p>
                                                </div>
                                            </div>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Right Column: Featured News -->
            <div class="col-lg-7">
                <div class="text-center p-3 bg-white shadow-sm rounded mb-4 fade-slide hover-card">
                    <h2 class="fw-bold text-danger"><i class="bi bi-star-fill me-2"></i>Featured News</h2>
                </div>

                <!-- Carousel for Desktop -->
                <div id="carouselExampleDark" class="carousel slide carousel-fade shadow rounded fade-slide hover-card d-none d-lg-block" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @{
                            bool isFirst = true;
                            foreach (var secItem in Model)
                            {
                                foreach (var news in secItem.News)
                                {
                                    <div class="carousel-item @(isFirst ? "active" : "")">
                                        <img src="@(news.ImageUrl != null ? Url.Content($"~/upload/{news.ImageUrl}") : Url.Content("~/img/news.jpg"))"
                                             class="d-block w-100 hover-img" style="height:500px; object-fit:cover; filter:brightness(0.6);" />
                                        <div class="carousel-caption d-none d-md-block">
                                            <h3>@news.Title?.Substring(0, Math.Min(news.Title.Length, 50))@(news.Title.Length > 50 ? "..." : "")</h3>
                                            <p class="text-light">@secItem.Name | @news.Created.ToString("dd/MM/yyyy")</p>
                                        </div>
                                    </div>
                                    isFirst = false;
                                }
                            }
                        }
                    </div>
                </div>

                <!-- Vertical List for Mobile -->
                <div class="d-lg-none">
                    @foreach (var secItem in Model)
                    {
                        foreach (var news in secItem.News.Take(3))
                        {
                            <div class="card mb-3 fade-slide hover-card">
                                <img src="@(news.ImageUrl != null ? Url.Content($"~/upload/{news.ImageUrl}") : Url.Content("~/img/news.jpg"))"
                                     class="card-img-top hover-img" style="height:200px; object-fit:cover;" />
                                <div class="card-body">
                                    <h5>@news.Title?.Substring(0, Math.Min(news.Title.Length, 50))@(news.Title.Length > 50 ? "..." : "")</h5>
                                    <p class="text-muted">@secItem.Name | @news.Created.ToString("dd/MM/yyyy")</p>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Highlights  -->
                <div class="row mt-5">
                    <div class="col-md-12">
                        <div class="border p-3 bg-white shadow-sm rounded fade-slide hover-card">
                            <h4 class="text-center text-secondary mb-3"><i class="bi bi-lightning-charge-fill text-warning"></i> Highlights</h4>
                            <marquee direction="up" scrollamount="5" height="460px">
                                @foreach (var secItem in Model)
                                {
                                    if (secItem.News.Any())
                                    {
                                        <div class="mb-4 text-center">
                                            <h5 class="text-primary fw-bold">@secItem.Name</h5>
                                        </div>
                                    }
                                    foreach (var news in secItem.News)
                                    {
                                        <a asp-action="News" asp-controller="Home" asp-route-id="@news.Id" class="text-decoration-none">
                                            <div class="card mb-3 border-0 shadow-sm hover-card">
                                                <div class="row g-0">
                                                    <div class="col-md-4">
                                                        <img src="@(news.ImageUrl != null ? Url.Content($"~/upload/{news.ImageUrl}") : Url.Content("~/img/news.jpg"))"
                                                             class="img-fluid rounded-start hover-img" style="height:100%; object-fit:cover;height:150px;" />
                                                    </div>
                                                    <div class="col-md-8">
                                                        <div class="card-body p-2">
                                                            <h6 class="card-title mb-1">@news.Title?.Substring(0, Math.Min(news.Title.Length, 50))@(news.Title.Length > 50 ? "..." : "")</h6>
                                                            <small class="text-muted">@news.Created.ToString("dd/MM/yyyy")</small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    }
                                }
                            </marquee>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Bottom Scrolling Bar  -->
<section class="bg-dark text-white mt-5 py-3 fade-slide hover-card">
    <marquee scrollamount="10">
        @foreach (var secItem in Model)
        {
            if (secItem.News.Any())
            {
                <span class="mx-4 fw-bold text-warning">@secItem.Name:</span>
                @foreach (var news in secItem.News)
                {
                    <span class="mx-3">@news.Title?.Substring(0, Math.Min(news.Title.Length, 100))@(news.Title.Length > 100 ? "..." : "")</span>
                }
            }
        }
    </marquee>
</section>

<link href="~/css/home/index.css" rel="stylesheet" />

@section Scripts {
    <script src="~/js/home/index.js"></script>

}
