@model NewsApp2.ViewModels.ApproveEmployeeVM

@{
    ViewData["Title"] = "Approve Employee";
}

<div class="container pt-4" style="min-height:75vh">
    <h3 class="fw-bold mb-4">Approve Employee</h3>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-lg-5">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["ErrorMessage"]
                        </div>
                    }
                    <div class="alert alert-info d-flex align-items-center">
                        <i class="bi bi-person-check-fill me-2"></i>
                        <div>Approve <b>@Model.EmployeeName</b> and assign the proper system role.</div>
                    </div>

                    <form asp-action="Approve" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="EmployeeId" />
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="EmployeeName" />

                        <div class="mb-3">
                            <label asp-for="RoleName" class="form-label fw-semibold"></label>
                            <select asp-for="RoleName" asp-items="Model.AvailableRoles" class="form-select"></select>
                            <span asp-validation-for="RoleName" class="text-danger"></span>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex gap-2">
                            <button type="submit" class="btn btn-success">Approve</button>
                            <a asp-action="Pending" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
