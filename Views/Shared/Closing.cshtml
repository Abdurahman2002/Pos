@model ClosingVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L

@{
    ViewBag.Title = L["Closing"];
    Layout = null;
}

<environment include="Development">
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
</environment>
<environment include="Staging,Production">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</environment>

<link href="~/css/template.css" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(135deg, #f0f4f7, #eceff1);
        font-family: 'Segoe UI', Tahoma, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        margin: 0;
    }

    .closing-card {
        width: 600px;
        border-radius: 25px;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
        background: linear-gradient(180deg, #f5f5f5, #e4f0f7);
        opacity: 0;
        transform: translateY(50px);
        transition: opacity 0.8s ease, transform 0.8s ease;
    }

        .closing-card.visible {
            opacity: 1;
            transform: translateY(0);
        }

    .closing-card-header {
        display: flex;
        align-items: center;
        padding: 25px;
        background: linear-gradient(90deg, #b0bec5, #d0e6f0);
        color: #37474f;
    }

        .closing-card-header img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background-color: #eceff1;
            padding: 10px;
            object-fit: contain;
            margin-right: 20px;
        }


        .closing-card-header h2 {
            margin: 0;
            font-weight: 600;
            font-size: 1.8rem;
        }

    .closing-card-body {
        padding: 30px;
        text-align: center;
        font-size: 1.1rem;
        color: #546e7a;
        background-color: #eceff1;
    }

    .closing-card-footer {
        background-color: #cfd8dc;
        color: #37474f;
        text-align: center;
        padding: 20px;
        font-size: 0.95rem;
        border-top: 1px solid #b0bec5;
    }

        .closing-card-footer small {
            display: block;
            margin: 3px 0;
        }
</style>

<div id="closingCard" class="closing-card">
    <div class="closing-card-header">
        @if (Model.SiteInfo != null)
        {
            <img id="imgAttach" src="@(Model.SiteInfo?.LogoUrl != null ? Url.Content("~/upload/" + Model.SiteInfo.LogoUrl) : Url.Content("~/img/logo.png"))" alt="Logo" />
            <h2 class="text-black-50">@Model.SiteInfo?.Name</h2>
        }
        else
        {
            <img id="imgAttach" src="~/img/logo.png" alt="Logo" />
            <h2>@L["Professional Programmer Company"]</h2>
        }
    </div>

    <div class="closing-card-body">
        @if (Model.SiteState != null)
        {
            <p>@Model.SiteState.ClosingMessage</p>
        }
        else
        {
            <p>@L["The site is temporarily closed for development"]</p>
        }
    </div>

    <div class="closing-card-footer">
        @if (Model.Contact != null)
        {
            <small>@Model.Contact.Email</small>
            <small>@Model.Contact.Phone</small>
        }
        else
        {
            <small>@L["The site is temporarily closed for development"]</small>
        }
    </div>
</div>

<script>
    // إضافة الكلاس visible بعد تحميل الصفحة لإظهار الكارد مع حركة
    document.addEventListener("DOMContentLoaded", function() {
        var card = document.getElementById("closingCard");
        setTimeout(function() {
            card.classList.add("visible");
        }, 100); // تأخير بسيط لإظهار الحركة
    });
</script>


