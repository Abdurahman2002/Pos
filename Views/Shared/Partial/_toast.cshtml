
<style>
    .custom-toast {
        border-radius: 14px !important;
        overflow: hidden;
        padding: 0 !important;
        font-size: 15px;
        backdrop-filter: blur(6px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.12);
        opacity: 0;
        transform: translateX(50px);
        transition: all .45s ease;
        min-width: 280px;
    }

        .custom-toast.show {
            opacity: 1;
            transform: translateX(0);
        }

    .toast-header {
        padding: 10px 14px !important;
        font-size: 16px;
        font-weight: 600;
        color: #fff;
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .toast-body {
        padding: 14px 18px !important;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #fff;
        font-size: 15px;
    }

    .toast-success {
        background: rgba(63, 201, 149, 0.9) !important;
    }

    .toast-error {
        background: rgba(220, 53, 69, 0.9) !important;
    }

    .btn-close {
        filter: brightness(0) invert(1);
    }
</style>


@if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
{
    <!-- SweetAlert2 CSS & JS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: 'عملية ناجحة!',
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]?.ToString() ?? string.Empty)),
                    icon: 'success',
                    confirmButtonText: 'حسناً',
                    confirmButtonColor: '#3085d6',
                    timer: 3000,
                    timerProgressBar: true,
                    showClass: {
                        popup: 'animate__animated animate__fadeInDown'
                    },
                    hideClass: {
                        popup: 'animate__animated animate__fadeOutUp'
                    }
                });
                </text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: 'خطأ!',
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"]?.ToString() ?? string.Empty)),
                    icon: 'error',
                    confirmButtonText: 'حسناً',
                    confirmButtonColor: '#d33',
                    showClass: {
                        popup: 'animate__animated animate__shakeX'
                    }
                });
                </text>
            }
        });
    </script>
}
