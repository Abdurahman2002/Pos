@model NewsApp2.ViewModels.Purchasing.PurchaseEditVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@{
    ViewData["Title"] = "تعديل المشتريات";
    var lineCount = Model?.Lines?.Count > 0 ? Model.Lines.Count : 1;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var canCreateSupplier = User.IsInRole("Admin") || User.IsInRole("Prog") || User.IsInRole("SalesManager");
    var createSupplierUrl = Url.Action("Create", "Suppliers", new { returnUrl }) ?? "/Suppliers/Create";
    var itemSalePricesJson = ViewBag.ItemSalePricesJson as string ?? "{}";
}

<!-- NEW CSS for Dashboard/POS-like Layout -->
<style>
    .pos-layout {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 15px;
    }
    
    .pos-main-panel {
        flex: 1 1 65%;
        min-width: 320px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .pos-side-panel {
        flex: 1 1 30%;
        min-width: 320px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .invoice-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.04);
        border: none;
        overflow: hidden;
    }

    .invoice-card-header {
        background: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        padding: 14px 20px;
        font-weight: 800;
        color: #1e293b;
        font-size: 1.15rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .purchase-lines-table {
        max-height: calc(100vh - 300px);
        overflow-y: auto;
        width: 100%;
        background: #fff;
    }
    
    .purchase-lines-table table { 
        margin: 0; 
        table-layout: fixed;
        width: 100%;
    }
    .purchase-lines-table thead th {
        position: sticky;
        top: 0;
        background: #f4f4f5;
        color: #475569;
        font-weight: 800;
        z-index: 5;
        padding: 15px;
        border-bottom: 2px solid #cbd5e1;
        text-transform: uppercase;
        font-size: 0.9rem;
    }
    
    .purchase-lines-table tbody td {
        vertical-align: middle;
        padding: 12px 15px;
        border-bottom: 1px solid #f8fafc;
    }

    .qty-input, .price-input, .sell-price-input, .line-total {
        border-radius: 8px;
        text-align: center;
        font-weight: 800;
    }
    
    .qty-input { border-color: #cbd5e1; color: #0f172a; }
    .qty-input:focus { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2); }
    
    .line-total { background: #f8fafc !important; color: #1e40af; border: 1px dashed #cbd5e1; }

    .qty-input::placeholder,
    .price-input::placeholder,
    .sell-price-input::placeholder {
        color: #94a3b8;
        opacity: 1;
        font-weight: 600;
    }

    .invoice-date-input {
        direction: ltr;
        unicode-bidi: isolate;
        text-align: center;
        font-weight: 800;
        letter-spacing: 0.3px;
    }
    
    /* Hide number arrows */
    input[type=number]::-webkit-inner-spin-button, 
    input[type=number]::-webkit-outer-spin-button { 
        -webkit-appearance: none; 
        margin: 0; 
    }
    input[type=number] {
        -moz-appearance: textfield;
    }
    
    .summary-card {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        color: #fff;
        border-radius: 14px;
        padding: 24px;
        position: relative;
        overflow: hidden;
    }
    
    .summary-card::before {
        content: "\"; position: absolute; top: -30px; right: -30px;
        width: 100px; height: 100px; border-radius: 50%;
        background: rgba(255,255,255,0.05);
    }
    .summary-card::after {
        content: "\"; position: absolute; bottom: -20px; left: -20px;
        width: 80px; height: 80px; border-radius: 50%;
        background: rgba(255,255,255,0.05);
    }

    .summary-val {
        font-size: 2.2rem;
        font-weight: 900;
        color: #34d399;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }
    
    .summary-secondary-val {
        font-size: 1.3rem;
        font-weight: 700;
        color: #cbd5e1;
    }

    .action-btn {
        padding: 16px;
        font-size: 1.25rem;
        font-weight: 800;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        transition: all 0.2s;
    }
    .action-btn:hover { transform: translateY(-3px); box-shadow: 0 8px 15px rgba(0,0,0,0.1); }
    .action-btn:active { transform: translateY(0); }

</style>

<div class="d-flex justify-content-between align-items-center mb-1">
    <h2 class="mb-0 fw-bold text-dark"><i class="mdi mdi-file-document-edit text-primary mdi-36px align-middle"></i> شاشة تعديل المشتريات</h2>
    <div class="text-muted fw-bold d-none d-md-block">
        <span class="badge bg-white shadow-sm text-dark border px-3 py-2 me-1"><i class="mdi mdi-keyboard text-primary"></i> F9 اعتماد وحفظ</span>
        <span class="badge bg-white shadow-sm text-dark border px-3 py-2"><i class="mdi mdi-keyboard text-primary"></i> F4 إضافة سطر</span>
    </div>
</div>

<script id="item-sale-prices-json" type="application/json">@Html.Raw(itemSalePricesJson)</script>

<form asp-action="Edit" method="post" class="invoice-create-form w-100">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="InvoiceId" />
    <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3"></div>

    <div class="pos-layout">
        <!-- ==== Main Panel (Items Table) ==== -->
        <div class="pos-main-panel">
            
            <!-- Items Table Block -->
            <div class="invoice-card flex-grow-1 d-flex flex-column shadow-lg">
                <div class="invoice-card-header d-flex justify-content-between">
                    <span><i class="mdi mdi-format-list-bulleted text-primary"></i> تعديل قائمة المشتريات</span>
                    <span class="badge bg-primary rounded-pill" id="items-count-badge">@lineCount</span>
                </div>
                <div class="purchase-lines-table">
                    <table class="table table-hover mb-0" id="lines-table">
                        <thead>
                            <tr>
                                <th style="width: 40%;">الصنف الوارد</th>
                                <th style="width: 12%;" class="text-center">الكمية</th>
                                <th style="width: 16%;" class="text-center">سعر الشراء</th>
                                <th style="width: 16%;" class="text-center">سعر البيع</th>
                                <th style="width: 16%;" class="text-center">إجمالي السطر</th>
                                <th style="width: 5%;" class="text-center"><i class="mdi mdi-settings"></i></th>
                            </tr>
                        </thead>
                        <tbody>
                        @for (int i = 0; i < lineCount; i++)
                        {
                            <tr>
                                <td>
                                    <select asp-for="Lines[i].ItemId" asp-items="@(ViewData["Items"] as SelectList)" class="form-select form-select-lg item-select fw-bold border-secondary shadow-none">
                                        <option value="">اختر الصنف...</option>
                                    </select>
                                    <span asp-validation-for="Lines[i].ItemId" class="text-danger small fw-bold"></span>
                                </td>
                                <td>
                                    <input asp-for="Lines[i].Qty" class="form-control qty-input bg-light" type="number" step="1" min="1" inputmode="numeric" placeholder="0" />
                                    <span asp-validation-for="Lines[i].Qty" class="text-danger small fw-bold"></span>
                                </td>
                                <td>
                                    <input asp-for="Lines[i].UnitPriceEur" class="form-control price-input fw-bold border-primary shadow-sm" type="number" step="0.01" min="0" placeholder="0.00" />
                                    <span asp-validation-for="Lines[i].UnitPriceEur" class="text-danger small fw-bold mt-1 d-block"></span>
                                </td>
                                <td>
                                    <input asp-for="Lines[i].SellPriceLyd" class="form-control sell-price-input fw-bold border-success shadow-sm" type="number" step="0.01" min="0" placeholder="0.00" />
                                    <span asp-validation-for="Lines[i].SellPriceLyd" class="text-danger small fw-bold mt-1 d-block"></span>
                                </td>
                                <td>
                                    <input class="form-control line-total fw-bold text-center" type="text" value="0.00" readonly tabindex="-1" />
                                </td>
                                <td class="text-center align-middle">
                                    <button type="button" class="btn btn-outline-danger btn-sm remove-line rounded-3 px-3 shadow-sm"><i class="mdi mdi-trash-can mdi-18px"></i></button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="p-3 border-top" style="background:#f8fafc;">
                    <button type="button" class="btn btn-primary fw-bold px-4 py-2 rounded-pill shadow-sm" id="add-line"><i class="mdi mdi-plus-circle"></i> إضافة صنف يدوياً (F4)</button>
                </div>
            </div>

        </div>

        <!-- ==== Sidebar Panel (Details & Actions) ==== -->
        <div class="pos-side-panel">
            
            <!-- Summary Block -->
            <div class="summary-card shadow-lg position-relative">
                <div class="text-uppercase tracking-wider mb-2" style="color: #94a3b8; font-size: 0.95rem; font-weight: 800;"><i class="mdi mdi-calculator"></i> ملخص الفاتورة</div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-light fw-bold">الإجمالي قبل الخصم</span>
                    <span><span id="live-total-eur" class="fs-4 fw-bold text-white">0.00</span> <span class="text-white fw-bold">د.ل</span></span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-light fw-bold">الخصم</span>
                    <span><span id="live-discount-eur" class="fs-4 fw-bold text-warning">0.00</span> <span class="text-white fw-bold">د.ل</span></span>
                </div>
                <div class="pt-3 border-top border-secondary">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-light fw-bold fs-5">الصافي للدفع</span>
                        <span>
                            <span id="live-total-secondary" class="summary-secondary-val">0.00</span>
                            <span class="fs-4 text-white fw-bold">د.ل</span>
                            <span id="live-net-eur" class="d-none">0.00</span>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Invoice Details Block -->
            <div class="invoice-card flex-grow-1 border border-light">
                <div class="invoice-card-header">
                    <i class="mdi mdi-file-document-edit text-primary"></i> بيانات المعاملة
                </div>
                <div class="p-4">
                    <div class="mb-4">
                        <label asp-for="InvoiceDate" class="form-label fw-bold text-dark fs-6"></label>
                        @* Old readonly display-only date block kept for reference
                        @* <input asp-for="InvoiceDate" type="hidden" value="@Model.InvoiceDate.ToString("dd/MM/yyyy")" /> *@
                        @* <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white text-primary"><i class="mdi mdi-calendar-clock mdi-24px"></i></span>
                            <input id="InvoiceDateDisplay" class="form-control invoice-date-display" type="text" value="@Model.InvoiceDate.ToString("dd/MM/yyyy")" readonly lang="en-GB" />
                        </div> *@
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white text-primary"><i class="mdi mdi-calendar-clock mdi-24px"></i></span>
                            <input asp-for="InvoiceDate" type="text" class="form-control invoice-date-input date-input js-date" value="@Model.InvoiceDate.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)" placeholder="dd/MM/yyyy" dir="ltr" lang="en-GB" autocomplete="off" />
                        </div>
                        <span asp-validation-for="InvoiceDate" class="text-danger fw-bold mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PaymentMethod" class="form-label fw-bold text-dark fs-6">طريقة الدفع</label>
                        <select asp-for="PaymentMethod" class="form-select form-select-lg shadow-sm" id="payment-method">
                            <option value="Cash">نقدي</option>
                            <option value="Credit">آجل</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger fw-bold mt-1 d-block"></span>
                    </div>

                    <div class="mb-4" id="supplier-wrapper">
                        <label asp-for="SupplierId" class="form-label fw-bold text-dark fs-6">المورد</label>
                        <select asp-for="SupplierId" asp-items="@(ViewData["Suppliers"] as SelectList)" class="form-select form-select-lg shadow-sm" id="supplier-id">
                            <option value="">اختر المورد...</option>
                        </select>
                        @if (canCreateSupplier)
                        {
                            <a href="@createSupplierUrl" class="small fw-bold mt-2 d-inline-block" target="_blank"><i class="mdi mdi-plus-circle"></i> إضافة مورد جديد</a>
                        }
                        <span asp-validation-for="SupplierId" class="text-danger fw-bold mt-1 d-block"></span>
                    </div>

                    <div class="mb-4" id="due-date-wrapper">
                        <label asp-for="DueDate" class="form-label fw-bold text-dark fs-6">تاريخ الاستحقاق</label>
                        <input asp-for="DueDate" type="text" class="form-control form-control-lg shadow-sm invoice-date-input date-input js-date" value="@(Model.DueDate.HasValue ? Model.DueDate.Value.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) : string.Empty)" placeholder="dd/MM/yyyy" dir="ltr" lang="en-GB" autocomplete="off" />
                        <small class="text-muted d-block mt-1">تاريخ الاستحقاق يعني آخر موعد سداد الفاتورة في حالة الشراء الآجل.</small>
                        <span asp-validation-for="DueDate" class="text-danger fw-bold mt-1 d-block"></span>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-5">
                            <label asp-for="DiscountType" class="form-label fw-bold text-dark fs-6">نوع الخصم</label>
                            <select asp-for="DiscountType" class="form-select form-select-lg shadow-sm" id="discount-type">
                                <option value="Amount">قيمة</option>
                                <option value="Percent">نسبة %</option>
                            </select>
                            <span asp-validation-for="DiscountType" class="text-danger fw-bold mt-1 d-block"></span>
                        </div>
                        <div class="col-7">
                            <label asp-for="DiscountValue" class="form-label fw-bold text-dark fs-6">قيمة الخصم</label>
                            <input asp-for="DiscountValue" class="form-control form-control-lg shadow-sm" id="discount-value" type="number" step="0.01" min="0" inputmode="decimal" placeholder="0.00" />
                            <span asp-validation-for="DiscountValue" class="text-danger fw-bold mt-1 d-block"></span>
                        </div>
                    </div>
                    
                    <input asp-for="CurrencyCode" type="hidden" value="LYD" />      
                    <input asp-for="EurToDinarRateSnapshot" type="hidden" value="1" />

                    <div>
                        <label asp-for="Note" class="form-label fw-bold text-dark fs-6"></label>   
                        <textarea asp-for="Note" class="form-control form-control-lg shadow-sm" rows="3" placeholder="ملاحظات والتعديلات على الفاتورة..." style="border-radius: 12px; font-weight:500;"></textarea>
                        <span asp-validation-for="Note" class="text-danger fw-bold mt-1 d-block"></span> 
                    </div>
                </div>
            </div>

            <!-- Actions Block -->
            <div class="mt-auto d-grid gap-3 pt-2">
                <button type="submit" class="btn btn-warning action-btn shadow-lg bg-gradient text-dark"><i class="mdi mdi-content-save-edit mdi-36px"></i> حفظ التعديلات (F9)</button>
                <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-secondary action-btn text-white shadow-sm"><i class="mdi mdi-close-circle-outline mdi-24px"></i> إلغاء التعديل</a>
            </div>

        </div>
    </div>
</form>

<template id="line-template">
    <td>
        <select name="Lines[__index__].ItemId" class="form-select form-select-lg item-select fw-bold border-secondary shadow-none"> 
            <option value="">اختر الصنف...</option>
            @if (ViewData["Items"] is SelectList items)
            {
                foreach (var item in items)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            }
        </select>
    </td>
    <td><input name="Lines[__index__].Qty" class="form-control qty-input bg-light" type="number" step="1" min="1" inputmode="numeric" placeholder="0" /></td>
    <td>
        <input name="Lines[__index__].UnitPriceEur" class="form-control price-input fw-bold border-primary shadow-sm" type="number" step="0.01" min="0" placeholder="0.00" />
    </td>
    <td>
        <input name="Lines[__index__].SellPriceLyd" class="form-control sell-price-input fw-bold border-success shadow-sm" type="number" step="0.01" min="0" placeholder="0.00" />
    </td>
    <td><input class="form-control line-total fw-bold text-center" type="text" value="0.00" readonly tabindex="-1" /></td>
    <td class="text-center align-middle"><button type="button" class="btn btn-outline-danger btn-sm remove-line rounded-3 px-3 shadow-sm"><i class="mdi mdi-trash-can mdi-18px"></i></button></td>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/lines-table.js"></script>

    @* إضافة اختصارات لوحة المفاتيح السحرية وتحديث العداد *@
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const updateItemsCount = () => {
                const rows = document.querySelectorAll('#lines-table tbody tr');
                const badge = document.getElementById('items-count-badge');
                if(badge) badge.innerText = rows.length;
            };

            // Observer to track table changes for items count
            const observer = new MutationObserver(updateItemsCount);
            const tbody = document.querySelector('#lines-table tbody');
            if(tbody) {
                observer.observe(tbody, { childList: true });
            }
        });

        document.addEventListener('keydown', function(e) {
            // F9 لحفظ التعديلات
            if (e.key === 'F9') {
                e.preventDefault();
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'حفظ التعديلات (F9)',
                        text: 'هل أنت متأكد من حفظ تعديلات المشتريات؟',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: '<i class="mdi mdi-check"></i> نعم، احفظ الفاتورة',
                        cancelButtonText: 'إلغاء',
                        confirmButtonColor: '#eab308',
                        cancelButtonColor: '#64748b'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            document.querySelector('.invoice-create-form').submit();
                        }
                    });
                } else {
                    if (confirm('هل أنت متأكد من حفظ الفاتورة بعد التعديل؟ (F9)')) {      
                        document.querySelector('.invoice-create-form').submit();
                    }
                }
            }

            // F4 لإضافة سطر يدوياً والتركيز عليه
            if (e.key === 'F4') {
                e.preventDefault();
                document.getElementById('add-line').click();
                setTimeout(() => {
                    const selects = document.querySelectorAll('#lines-table tbody select.item-select');
                    if (selects.length > 0) selects[selects.length - 1].focus();
                }, 100);
            }
        });

        (function initPurchaseCreditUi() {
            const paymentMethod = document.getElementById('payment-method');
            const supplierWrapper = document.getElementById('supplier-wrapper');
            const dueDateWrapper = document.getElementById('due-date-wrapper');
            const dueDateInput = document.getElementById('DueDate');
            const supplierInput = document.getElementById('supplier-id');
            if (!paymentMethod || !supplierWrapper || !dueDateWrapper || !dueDateInput || !supplierInput) return;

            const refresh = () => {
                const isCredit = (paymentMethod.value || '').toLowerCase() === 'credit';
                supplierWrapper.classList.remove('d-none');
                dueDateWrapper.classList.toggle('d-none', !isCredit);
                dueDateInput.required = isCredit;
                supplierInput.required = true;
                if (!isCredit) {
                    dueDateInput.value = '';
                }
            };

            paymentMethod.addEventListener('change', refresh);
            refresh();
        })();
    </script>
}
