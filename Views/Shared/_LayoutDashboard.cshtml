
@inject IUnitOfWork<SiteInfo> _siteInfo
@inject UserManager<ApplicationUser> _userManager
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@using System.Globalization
@{
    var isCashier = User.IsInRole("Cashier");
    var canDashboard = User.IsInRole("Admin") || User.IsInRole("Prog") || User.IsInRole("SalesManager");
    var homeController = isCashier ? "SalesInvoices" : (canDashboard ? "Dashboard" : "StockBalances");
    var homeAction = isCashier ? "Create" : "Index";
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta name="viewport" content="width=device-width" />
    @* --------------------------------------------------------------- *@
    @{
        var siteInfo = _siteInfo.Repository.GetAll().SingleOrDefault();
        ViewBag.SiteName = @siteInfo?.Name;
        ViewBag.LogoUrl = @siteInfo?.LogoUrl;
        var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    }

    <partial name="Partial/_title"></partial>
    @* --------------------------------------------------------------- *@
    @if (isRtl)
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    }
    else
    {
        <environment include="Development">
            <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
        </environment>
        <environment include="Staging,Production">
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        </environment>
    }


    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet" />
    @*------------------------------ Dashboard template -------------------------------*@
    <link rel="stylesheet" href="~/assets1/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/assets1/css/style.css">
    @* ------------------------------------------------------------------------------ *@
    <link href="~/css/template.css" rel="stylesheet" />
    <link href="~/css/dashboard.css" rel="stylesheet" />
    <link href="~/css/date-inputs.css" rel="stylesheet" />
    <!-- ERP Theme UI Modernization injected safely -->
    <link href="~/css/erp-theme.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet" />
    @if (isRtl)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
        <link href="~/css/rtl-support.css" rel="stylesheet" />
        <style>
            body { font-family: 'Cairo', sans-serif; }
        </style>
    }
    @* ------------------------------------------------------------------------------ *@
</head>
<body>

    <div class="container-scroller">
        <!-- partial:partials/_navbar.html -->
        <nav class="navbar default-layout-navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row border-bottom">
            <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-center">

                @if (ViewBag.LogoUrl != null)
                {
                    <a class="navbar-brand brand-logo" asp-controller="@homeController" asp-action="@homeAction"><img src="~/upload/@ViewBag.LogoUrl" alt="logo" style="width:40px;height:40px;" /></a>
                    <a class="navbar-brand brand-logo-mini" asp-controller="@homeController" asp-action="@homeAction"><img src="~/upload/@ViewBag.LogoUrl" alt="logo" style="width:40px;height:40px;" /></a>
                }
                else
                {

                    <a class="navbar-brand brand-logo" asp-controller="@homeController" asp-action="@homeAction"><img src="~/img/logo.png" alt="logo" style="width:40px;height:40px;" /></a>
                    <a class="navbar-brand brand-logo-mini" asp-controller="@homeController" asp-action="@homeAction"><img src="~/img/logo.png" alt="logo" style="width:40px;height:40px;" /></a>
                }
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-stretch">
                <a class="navbar-toggler navbar-toggler align-self-center mt-4 fs-2" style="cursor:pointer" data-toggle="minimize">
                    <span class="mdi mdi-menu"></span>
                </a>

                <form class="d-none d-md-flex align-items-center ms-3 flex-grow-1" method="get" asp-controller="Search" asp-action="Index" role="search" style="max-width: 460px;">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="mdi mdi-magnify"></i></span>
                        <input type="search" name="q" value="@(Context.Request.Query["q"])" class="form-control border-start-0" placeholder="بحث: صنف / باركود / عميل / رقم فاتورة" aria-label="بحث" autocomplete="off" />
                    </div>
                </form>

                <div class="d-none d-md-flex align-items-center ms-3 me-2">
                    <partial name="Partial/_LanguageSwitcher"></partial>
                </div>

                <ul class="navbar-nav navbar-nav-right">
                    <li class="nav-item nav-profile dropdown">
                        <a class="nav-link dropdown-toggle" id="profileDropdown" href="#" data-toggle="dropdown" aria-expanded="false">

                            <!--------------------------------------------------------------------------------->
                            <div class="nav-profile-img">
                                <img src="~/img/User.png" alt="no img" />
                            </div>
                            <div class="nav-profile-text">
                                <p class="mb-1 text-black">@(User.Identity?.Name ?? "User")</p>
                            </div>

                            <!--------------------------------------------------------------------------------->
                        </a>
                        <div class="dropdown-menu navbar-dropdown dropdown-menu-right p-0 border-0 font-size-sm" aria-labelledby="profileDropdown" data-x-placement="bottom-end">
                            <div class="p-3 text-center bg-primary">
                                <img class="img-avatar img-avatar48 img-avatar-thumb" src="~/img/User.png" alt="">
                            </div>
                            <div class="p-2">
                                <h5 class="dropdown-header text-uppercase  pl-2 text-dark mt-2">@L["Account"]</h5>
                                <a class="dropdown-item py-1 d-flex align-items-center justify-content-between" asp-action="ChangePassword" asp-controller="Account">
                                    <span>@L["ChangePassword"]</span>
                                    <i class="mdi mdi-lock-reset"></i>
                                </a>
                                <div role="separator" class="dropdown-divider"></div>
                                <h5 class="dropdown-header text-uppercase  pl-2 text-dark mt-2">@L["SignedIn"]</h5>

                                <a class="dropdown-item py-1 d-flex align-items-center justify-content-between" asp-action="Logout" asp-controller="Account">
                                    <span>@L["LogOut"]</span>
                                    <i class="mdi mdi-logout ml-1"></i>
                                </a>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
            @* يظهر في الشاشات الصغيرة *@
            <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center me-2 fs-3" type="button" data-toggle="offcanvas">
                <span class="mdi mdi-menu"></span>
            </button>
        </nav>

        <!-- partial -->
        <div class="container-fluid page-body-wrapper">
            <nav class="sidebar sidebar-offcanvas" id="sidebar">
                <ul class="nav">
                    <!-- لوحة التحكم الرئيسية -->
                    <li class="nav-item">
                        <a href="@Url.Action(homeAction, homeController)" class="nav-link ajax-link">
                            <span class="icon-bg"><i class="mdi @(isCashier ? "mdi-point-of-sale" : "mdi-view-dashboard") menu-icon"></i></span>
                            <span class="menu-title">@(isCashier ? "نقطة البيع (POS)" : (canDashboard ? "لوحة المؤشرات" : L["InventoryDashboard"].Value))</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <span class="nav-link disabled text-uppercase small fw-bold text-muted">إدارة المبيعات</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#salesMenu" aria-expanded="false" aria-controls="salesMenu">
                            <span class="icon-bg"><i class="mdi mdi-cash-register menu-icon"></i></span>
                            <span class="menu-title">إدارة البيع</span>
                            <i class="menu-arrow"></i>
                        </a>
                        <div class="collapse" id="salesMenu">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">
                                    <a href="@Url.Action("Create", "SalesInvoices")" class="nav-link ajax-link">
                                        <i class="mdi mdi-point-of-sale"></i> نقطة البيع (POS)
                                    </a>
                                </li>
                                @if (!User.IsInRole("Cashier"))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "SalesInvoices")" class="nav-link ajax-link">
                                            <i class="mdi mdi-file-document"></i> فواتير البيع
                                        </a>
                                    </li>
                                }
                                <li class="nav-item">
                                    <a href="@Url.Action("SimpleDailyReport", "SalesInvoices")" class="nav-link ajax-link">
                                        <i class="mdi mdi-calendar-today"></i> تقرير المبيعات اليومي
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Report", "SalesInvoices")" class="nav-link ajax-link">
                                        <i class="mdi mdi-chart-bar"></i> تقرير المبيعات
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Drafts", "SalesInvoices")" class="nav-link ajax-link">
                                        <i class="mdi mdi-content-save-edit"></i> الفواتير المعلقة
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                    @if (!isCashier)
                    {
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#customersMenu" aria-expanded="false" aria-controls="customersMenu">
                            <span class="icon-bg"><i class="mdi mdi-account-group menu-icon"></i></span>
                            <span class="menu-title">الأطراف والذمم</span>
                            <i class="menu-arrow"></i>
                        </a>
                        <div class="collapse" id="customersMenu">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "PartyAccounts")" class="nav-link ajax-link">
                                        <i class="mdi mdi-scale-balance"></i> لوحة الحسابات
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Customers")" class="nav-link ajax-link">
                                        <i class="mdi mdi-account-multiple"></i> @L["Customers"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Debts", "Customers")" class="nav-link ajax-link">
                                        <i class="mdi mdi-cash-multiple"></i> ديون العملاء
                                    </a>
                                </li>
                                @if (!User.IsInRole("Cashier"))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Suppliers")" class="nav-link ajax-link">
                                            <i class="mdi mdi-truck"></i> الموردون
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="@Url.Action("Debts", "Suppliers")" class="nav-link ajax-link">
                                            <i class="mdi mdi-cash-100"></i> ديون الموردين
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </li>
                    }

                    @if (!isCashier)
                    {
                    <!-- المخزون -->
                    <li class="nav-item">
                        <span class="nav-link disabled text-uppercase small fw-bold text-muted">@L["Inventory"]</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#inventoryMenu" aria-expanded="false" aria-controls="inventoryMenu">
                            <span class="icon-bg"><i class="mdi mdi-store menu-icon"></i></span>
                            <span class="menu-title">سجل المخزون</span>     
                            <i class="menu-arrow"></i>
                        </a>
                        <div class="collapse" id="inventoryMenu">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "StockBalances")" class="nav-link ajax-link">
                                        <i class="mdi mdi-warehouse"></i> نظرة عامة على المخزون
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Categories")" class="nav-link ajax-link">
                                        <i class="mdi mdi-tag"></i> @L["Categories"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Items")" class="nav-link ajax-link">
                                        <i class="mdi mdi-package-variant"></i> @L["Items"]
                                    </a>
                                </li>
                                @if (!User.IsInRole("Cashier"))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Movement", "StockBalances")" class="nav-link ajax-link">
                                            <i class="mdi mdi-chart-line"></i> @L["StockMovement"]
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="@Url.Action("DailyInventory", "StockBalances")" class="nav-link ajax-link">
                                            <i class="mdi mdi-calendar-check"></i> تقرير الجرد اليومي
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="@Url.Action("ItemCard", "StockBalances")" class="nav-link ajax-link">
                                            <i class="mdi mdi-clipboard-text-outline"></i> بطاقة الصنف
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </li>
                    }

                    @if (!isCashier)
                    {
                    <!-- التقارير المعتمدة -->
                    <li class="nav-item">
                        <span class="nav-link disabled text-uppercase small fw-bold text-muted" style="color:#10b981 !important;">التقارير</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#managementReportsMenu" aria-expanded="false" aria-controls="managementReportsMenu">
                            <span class="icon-bg"><i class="mdi mdi-chart-bar menu-icon"></i></span>
                            <span class="menu-title">تقارير الإدارة</span>
                            <i class="menu-arrow"></i>
                        </a>
                        <div class="collapse" id="managementReportsMenu">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">
                                    <a href="@Url.Action("Reports", "ManagementReports")" class="nav-link ajax-link">
                                        <i class="mdi mdi-chart-bar"></i> التقارير المالية
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("DailyInventory", "ManagementReports")" class="nav-link ajax-link">
                                        <i class="mdi mdi-calendar-check"></i> الجرد اليومي
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Stock", "ManagementReports")" class="nav-link ajax-link">
                                        <i class="mdi mdi-package-variant-closed"></i> المخزون
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                    }

                    <!-- قسم المالية والإدارة -->
                    @if (User.IsInRole("Admin") || User.IsInRole("Prog") || User.IsInRole("SalesManager") || !User.IsInRole("Cashier"))
                    {
                        <li class="nav-item">
                            <span class="nav-link disabled text-uppercase small fw-bold text-muted">المالية والإدارة</span>
                        </li>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Prog") || User.IsInRole("SalesManager"))
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "PurchaseInvoices")" class="nav-link ajax-link">
                                <span class="icon-bg"><i class="mdi mdi-cart-plus menu-icon"></i></span>
                                <span class="menu-title">@L["Purchases"]</span> 
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Banks")" class="nav-link ajax-link">
                                <span class="icon-bg"><i class="mdi mdi-bank menu-icon"></i></span>
                                <span class="menu-title">المصارف</span>
                            </a>
                        </li>
                    }
                    @if (!User.IsInRole("Cashier"))
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Expenses")" class="nav-link ajax-link">
                                <span class="icon-bg"><i class="mdi mdi-wallet menu-icon"></i></span>
                                <span class="menu-title">المصروفات والمرتبات</span>
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Prog") || User.IsInRole("Admin") || User.IsInRole("SalesManager"))
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("ProfitLoss", "FinancialReports")" class="nav-link ajax-link">
                                <span class="icon-bg"><i class="mdi mdi-cash menu-icon"></i></span>
                                <span class="menu-title">@L["FinancialReport"]</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Journal", "FinancialReports")" class="nav-link ajax-link">
                                <span class="icon-bg"><i class="mdi mdi-notebook menu-icon"></i></span>
                                <span class="menu-title">دفتر القيود</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("TrialBalance", "FinancialReports")" class="nav-link ajax-link">
                                <span class="icon-bg"><i class="mdi mdi-scale-balance menu-icon"></i></span>
                                <span class="menu-title">ميزان المراجعة</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "PosShifts")" class="nav-link ajax-link">
                                <span class="icon-bg"><i class="mdi mdi-cash-register menu-icon"></i></span>
                                <span class="menu-title">سجل الورديات</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("CashierPerformance", "PosShifts")" class="nav-link ajax-link">
                                <span class="icon-bg"><i class="mdi mdi-chart-line menu-icon"></i></span>
                                <span class="menu-title">تقرير الموظفين والرواتب</span>
                            </a>
                        </li>
                    }

                    @if (!isCashier)
                    {
                    <!-- المراسلات والإعدادات -->
                    <li class="nav-item">
                        <span class="nav-link disabled text-uppercase small fw-bold text-muted">النظام والمستخدمين</span>
                    </li>
                    
                    <li class="nav-item">
                        <a href="@Url.Action("SendEmail", "Mail")" class="nav-link ajax-link">
                            <span class="icon-bg"><i class="mdi mdi-email menu-icon"></i></span>
                            <span class="menu-title">@L["EmailSend"]</span>     
                        </a>
                    </li>
                    
                    @if (User.IsInRole("Prog") || User.IsInRole("Admin"))       
                    {
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="collapse" href="#users" aria-expanded="false" aria-controls="auth">
                                <span class="icon-bg"><i class="mdi mdi-account-settings menu-icon"></i></span>
                                <span class="menu-title">@L["Users"]</span>     
                                <i class="menu-arrow"></i>
                            </a>
                            <div class="collapse" id="users">
                                <ul class="nav flex-column sub-menu">
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "Employees")" class="nav-link ajax-link">
                                            <i class="mdi mdi-account-outline"></i> @L["Employees"]
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Prog"))
                                    {
                                        <li class="nav-item">
                                            <a href="@Url.Action("Index", "Roles")" class="nav-link ajax-link">
                                                <i class="mdi mdi-shield-half-full"></i> @L["Roles"]
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#settings" aria-expanded="false" aria-controls="auth">
                            <span class="icon-bg"><i class="mdi mdi-settings menu-icon"></i></span>
                            <span class="menu-title">@L["Settings"]</span>      
                            <i class="menu-arrow"></i>
                        </a>
                        <div class="collapse" id="settings">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">

                                    @if(User.IsInRole("Prog"))
                                    {
                                        <a href="@Url.Action("SiteState", "Admin")" class="nav-link ajax-link">
                                            <i class="mdi mdi-web"></i> @L["SiteState"]
                                        </a>
                                    }

                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("SiteDetails", "Admin")" class="nav-link ajax-link">
                                        <i class="mdi mdi-information"></i> @L["SiteInfoContact"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("EmailSettings", "Mail")" class="nav-link ajax-link">
                                        <i class="mdi mdi-settings"></i> @L["EmailSettings"]
                                    </a>
                                </li>
                                @if (User.IsInRole("Admin") || User.IsInRole("Prog") || User.IsInRole("SalesManager"))
                                {
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index", "AuditLogs")" class="nav-link ajax-link">
                                            <i class="mdi mdi-clipboard-text"></i> @L["AuditLogs"]
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </li>
                    }
                    <li class="nav-item sidebar-user-actions">
                        <div class="sidebar-user-menu">
                            <a href="@Url.Action("Logout", "Account")" class="nav-link ajax-link text-danger">
                                <i class="mdi mdi-logout menu-icon text-danger"></i>
                                <span class="menu-title px-2 fw-bold">@L["LogOut"]</span>
                            </a>
                        </div>
                    </li>
                </ul>
            </nav>

            <!-- partial -->
            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
                <footer class="footer ">
                    <div class="footer-inner-wraper">
                        <div class="d-sm-flex justify-content-center justify-content-sm-between">
                            @L["Copyright"] &copy; @DateTime.Now.Year - @ViewBag.SiteName
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    @*------------------------------ Dashboard template -------------------------------*@
    <script src="~/assets1/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/assets1/js/off-canvas.js"></script>
    <script src="~/assets1/js/misc.js"></script>
    <script src="~/assets1/js/hoverable-collapse.js"></script>
    @* ------------------------------------------------------------------------------ *@

    <environment include="Development">
        <script src="~/lib/jquery/jquery.min.js"></script>
        <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    </environment>
    <environment include="Staging,Production">
        <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
