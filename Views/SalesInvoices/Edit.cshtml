@model NewsApp2.ViewModels.Sales.SalesEditVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@{
    ViewData["Title"] = "تعديل فاتورة البيع";
    var lineCount = Model?.Lines?.Count > 0 ? Model.Lines.Count : 1;
}

<h1>تعديل فاتورة البيع</h1>
<form asp-action="Edit" method="post" class="invoice-create-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="InvoiceId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="InvoiceDate" class="form-label"></label>
            @Html.EditorFor(m => m.InvoiceDate)
            <span asp-validation-for="InvoiceDate" class="text-danger"></span>
        </div>
        <input asp-for="CurrencyCode" type="hidden" value="LYD" />
        <input asp-for="EurToDinarRateSnapshot" type="hidden" value="1" />
        <div class="col-md-3">
            <label asp-for="CustomerId" class="form-label">العميل</label>
            <select asp-for="CustomerId" asp-items="@(ViewData["Customers"] as SelectList)" class="form-select">
                <option value="">زبون عابر / بدون عميل</option>
            </select>
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <label asp-for="PaymentMethod" class="form-label fw-bold text-muted small">طريقة الدفع</label>
            <div class="d-flex flex-wrap gap-1" id="payment-method-buttons">
                <div class="form-check payment-choice flex-fill m-0">
                    <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="Cash" id="pm-cash" />
                    <label class="form-check-label w-100 py-1 px-2 border rounded text-center small" for="pm-cash">نقدي</label>
                </div>
                <div class="form-check payment-choice flex-fill m-0">
                    <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="Card" id="pm-card" />
                    <label class="form-check-label w-100 py-1 px-2 border rounded text-center small" for="pm-card">بطاقة</label>
                </div>
                <div class="form-check payment-choice flex-fill m-0">
                    <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="Transfer" id="pm-transfer" />
                    <label class="form-check-label w-100 py-1 px-2 border rounded text-center small" for="pm-transfer">تحويل</label>
                </div>
                <div class="form-check payment-choice flex-fill m-0 mt-1 w-100">
                    <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="Credit" id="pm-credit" />
                    <label class="form-check-label w-100 py-1 px-2 border rounded text-center small" for="pm-credit">آجل (غير مدفوع)</label>
                </div>
            </div>
            <span asp-validation-for="PaymentMethod" class="text-danger small d-block mt-1"></span>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-6 d-none" id="bank-section">
            <label asp-for="BankId" class="form-label fw-bold text-muted small">المصرف (للتحويل)</label>
            <select asp-for="BankId" asp-items="@(ViewData["Banks"] as SelectList)" class="form-select">
                <option value="">اختر المصرف</option>
            </select>
            <span asp-validation-for="BankId" class="text-danger small"></span>
        </div>
    </div>

    <div class="mt-3">
        <label asp-for="Note" class="form-label"></label>
        <textarea asp-for="Note" class="form-control"></textarea>
        <span asp-validation-for="Note" class="text-danger"></span>
    </div>

    <h4 class="mt-4">@L["Lines"]</h4>
    <div class="table-responsive">
        <table class="table" id="lines-table">
            <thead>
                <tr>
                    <th>الصنف</th>
                    <th>الكمية</th>
                    <th>سعر الوحدة</th>
                    <th>إجمالي السطر</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @for (int i = 0; i < lineCount; i++)
            {
                <tr>
                    <td>
                        <select asp-for="Lines[i].ItemId" asp-items="@(ViewData["Items"] as SelectList)" class="form-select item-select">
                            <option value="">اختر الصنف...</option>
                        </select>
                        <span asp-validation-for="Lines[i].ItemId" class="text-danger"></span>
                    </td>
                    <td>
                        <input asp-for="Lines[i].Qty" class="form-control qty-input" type="number" step="1" min="1" inputmode="numeric" placeholder="0" />
                        <span asp-validation-for="Lines[i].Qty" class="text-danger"></span>
                    </td>
                    <td>
                        <input asp-for="Lines[i].UnitPriceEur" class="form-control price-input" type="number" step="0.01" min="0" placeholder="0.00" />
                        <span asp-validation-for="Lines[i].UnitPriceEur" class="text-danger"></span>
                    </td>
                    <td>
                        <input class="form-control line-total" type="text" value="0.00" readonly />
                    </td>
                    <td><button type="button" class="btn btn-danger remove-line">حذف</button></td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <button type="button" class="btn btn-secondary" id="add-line">إضافة سطر</button>
    <div class="card mt-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6"><strong>الإجمالي:</strong> <span id="live-total-eur">0.00</span></div>
                <div class="col-md-6"><strong>الصافي:</strong> <span id="live-total-secondary">0.00</span></div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
        <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-secondary">إلغاء</a>
    </div>
</form>

<template id="line-template">
    <td>
        <select name="Lines[__index__].ItemId" class="form-select item-select">
            <option value="">اختر الصنف...</option>
            @if (ViewData["Items"] is SelectList items)
            {
                foreach (var item in items)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            }
        </select>
    </td>
    <td><input name="Lines[__index__].Qty" class="form-control qty-input" type="number" step="1" min="1" inputmode="numeric" placeholder="0" /></td>
    <td><input name="Lines[__index__].UnitPriceEur" class="form-control price-input" type="number" step="0.01" min="0" placeholder="0.00" /></td>
    <td><input class="form-control line-total" type="text" value="0.00" readonly /></td>
    <td><button type="button" class="btn btn-danger remove-line">حذف</button></td>
</template>

<style>
    #payment-method-buttons .payment-choice {
        margin: 0;
    }

    #payment-method-buttons .payment-choice .form-check-input {
        display: none;
    }

    #payment-method-buttons .payment-choice .form-check-label {
        border: 1px solid #ced4da;
        border-radius: 0.6rem;
        padding: 0.65rem 1.1rem;
        font-weight: 600;
        cursor: pointer;
        user-select: none;
        min-width: 120px;
        text-align: center;
        background: #fff;
    }

    #payment-method-buttons .payment-choice .form-check-input:checked + .form-check-label {
        background: #0d6efd;
        border-color: #0d6efd;
        color: #fff;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/lines-table.js"></script>
    <script>
        (function forceTransferBankVisibility() {
            function refresh() {
                var selected = document.querySelector('input[name="PaymentMethod"]:checked');
                var bankSection = document.getElementById('bank-section');
                var bankInput = document.getElementById('BankId');
                if (!bankSection || !bankInput) return;

                var isTransfer = !!selected && String(selected.value).toLowerCase() === 'transfer';
                bankSection.classList.toggle('d-none', !isTransfer);
                bankInput.required = isTransfer;
                if (!isTransfer) bankInput.value = '';
            }

            document.addEventListener('change', function (event) {
                if (event.target && event.target.name === 'PaymentMethod') refresh();
            });

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', refresh);
            } else {
                refresh();
            }
        })();
    </script>
}
