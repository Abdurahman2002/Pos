@model IEnumerable<NewsApp2.Models.Entities.SalesInvoice>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@{
    ViewData["Title"] = "فواتير البيع";
    var canViewAllSalesInvoices = ViewBag.CanViewAllSalesInvoices as bool? ?? true;
    var salesScopeMessage = ViewBag.SalesScopeMessage as string;
    DateOnly? fromValue = ViewBag.From is DateOnly indexFrom ? indexFrom : null;
    DateOnly? toValue = ViewBag.To is DateOnly indexTo ? indexTo : null;
}

<h1>فواتير البيع</h1>
<p>
    <a class="btn btn-primary" asp-action="Create">فاتورة بيع جديدة</a>
    <a class="btn btn-outline-primary" asp-action="Drafts">الفواتير المعلقة</a>
    <a class="btn btn-outline-secondary" asp-action="Report">تقرير</a>
    <a class="btn btn-outline-dark" asp-action="SimpleDailyReport">تقرير المبيعات اليومي</a>
</p>

@if (!string.IsNullOrWhiteSpace(salesScopeMessage))
{
    <div class="alert alert-info">@salesScopeMessage</div>
}

<form method="get" class="row g-3 mb-3">
    <div class="col-md-3">
        <label class="form-label">@L["From"]</label>
        <input type="text" name="from" value="@(fromValue?.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture))" class="form-control date-input js-date" placeholder="dd/MM/yyyy" dir="ltr" lang="en-GB" autocomplete="off" />
    </div>
    <div class="col-md-3">
        <label class="form-label">@L["To"]</label>
        <input type="text" name="to" value="@(toValue?.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture))" class="form-control date-input js-date" placeholder="dd/MM/yyyy" dir="ltr" lang="en-GB" autocomplete="off" />
    </div>
    @if (canViewAllSalesInvoices)
    {
    <div class="col-md-4">
        <label class="form-label">@L["Customer"]</label>
        <select name="customerId" asp-items="@(ViewData["Customers"] as SelectList)" class="form-select">
            <option value="">@L["All customers"]</option>
        </select>
    </div>
    }
    <div class="col-md-2 align-self-end">
        <button type="submit" class="btn btn-primary w-100">تصفية</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@L["Number"]</th>
                <th>@L["Date"]</th>
                <th>العميل</th>
                <th>الحالة</th>
                <th>طريقة الدفع</th>
                <th>الإجمالي</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model)
        {
            var localizedStatus = string.IsNullOrWhiteSpace(row.Status) ? "-" : L[row.Status].Value;
            var paymentText = (row.PaymentMethod ?? string.Empty).Trim().ToLowerInvariant() switch
            {
                "card" => "بطاقة",
                "transfer" => "تحويل",
                "credit" => "آجل",
                _ => "نقدي"
            };
            var customerName = row.Customer?.Name;
            var shownCustomerName = string.Equals(customerName, "مبيعات يومية", StringComparison.Ordinal) ? "-" : (customerName ?? "-");
            <tr>
                <td>@row.Number</td>
                <td><span dir="ltr" style="direction:ltr; unicode-bidi:isolate; white-space:nowrap; font-variant-numeric:tabular-nums;">@row.InvoiceDate.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)</span></td>
                <td>@shownCustomerName</td>
                <td>@localizedStatus</td>
                <td>@paymentText</td>
                <td>@row.TotalDinar.ToString("0.00")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@row.Id">@L["Details"]</a>
                    <span> | </span><a asp-action="Receipt" asp-route-id="@row.Id" asp-route-autoPrint="false" target="_blank">طباعة</a>
                    <span> | </span><a asp-action="Pdf" asp-route-id="@row.Id" target="_blank">PDF</a>
                    @if ((User.IsInRole("Admin") || User.IsInRole("Prog")) && string.Equals(row.Status, "Posted", StringComparison.OrdinalIgnoreCase))
                    {
                        <span> | </span><a asp-action="Edit" asp-route-id="@row.Id">@L["Edit"]</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

