@model IEnumerable<NewsApp2.Models.Entities.Item>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2>@L["Items"]</h2>
    <form class="d-flex" method="get" asp-action="Index">
        <select name="categoryId" class="form-select me-2" asp-items="@(ViewData["Categories"] as SelectList)">
            <option value="">@L["All categories"]</option>
        </select>
        <input type="text" name="search" value="@ViewBag.Search" class="form-control me-2" placeholder="@L["Search by name or barcode"]" />
        <button class="btn btn-outline-primary" type="submit">@L["Search"]</button>
    </form>
    <a class="btn btn-primary" asp-action="Create">@L["Create New"]</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead class="table-light">
            <tr>
                <th>@L["Item"]</th>
                <th class="d-none d-md-table-cell">@L["Category"]</th>
                <th class="d-none d-lg-table-cell">@L["Reorder"]</th>
                <th class="d-none d-lg-table-cell">@L["Created"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.Barcode))
                    {
                        <span class="text-muted me-1 small">[<span dir="ltr">@item.Barcode</span>]</span>
                    }
                    @item.Name
                </td>
                <td class="d-none d-md-table-cell">@item.Category?.Name</td>
                <td class="d-none d-lg-table-cell">@(item.ReorderLevel.HasValue ? item.ReorderLevel.Value.ToString("0") : "-")</td>
                <td class="d-none d-lg-table-cell">@Html.DisplayFor(modelItem => item.CreatedDateLocalTime)</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.Id">@L["Details"]</a>
                    <a class="btn btn-sm btn-success" asp-action="PrintLabel" asp-route-id="@item.Id">@L["Label"]</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">@L["Edit"]</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">@L["Delete"]</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

