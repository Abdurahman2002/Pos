@model NewsApp2.Models.Entities.SalesInvoice
@using NewsApp2.Models.Entities
@{
    Layout = null;
    var lines = ViewBag.Lines as IEnumerable<SalesLine> ?? Enumerable.Empty<SalesLine>();
    var shopName = ViewBag.ShopName as string;
    var shopLogo = ViewBag.ShopLogo as string;
    var paymentText = (Model.PaymentMethod ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "card" => "بطاقة",
        "transfer" => "تحويل",
        "credit" => "آجل",
        _ => "نقدي"
    };
    var statusAr = string.Equals(Model.Status, "Posted", StringComparison.OrdinalIgnoreCase) ? "مرحلة"
                 : string.Equals(Model.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) ? "ملغاة"
                 : string.Equals(Model.Status, "PendingApproval", StringComparison.OrdinalIgnoreCase) ? "بانتظار الاعتماد"
                 : Model.Status;
    var customerName = string.Equals(Model.Customer?.Name, NewsApp2.Controllers.SalesInvoicesController.DailySalesCustomerName, StringComparison.Ordinal)
        ? "-"
        : (Model.Customer?.Name ?? "-");
    var lineTotalSum = lines.Sum(l => l.LineTotalDinar);
    var hasDiscount = Model.TotalDinar < lineTotalSum;
    var discountAmount = lineTotalSum - Model.TotalDinar;
    int rowNum = 0;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>فاتورة بيع - @Model.Number</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
            font-size: 13px;
            margin: 0;
            padding: 20px;
            color: #111;
            direction: rtl;
        }
        .invoice-page {
            width: 210mm;
            min-height: 297mm;
            max-width: 100%;
            margin: 0 auto;
            padding: 12mm;
            background: #fff;
        }
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid #333;
            padding-bottom: 10px;
            margin-bottom: 14px;
        }
        .header-logo img {
            max-height: 60px;
            max-width: 120px;
            object-fit: contain;
        }
        .header-title {
            text-align: center;
            flex: 1;
        }
        .header-title h1 {
            font-size: 20px;
            margin: 0 0 4px 0;
        }
        .header-title .shop-name {
            font-size: 15px;
            font-weight: bold;
            color: #444;
        }
        .header-num {
            text-align: left;
            font-size: 13px;
            color: #555;
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px 20px;
            margin-bottom: 16px;
            background: #f8f8f8;
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 10px 14px;
        }
        .info-item { display: flex; gap: 6px; }
        .info-label { font-weight: bold; white-space: nowrap; }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 14px;
        }
        thead th {
            background: #2c3e50;
            color: #fff;
            padding: 7px 8px;
            text-align: center;
            font-size: 12px;
        }
        thead th:first-child { text-align: right; }
        tbody tr:nth-child(even) { background: #f5f5f5; }
        tbody td {
            padding: 6px 8px;
            border-bottom: 1px solid #e0e0e0;
            text-align: center;
        }
        tbody td.name-col { text-align: right; }
        .totals-row {
            display: flex;
            justify-content: flex-end;
            gap: 20px;
            margin-bottom: 14px;
        }
        .total-box {
            background: #2c3e50;
            color: #fff;
            border-radius: 4px;
            padding: 8px 20px;
            text-align: center;
            min-width: 140px;
        }
        .total-box .t-label { font-size: 11px; opacity: 0.85; }
        .total-box .t-value { font-size: 17px; font-weight: bold; }
        .total-box.discount {
            background: #c0392b;
        }
        .note-box {
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 8px 12px;
            color: #555;
            margin-bottom: 14px;
        }
        .note-box span { font-weight: bold; color: #333; }
        .actions {
            text-align: center;
            margin-bottom: 10px;
        }
        .actions button {
            background: #2c3e50;
            color: #fff;
            border: none;
            padding: 8px 30px;
            font-size: 14px;
            border-radius: 4px;
            cursor: pointer;
            margin: 0 4px;
        }
        .actions a {
            background: #6c757d;
            color: #fff;
            border: none;
            padding: 8px 20px;
            font-size: 14px;
            border-radius: 4px;
            cursor: pointer;
            margin: 0 4px;
            text-decoration: none;
            display: inline-block;
        }
        .footer-note {
            text-align: center;
            font-size: 11px;
            color: #999;
            border-top: 1px solid #ddd;
            padding-top: 6px;
        }
        @@media print {
            @@page {
                size: A4 portrait;
                margin: 8mm;
            }
            .actions { display: none; }
            body {
                padding: 0;
                background: #fff;
            }
            .invoice-page {
                width: auto;
                min-height: auto;
                max-width: none;
                margin: 0;
                padding: 0;
            }
            thead {
                display: table-header-group;
            }
            tfoot {
                display: table-footer-group;
            }
            tr {
                break-inside: avoid;
                page-break-inside: avoid;
            }
            table {
                page-break-inside: auto;
            }
        }
    </style>
</head>
<body>
<main class="invoice-page">

    <div class="header">
        <div class="header-logo">
            @if (!string.IsNullOrWhiteSpace(shopLogo))
            {
                <img src="@Url.Content("~/upload/" + shopLogo)" alt="شعار المتجر" />
            }
        </div>
        <div class="header-title">
            @if (!string.IsNullOrWhiteSpace(shopName))
            {
                <div class="shop-name">@shopName</div>
            }
            <h1>فاتورة بيع</h1>
        </div>
        <div class="header-num">
            <div>رقم: <strong>@Model.Number</strong></div>
            <div>التاريخ: <strong>@Model.InvoiceDate.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)</strong></div>
        </div>
    </div>

    <div class="info-grid">
        <div class="info-item"><span class="info-label">العميل:</span> <span>@customerName</span></div>
        <div class="info-item"><span class="info-label">طريقة الدفع:</span> <span>@paymentText</span></div>
        <div class="info-item"><span class="info-label">الحالة:</span> <span>@statusAr</span></div>
        @if (!string.IsNullOrWhiteSpace(Model.CreatedByUserName))
        {
            <div class="info-item"><span class="info-label">البائع:</span> <span>@Model.CreatedByUserName</span></div>
        }
        @if (Model.SubmittedAt.HasValue)
        {
            <div class="info-item"><span class="info-label">وقت الترحيل:</span> <span>@Model.SubmittedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span></div>
        }
        @if (Model.ApprovedAt.HasValue)
        {
            <div class="info-item"><span class="info-label">وقت الاعتماد:</span> <span>@Model.ApprovedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span></div>
        }
    </div>

    <table>
        <thead>
            <tr>
                <th style="width:36px">#</th>
                <th class="name-col" style="text-align:right">اسم الصنف</th>
                <th>الكمية</th>
                <th>سعر الوحدة (د.ل)</th>
                <th>الإجمالي (د.ل)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in lines)
            {
                rowNum++;
                <tr>
                    <td>@rowNum</td>
                    <td class="name-col">@(line.Item?.Name ?? "-")</td>
                    <td>@line.Qty.ToString("0.##")</td>
                    <td>@line.UnitPriceEur.ToString("0.00")</td>
                    <td>@line.LineTotalDinar.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="totals-row">
        @if (hasDiscount)
        {
            <div class="total-box discount">
                <div class="t-label">الخصم</div>
                <div class="t-value">- @discountAmount.ToString("0.00") د.ل</div>
            </div>
        }
        <div class="total-box">
            <div class="t-label">الإجمالي</div>
            <div class="t-value">@Model.TotalDinar.ToString("0.00") د.ل</div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        <div class="note-box"><span>ملاحظة: </span>@Model.Note</div>
    }

    <div class="actions">
        <button onclick="window.print()">طباعة / حفظ PDF</button>
        <a href="javascript:history.back()">رجوع</a>
    </div>

    <div class="footer-note">
        تم إنشاء هذا المستند بواسطة النظام &mdash; @DateTime.Now.ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)
    </div>

</main>
</body>
</html>
