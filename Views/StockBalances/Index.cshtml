@model NewsApp2.ViewModels.Inventory.StockOverviewVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@{
    ViewData["Title"] = "المخزون";
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    Func<decimal, string> money = v => v.ToString("N2", culture);
    Func<decimal, string> qty = v => v.ToString("0.##", culture);
    var fin = Model.CanViewFinancials;
    var colCount = fin ? 11 : 6;
}

<partial name="Partial/_ReportPrint" />

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="m-0"><i class="mdi mdi-warehouse text-primary me-1"></i> المخزون</h2>
    <div class="d-flex flex-wrap gap-2 no-print">
        <a asp-action="ExportStockExcel" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-lowOnly="@Model.LowOnly" asp-route-lowThreshold="@Model.LowThreshold" class="btn btn-success">
            <i class="mdi mdi-file-excel me-1"></i> تصدير Excel
        </a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="mdi mdi-printer me-1"></i> طباعة</button>
        <a asp-action="DailyInventory" class="btn btn-outline-secondary"><i class="mdi mdi-calendar-check me-1"></i> الجرد اليومي</a>
        <a asp-action="Movement" class="btn btn-outline-secondary"><i class="mdi mdi-chart-line me-1"></i> حركة المخزون</a>
    </div>
</div>

<form method="get" asp-action="Index" class="card border-0 shadow-sm mb-3 no-print">
    <div class="card-body d-flex flex-wrap align-items-end gap-3">
        <div class="flex-grow-1" style="min-width: 220px;">
            <label class="form-label small fw-bold text-muted mb-1">بحث</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="mdi mdi-magnify text-muted"></i></span>
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="اسم الصنف أو الباركود..." autocomplete="off" />
            </div>
        </div>
        <div style="min-width: 200px;">
            <label class="form-label small fw-bold text-muted mb-1">التصنيف</label>
            <select name="categoryId" asp-items="@(ViewData["Categories"] as SelectList)" class="form-select form-select-sm">
                <option value="">كل التصنيفات</option>
            </select>
        </div>
        <div class="form-check mb-2">
            <input type="checkbox" class="form-check-input" id="lowOnly" name="lowOnly" value="true" @(Model.LowOnly ? "checked" : "") />
            <label class="form-check-label small" for="lowOnly">المنخفض فقط</label>
        </div>
        <div class="d-flex gap-2 ms-auto">
            <button type="submit" class="btn btn-primary btn-sm px-3"><i class="mdi mdi-filter-outline me-1"></i> تصفية</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3" title="إلغاء كل الفلاتر وعرض جميع الأصناف"><i class="mdi mdi-refresh me-1"></i> عرض الكل</a>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3 col-xl">
        <div class="card border-0 shadow-sm h-100"><div class="card-body py-2">
            <div class="text-muted small">عدد الأصناف</div>
            <div class="fs-5 fw-bold text-primary">@Model.TotalItems</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3 col-xl">
        <div class="card border-0 shadow-sm h-100"><div class="card-body py-2">
            <div class="text-muted small">إجمالي الكمية</div>
            <div class="fs-5 fw-bold"><span dir="ltr">@qty(Model.TotalQuantity)</span></div>
        </div></div>
    </div>
    @if (fin)
    {
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm h-100"><div class="card-body py-2">
                <div class="text-muted small">قيمة التكلفة</div>
                <div class="fs-6 fw-bold text-secondary"><span dir="ltr">@money(Model.TotalCostValueLyd)</span> د.ل</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm h-100"><div class="card-body py-2">
                <div class="text-muted small">قيمة البيع</div>
                <div class="fs-6 fw-bold text-info"><span dir="ltr">@money(Model.TotalSaleValueLyd)</span> د.ل</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm h-100"><div class="card-body py-2">
                <div class="text-muted small">الربح المتوقع</div>
                <div class="fs-6 fw-bold text-success"><span dir="ltr">@money(Model.TotalExpectedProfitLyd)</span> د.ل</div>
            </div></div>
        </div>
    }
    <div class="col-6 col-md-3 col-xl">
        <div class="card border-0 shadow-sm h-100"><div class="card-body py-2">
            <div class="text-muted small">تحت حد الطلب</div>
            <div class="fs-5 fw-bold text-warning">@Model.LowCount <span class="small text-danger">(نافد: @Model.OutOfStockCount)</span></div>
        </div></div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>التصنيف</th>
                        <th>الصنف</th>
                        <th>الباركود</th>
                        <th class="text-end">الكمية</th>
                        <th class="text-end">إعادة الطلب</th>
                        @if (fin)
                        {
                            <th class="text-end">متوسط التكلفة</th>
                            <th class="text-end">سعر البيع</th>
                            <th class="text-end">قيمة التكلفة</th>
                            <th class="text-end">قيمة البيع</th>
                            <th class="text-end">الربح المتوقع</th>
                        }
                        <th class="text-center">الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="@colCount" class="text-center text-muted py-4">لا توجد أصناف مطابقة.</td></tr>
                    }
                    @foreach (var row in Model.Rows)
                    {
                        var badge = row.Status == "نفذ" ? "bg-dark" : (row.Status == "منخفض" ? "bg-danger" : "bg-success");
                        <tr>
                            <td><span class="badge bg-light text-dark border">@(row.CategoryName ?? "-")</span></td>
                            <td class="fw-semibold">
                                <a asp-action="ItemCard" asp-route-id="@row.ItemId" class="text-decoration-none">@row.ItemName</a>
                            </td>
                            <td class="small text-muted" dir="ltr">@(string.IsNullOrWhiteSpace(row.Barcode) ? "-" : row.Barcode)</td>
                            <td class="text-end fw-bold"><span dir="ltr">@qty(row.QuantityOnHand)</span></td>
                            <td class="text-end text-muted"><span dir="ltr">@(row.ReorderLevel > 0 ? qty(row.ReorderLevel) : "-")</span></td>
                            @if (fin)
                            {
                                <td class="text-end"><span dir="ltr">@money(row.AverageCostLyd)</span></td>
                                <td class="text-end"><span dir="ltr">@(row.DefaultSalePriceLyd.HasValue ? money(row.DefaultSalePriceLyd.Value) : "-")</span></td>
                                <td class="text-end fw-semibold"><span dir="ltr">@money(row.CostValueLyd)</span></td>
                                <td class="text-end fw-semibold"><span dir="ltr">@money(row.SaleValueLyd)</span></td>
                                <td class="text-end fw-bold text-success"><span dir="ltr">@(row.DefaultSalePriceLyd.HasValue ? money(row.ExpectedProfitLyd) : "-")</span></td>
                            }
                            <td class="text-center"><span class="badge @badge">@row.Status</span></td>
                        </tr>
                    }
                </tbody>
                @if (fin && Model.Rows.Any())
                {
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="3" class="text-end">إجمالي الصفحة</td>
                            <td class="text-end"><span dir="ltr">@qty(Model.Rows.Sum(r => r.QuantityOnHand))</span></td>
                            <td></td>
                            <td colspan="2"></td>
                            <td class="text-end"><span dir="ltr">@money(Model.Rows.Sum(r => r.CostValueLyd))</span></td>
                            <td class="text-end"><span dir="ltr">@money(Model.Rows.Sum(r => r.SaleValueLyd))</span></td>
                            <td class="text-end text-success"><span dir="ltr">@money(Model.Rows.Sum(r => r.ExpectedProfitLyd))</span></td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

<partial name="Partial/_Pagination" model="Model.Pagination" />
