
@*هذا رابط التمبلت*@
@* startbootstrap-grayscale-gh-pages *@


@inject IUnitOfWork<SiteInfo> _siteInfo
@inject IUnitOfWork<Contact> _contact
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@using System.Globalization


<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta name="viewport" content="width=device-width" />
    @* --------------------------------------------------------------- *@
    @{
        var siteInfo = _siteInfo.Repository.GetAll().SingleOrDefault();
        ViewBag.SiteName = @siteInfo?.Name;
        ViewBag.LogoUrl = @siteInfo?.LogoUrl;
        ViewBag.Activity = @siteInfo?.Activity;
        ViewBag.CoverImageUrl = @siteInfo?.CoverImageUrl;
        var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    }
    <partial name="Partial/_title"></partial>
    @* --------------------------------------------------------------- *@



    @if (isRtl)
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    }
    else
    {
        <environment include="Development">
            <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
        </environment>
        <environment include="Staging,Production">
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        </environment>
    }
    <environment include="Development">
        <link href="~/css/owl.carousel.min.css" rel="stylesheet" />
    </environment>
    <environment include="Staging,Production">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" integrity="sha512-tS3S5qG0BlhnQROyJXvNjeEM4UpMXHrQfTGmbQ1gKmelCxlSEBUaxhRBj/EFTzpbP4RVSrpEikbmdJobCvhE3g==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    </environment>



    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    @*------------------------news template------------------------------------------------------------*@
    <link href="~/css/newscarousel.css" rel="stylesheet" />
    @*------------------------main template-------------------------------------------------------------*@
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="~/css/template.css" rel="stylesheet" />
    @*---------------------------------------------------------------------------------------------------*@
    <link href="~/css/site1.css" rel="stylesheet" />
    <link href="~/css/date-inputs.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet" />
    @if (isRtl)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
        <link href="~/css/rtl-support.css" rel="stylesheet" />
        <style>
            body { font-family: 'Cairo', sans-serif; }
        </style>
    }
   
</head>
<body>
    <header>
        <!-- Navigation-->
        <nav class="navbar navbar-expand-lg navbar-light fixed-top" id="mainNav">
            <div class="container px-4 px-lg-5">
                @*  <a class="navbar-brand" href="#page-top">Start Bootstrap</a> *@
                @* --------------------------------- *@
                <partial name="Partial/_navbrand"></partial>
                @* ---------------------------------*@
                <button class="navbar-toggler navbar-toggler-right" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
                    @L["Menu"]
                    <i class="fas fa-bars"></i>
                </button>
                <div class="collapse navbar-collapse" id="navbarResponsive">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" href="#signup">@L["Contact"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-action="About" asp-controller="Home" target="_blank">@L["About"]</a></li>
                        @{
                             // <li class="nav-item"><a class="nav-link" asp-action="Index" asp-controller="Admin">Dashboard</a></li>
                             // <li><a class="nav-link" asp-action="Register" asp-controller="Account">Register</a></li>
                             // <li><a class="nav-link" asp-action="Login" asp-controller="Account">@L["Login"]</a></li>
                        }
                    </ul>
                    <div class="ms-3 me-2">
                        <partial name="Partial/_LanguageSwitcher"></partial>
                    </div>
                    @* --------------------------------- *@
                    <partial name="Partial/_navUser"></partial>
                    @* --------------------------------- *@
                </div>
            </div>
        </nav>
        @* --------------------------------- *@
        <partial name="Partial/_coverImg"></partial>
        @* ---------------------------------*@
        <!-- Masthead-->
        <div class="masthead">
            <div class="container px-4 px-lg-5 d-flex align-items-center justify-content-center">
                <div class="d-flex justify-content-center">
                    <div class="text-center">
                        <h1 class="mx-auto my-0 text-uppercase">@ViewBag.SiteName</h1>
                        <h2 class="text-white-50 mx-auto mt-2 mb-5">@ViewBag.Activity</h2>
                        <a class="btn btn-primary" href="#body">@L["GetStarted"]</a>
                        
                    </div>
                </div>
            </div>
        </div>
    </header>
    <div id="body" class="bodycolre">
        @RenderBody()
    </div>
    <!-- Signup-->
    <section class="signup-section" id="signup">
        <div class="container ">
            <div class="row d-flex justify-content-center mb-5">
                <div class="col-md-6 text-center">
                    <div class="col text-center mb-5 text-black-50">
                        <h2><b>@L["ContactUs"]</b></h2>
                    </div>
                    <form asp-action="Contact" asp-controller="Home">
                        <div class="form-group">
                            <input class="form-control" name="contactName" placeholder="@L["FullName"]" required />
                        </div>
                        <div class="form-group">
                            <input class="form-control" name="contactEmail" placeholder="@L["Email"]" required />
                        </div>
                        <div class="form-group">
                            <textarea class="form-control" name="contactMessage" placeholder="@L["Message"]" required></textarea>
                        </div>

                        <div class="form-group ">
                            <button type="submit" class="btn btn-primary fs-6 w-100">
                                <i class="bi bi-send me-3"></i><b>@L["Send"]</b>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact-->
    <footer class="footer  bg-black text-center text-white-50 pb-5">
        <div class="px-4 px-lg-5">
            <div class="contact-section position-relative align-content-center">
                <div class="social d-flex top-0  end-0">
                    @{
                        var contact = _contact.Repository.GetAll().SingleOrDefault();
                        if (contact != null)
                        {
                            <a class="mx-2" href="@contact.Twitter"><i class="fab fa-twitter"></i></a>
                            <a class="mx-2" href="@contact.Facebook"><i class="fab fa-facebook-f"></i></a>
                            <a class="mx-2" href="@contact.Instagram"><i class="bi bi-instagram"></i></a>
                        }
                    }
                </div>
                <span class="">@L["Copyright"] &copy; @ViewBag.SiteName @DateTime.Now.Year</span>
            </div>
        </div>
    </footer>



    <environment include="Development">
        <script src="~/lib/jquery/jquery.min.js"></script>
        <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
        @*---------------------news template-------------------------------------------------*@
        <script src="~/js/owl.carousel.min.js"></script>
        @*-----------------------------------------------------------------------------------*@
    </environment>
    <environment include="Staging,Production">
        <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        @*---------------------news template-------------------------------------------------*@
        <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js" integrity="sha512-bPs7Ae6pVvhOSiIcyUClR7/q2OAsRiovw4vAkX+zJbw3ShAeeqezq50RIIcIURq7Oa20rW2n2q+fyXBNcU9lrw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
        @*-----------------------------------------------------------------------------------*@
    </environment>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ar.js"></script>
    <script src="~/js/date-picker.js"></script>

    @*---------------------main template----------------------------------------------------*@
    <script src="~/js/template.js"></script>
    @*--------------------------------------------------------------------------------------*@

    @*---------------------news template----------------------------------------------------*@
    @* carousel1 *@
    <script src="~/js/main.js"></script>
    @* carouse2 *@
    <script src="~/js/main1.js"></script>
    @*--------------------------------------------------------------------------------------*@

    @RenderSection("Scripts", required: false)

    
    @* ------------partial-------------- *@
    <partial name="Partial/_toast"></partial>
    @* --------------------------------- *@
</body>
</html>

