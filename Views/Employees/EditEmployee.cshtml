@model Employee

@{
    ViewData["Title"] = "Edit Employee";
}

<style>
    .section-title {
        font-weight: 600;
        color: #495057;
        margin-top: 30px;
        margin-bottom: 15px;
        border-left: 4px solid #0d6efd;
        padding-left: 10px;
    }
</style>

<div class="container pt-4" style="min-height:75vh">

    <h3 class="fw-bold mb-4">Edit Employee</h3>

    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-lg-5">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    @if (Model.ApplicationUser == null)
                    {
                        <div class="alert alert-secondary rounded-3 mb-4">
                            <div class="fw-semibold">Worker without system login</div>
                            <small>This employee can receive salary payments, advances and deductions without accessing the system.</small>
                        </div>
                    }
                    else
                    {
                        <!-- User Card -->
                        <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded-3">
                            <div>
                                <div class="fw-semibold">User Account</div>
                                <small class="text-muted">@Model.ApplicationUser.Email</small>
                            </div>

                            @if (User.IsInRole("Prog"))
                            {
                                <a asp-action="EditUser"
                                   asp-controller="Users"
                                   asp-route-id="@Model.ApplicationUser.Id"
                                   class="btn btn-outline-secondary">
                                    <i class="bi bi-person"></i> Manage Roles
                                </a>
                            }

                        </div>

                        <form method="post" class="mb-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@Model.ApplicationUser.Id" />
                            <div class="alert @(Model.ApplicationUser.EmailConfirmed ? "alert-success" : "alert-warning") rounded-3 mb-0">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <div>
                                        <b>Email Status:</b>
                                        @(Model.ApplicationUser.EmailConfirmed ? "Confirmed" : "Not confirmed")
                                    </div>
                                    @if (!Model.ApplicationUser.EmailConfirmed)
                                    {
                                        <div class="d-flex gap-2">
                                            <button type="submit" asp-action="ConfirmEmployeeEmail" class="btn btn-success btn-sm">
                                                Confirm Email
                                            </button>
                                            <button type="submit" asp-action="SendEmployeeConfirmationLink" class="btn btn-outline-secondary btn-sm">
                                                Send Confirmation Link
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </form>

                        <form method="post" class="mb-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@Model.ApplicationUser.Id" />
                            @if (Model.ApplicationUser.LockoutEnd.HasValue && Model.ApplicationUser.LockoutEnd.Value > DateTimeOffset.UtcNow)
                            {
                                <div class="alert alert-danger rounded-3 mb-0">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div>
                                            <b>Account Status:</b> Locked
                                            <div class="small">Until @Model.ApplicationUser.LockoutEndLocal</div>
                                        </div>
                                        <button type="submit" asp-action="LockoutEmployee" class="btn btn-success btn-sm">
                                            Unlock
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success rounded-3 mb-0">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div>
                                            <b>Account Status:</b> Active
                                        </div>
                                        <button type="submit" asp-action="LockoutEmployee" class="btn btn-warning btn-sm">
                                            Lock
                                        </button>
                                    </div>
                                </div>
                            }
                        </form>
                    }

                    <form asp-action="EditEmployee">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="section-title">Employee Information</div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-semibold"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="BaseSalaryLyd" class="form-label fw-semibold">الراتب الأساسي</label>
                                <div class="input-group">
                                    <input asp-for="BaseSalaryLyd" class="form-control" type="number" step="0.01" min="0" />
                                    <span class="input-group-text">د.ل</span>
                                </div>
                                <span asp-validation-for="BaseSalaryLyd" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="section-title">Access Status</div>

                        <div class="alert alert-secondary rounded-3">
                            <div class="row">
                                <div class="col-md-6">
                                    <b>Account Approval:</b><br />
                                    @(Model.ApplicationUser == null ? "No login account" : (Model.ApplicationUser.Approval == true ? "Approved" : "Pending"))
                                </div>
                                <div class="col-md-6">
                                    <b>Role Management:</b><br />
                                    Use <b>Manage Roles</b> for exact role assignment.
                                </div>
                            </div>
                        </div>

                        <div class="section-title">System Information</div>

                        <div class="alert alert-info rounded-3">
                            <div class="row">
                                <div class="col-md-6">
                                    <b>@Html.DisplayNameFor(m => m.Created):</b><br />
                                    @Html.DisplayFor(m => m.CreatedDateLocalTime)
                                    @Html.HiddenFor(m => m.Created)
                                </div>
                                <div class="col-md-6">
                                    <b>@Html.DisplayNameFor(m => m.Modified):</b><br />
                                    @Html.DisplayFor(m => m.ModifiedDateLocalTime)
                                </div>
                            </div>
                        </div>

                        <input type="hidden" asp-for="UserId" />

                        <div class="mt-4 pt-3 border-top">
                            <div class="row">
                                <div class="col-md-3 mb-2 mb-md-0">
                                    <button type="submit" class="btn btn-primary w-100">
                                        Update
                                    </button>
                                </div>

                                <div class="col-md-3 mb-2 mb-md-0">
                                    @if (Model.ApplicationUser == null)
                                    {
                                        <span class="btn btn-outline-secondary disabled w-100">
                                            No Login
                                        </span>
                                    }
                                    else if (Model.ApplicationUser.Approval == false)
                                    {
                                        <a asp-action="Approve"
                                           asp-route-id="@Model.Id"
                                           class="btn btn-success w-100">
                                            Review & Approve
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="ChangeEmployeeApproval"
                                           asp-route-userId="@Model.UserId"
                                           class="btn btn-warning w-100">
                                            Return To Pending
                                        </a>
                                    }
                                </div>

                                <div class="col-md-3 mb-2 mb-md-0">
                                    <button type="button" class="btn btn-danger w-100" data-bs-toggle="modal" data-bs-target="#DeleteEmployeeModal">
                                        Delete
                                    </button>
                                </div>

                                <div class="col-md-3">
                                    <a asp-action="Index" class="btn btn-outline-primary w-100">
                                        Employees List
                                    </a>
                                </div>
                            </div>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

<form method="post">
    @Html.AntiForgeryToken()
    <div class="modal fade" id="DeleteEmployeeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Employee</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this employee? This will also delete the user account.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" asp-action="DeleteEmployee" asp-route-id="@Model.Id" class="btn btn-danger">Delete</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

