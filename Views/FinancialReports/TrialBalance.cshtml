@model NewsApp2.ViewModels.Financial.TrialBalanceReportVM
@{
    ViewData["Title"] = "ميزان المراجعة";
}

<partial name="Partial/_ReportPrint" />

<h1>ميزان المراجعة</h1>

<form method="get" class="row g-2 mb-3 no-print">
    <div class="col-md-3">
        <label class="form-label">من</label>
        <input type="text" name="from" value="@Model.From.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)" class="form-control date-input js-date" placeholder="dd/MM/yyyy" dir="ltr" lang="en-GB" autocomplete="off" />
    </div>
    <div class="col-md-3">
        <label class="form-label">إلى</label>
        <input type="text" name="to" value="@Model.To.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)" class="form-control date-input js-date" placeholder="dd/MM/yyyy" dir="ltr" lang="en-GB" autocomplete="off" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">عرض</button>
    </div>
</form>

<div class="mb-3 no-print">
    <a asp-action="ExportTrialBalanceExcel"
    asp-route-from="@Model.From.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)"
    asp-route-to="@Model.To.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)"
       class="btn btn-success">
        تصدير Excel
    </a>
    <button type="button" class="btn btn-outline-secondary no-print" onclick="window.print()"><i class="mdi mdi-printer me-1"></i> طباعة</button>
</div>

<div class="row mb-3">
    <div class="col-md-3">
        <div class="alert alert-info mb-0">إجمالي مدين: <strong>@Model.TotalDebit.ToString("0.00")</strong></div>
    </div>
    <div class="col-md-3">
        <div class="alert alert-info mb-0">إجمالي دائن: <strong>@Model.TotalCredit.ToString("0.00")</strong></div>
    </div>
    <div class="col-md-3">
        <div class="alert @(Model.TotalNetDebit == Model.TotalNetCredit ? "alert-success" : "alert-warning") mb-0">
            صافي التوازن: <strong>@Math.Abs(Model.TotalNetDebit - Model.TotalNetCredit).ToString("0.00")</strong>
        </div>
    </div>
</div>

<table class="table table-striped table-sm table-hover">
    <thead>
        <tr>
            <th>رمز الحساب</th>
            <th>اسم الحساب</th>
            <th>إجمالي مدين</th>
            <th>إجمالي دائن</th>
            <th>رصيد مدين</th>
            <th>رصيد دائن</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.AccountCode</td>
                <td>@row.AccountName</td>
                <td>@row.Debit.ToString("0.00")</td>
                <td>@row.Credit.ToString("0.00")</td>
                <td>@row.NetDebit.ToString("0.00")</td>
                <td>@row.NetCredit.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>
