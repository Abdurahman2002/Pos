@model NewsApp2.ViewModels.Customers.CustomerReceiptEditVM

@{
    ViewData["Title"] = "تعديل التحصيل";
}

<h2 class="mb-3">تعديل التحصيل</h2>

<form asp-action="EditPayment" method="post" class="card border-0 shadow-sm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReceiptId" />
    <input type="hidden" asp-for="CustomerId" />
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">العميل</label>
                <input class="form-control" value="@Model.CustomerName" disabled />
            </div>
            <div class="col-md-3">
                <label asp-for="ReceiptDate" class="form-label">التاريخ</label>
                <input asp-for="ReceiptDate" type="text" class="form-control" asp-format="{0:dd/MM/yyyy}" placeholder="dd/MM/yyyy" />
            </div>
            <div class="col-md-3">
                <label asp-for="Amount" class="form-label">المبلغ</label>
                <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="PaymentMethod" class="form-label">الطريقة</label>
                <select asp-for="PaymentMethod" class="form-select">
                    <option value="Cash">نقدي</option>
                    <option value="Card">بطاقة</option>
                    <option value="Transfer">تحويل</option>
                </select>
            </div>
            <div class="col-md-12">
                <label asp-for="Note" class="form-label">ملاحظة</label>
                <input asp-for="Note" class="form-control" maxlength="500" />
            </div>
        </div>
    </div>
    <div class="card-footer d-flex gap-2 justify-content-end">
        <a class="btn btn-secondary" asp-action="Statement" asp-route-id="@Model.CustomerId">رجوع</a>
        <button class="btn btn-primary" type="submit">حفظ التعديل</button>
    </div>
</form>
