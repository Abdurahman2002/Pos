@model NewsApp2.ViewModels.Expenses.EmployeeExpenseSummaryVM
@{
    ViewData["Title"] = "تقرير حركة الموظفين (مرتبات وسلف)";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">@ViewData["Title"]</h2>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">طباعة</button>
        <a class="btn btn-outline-primary" asp-action="Index">الرجوع للمصروفات</a>
    </div>
</div>

<div class="card shadow-sm mb-3 print-hidden">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">من</label>
                <input type="date" class="form-control" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label">إلى</label>
                <input type="date" class="form-control" name="to" value="@Model.To.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="form-label">الموظف</label>
                <select name="employeeId" class="form-select" asp-items="ViewBag.Employees">
                    <option value="">كل الموظفين</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button class="btn btn-primary" type="submit">تصفية</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-bottom border-4 border-primary">
            <div class="card-body text-center">
                <div class="text-muted small">إجمالي المرتبات</div>
                <div class="fw-bold fs-5 text-primary">@Model.TotalSalaries.ToString("N2") د.ل</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-bottom border-4 border-warning">
            <div class="card-body text-center">
                <div class="text-muted small">إجمالي السلف</div>
                <div class="fw-bold fs-5 text-warning">@Model.TotalAdvances.ToString("N2") د.ل</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-bottom border-4 border-info">
            <div class="card-body text-center">
                <div class="text-muted small">إجمالي التسويات</div>
                <div class="fw-bold fs-5 text-info">@Model.TotalSettlements.ToString("N2") د.ل</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-bottom border-4 @(Model.TotalNetDue >= 0 ? "border-success" : "border-danger")">
            <div class="card-body text-center">
                <div class="text-muted small">صافي المستحق</div>
                <div class="fw-bold fs-5 @(Model.TotalNetDue >= 0 ? "text-success" : "text-danger")">@Model.TotalNetDue.ToString("N2") د.ل</div>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-light border d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted">إجمالي رصيد السلف المتبقي على الموظفين</span>
    <span class="fw-bold">@Model.TotalOutstandingAdvances.ToString("N2") د.ل</span>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>الموظف</th>
                <th class="text-end">إجمالي المرتبات</th>
                <th class="text-end">إجمالي السلف</th>
                <th class="text-end">إجمالي التسويات</th>
                <th class="text-end">رصيد السلف المتبقي</th>
                <th class="text-end">صافي المستحق</th>
                <th>آخر حركة</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Rows.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">لا توجد حركات مرتبات/سلف في الفترة المحددة.</td>
            </tr>
        }
        else
        {
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td class="fw-semibold">@row.EmployeeName</td>
                    <td class="text-end">@row.SalariesTotal.ToString("N2")</td>
                    <td class="text-end">@row.AdvancesTotal.ToString("N2")</td>
                    <td class="text-end">@row.SettlementsTotal.ToString("N2")</td>
                    <td class="text-end fw-semibold">@row.OutstandingAdvanceBalance.ToString("N2")</td>
                    <td class="text-end fw-bold @(row.NetDue >= 0 ? "text-success" : "text-danger")">@row.NetDue.ToString("N2")</td>
                    <td>@(row.LastMovementDate.HasValue ? row.LastMovementDate.Value.ToString("dd/MM/yyyy") : "-")</td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

<style>
@@media print {
    .print-hidden {
        display: none !important;
    }
}
</style>
