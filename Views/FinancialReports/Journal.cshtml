@model NewsApp2.ViewModels.Financial.JournalReportVM
@{
    ViewData["Title"] = "دفتر القيود";
}

<h1>دفتر القيود</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <label class="form-label">من</label>
        <input type="text" name="from" value="@Model.From.ToString("dd/MM/yyyy")" class="form-control" placeholder="dd/MM/yyyy" />
    </div>
    <div class="col-md-2">
        <label class="form-label">إلى</label>
        <input type="text" name="to" value="@Model.To.ToString("dd/MM/yyyy")" class="form-control" placeholder="dd/MM/yyyy" />
    </div>
    <div class="col-md-2">
        <label class="form-label">الحساب</label>
        <select name="accountCode" class="form-select">
            <option value="">الكل</option>
            @foreach (var code in Model.AccountCodes)
            {
                if (string.Equals(Model.AccountCode, code, StringComparison.Ordinal))
                {
                    <option value="@code" selected>@code</option>
                }
                else
                {
                    <option value="@code">@code</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">المصدر</label>
        <select name="sourceType" class="form-select">
            <option value="">الكل</option>
            @foreach (var source in Model.SourceTypes)
            {
                if (string.Equals(Model.SourceType, source, StringComparison.Ordinal))
                {
                    <option value="@source" selected>@source</option>
                }
                else
                {
                    <option value="@source">@source</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">بحث</label>
        <input name="search" value="@Model.Search" class="form-control" placeholder="مستند / بيان / مستخدم" />
    </div>
    <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">عرض</button>
    </div>
</form>

<div class="mb-3">
    <a asp-action="ExportJournalExcel"
    asp-route-from="@Model.From.ToString("dd/MM/yyyy")"
    asp-route-to="@Model.To.ToString("dd/MM/yyyy")"
       asp-route-accountCode="@Model.AccountCode"
       asp-route-sourceType="@Model.SourceType"
       asp-route-search="@Model.Search"
       class="btn btn-success">
        تصدير Excel
    </a>
</div>

<div class="row mb-3">
    <div class="col-md-3">
        <div class="alert alert-info mb-0">إجمالي مدين: <strong>@Model.TotalDebit.ToString("0.00")</strong></div>
    </div>
    <div class="col-md-3">
        <div class="alert alert-info mb-0">إجمالي دائن: <strong>@Model.TotalCredit.ToString("0.00")</strong></div>
    </div>
    <div class="col-md-3">
        <div class="alert @(Model.TotalDebit == Model.TotalCredit ? "alert-success" : "alert-warning") mb-0">
            الفرق: <strong>@Math.Abs(Model.TotalDebit - Model.TotalCredit).ToString("0.00")</strong>
        </div>
    </div>
</div>

<table class="table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th>التاريخ</th>
            <th>المصدر</th>
            <th>المستند</th>
            <th>رمز الحساب</th>
            <th>اسم الحساب</th>
            <th>مدين</th>
            <th>دائن</th>
            <th>البيان</th>
            <th>المستخدم</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.EntryDate.ToString("dd/MM/yyyy")</td>
                <td>@row.SourceType</td>
                <td>@row.DocumentNo</td>
                <td>@row.AccountCode</td>
                <td>@row.AccountName</td>
                <td>@row.Debit.ToString("0.00")</td>
                <td>@row.Credit.ToString("0.00")</td>
                <td>@row.Note</td>
                <td>@row.CreatedByUserName</td>
            </tr>
        }
    </tbody>
</table>
