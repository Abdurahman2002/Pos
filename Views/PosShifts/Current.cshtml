@model NewsApp2.ViewModels.Pos.PosShiftCurrentVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@{
    ViewData["Title"] = "نظام الورديات";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="m-0">@L["نظام الورديات"]</h2>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">سجل الورديات</a>
        @if (ViewBag.LatestClosedShiftId is Guid latestClosedShiftId)
        {
            <a asp-action="Report" asp-route-id="@latestClosedShiftId" class="btn btn-outline-secondary">تقرير آخر وردية</a>
        }
        <a asp-action="CashierPerformance" class="btn btn-outline-secondary">أداء الكاشير</a>
        <a asp-controller="SalesInvoices" asp-action="Create" class="btn btn-outline-primary">العودة لنقطة البيع</a>
    </div>
</div>

@if (Model.ActiveShift == null)
{
    <div class="card border-success-subtle">
        <div class="card-body">
            <h5 class="mb-3">فتح وردية جديدة</h5>
            <form asp-action="Open" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="col-md-4">
                    <label asp-for="OpeningCashLyd" class="form-label">رصيد بداية الوردية (دينار)</label>
                    <input asp-for="OpeningCashLyd" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="OpeningCashLyd" class="text-danger"></span>
                    <small class="text-muted d-block mt-1">يمكن تركها 0 إذا لا يوجد رصيد افتتاحي.</small>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-success">فتح الوردية</button>
                    <button type="submit" formaction="@Url.Action("OpenQuick", "PosShifts")" class="btn btn-outline-success ms-2">فتح سريع (0 دينار)</button>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="card mb-3 border-primary-subtle">
        <div class="card-body row g-3">
            <div class="col-md-3"><strong>فتح بواسطة:</strong> @Model.ActiveShift.OpenedByUserName</div>
            <div class="col-md-3"><strong>وقت الفتح:</strong> @Model.ActiveShift.OpenedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)</div>
            <div class="col-md-3"><strong>رصيد البداية:</strong> @Model.ActiveShift.OpeningCashLyd.ToString("0.00") دينار</div>
            <div class="col-md-3"><strong>الحالة:</strong> <span class="badge bg-success">مفتوحة</span></div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body row g-3">
            <div class="col-md-6"><strong>عدد الفواتير:</strong> @Model.SalesCount</div>
            <div class="col-md-6"><strong>إجمالي المبيعات:</strong> @Model.SalesTotalLyd.ToString("0.00") دينار</div>
            <div class="col-md-3"><strong>مبيعات نقدي:</strong> @Model.CashSalesLyd.ToString("0.00")</div>
            <div class="col-md-3"><strong>مبيعات بطاقة:</strong> @Model.CardSalesLyd.ToString("0.00")</div>
            <div class="col-md-3"><strong>مبيعات تحويل:</strong> @Model.TransferSalesLyd.ToString("0.00")</div>
            <div class="col-md-3"><strong>مبيعات آجلة:</strong> @Model.CreditSalesLyd.ToString("0.00")</div>
            @if (Model.TransferSalesByBank.Any())
            {
                <div class="col-12">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>المصرف</th>
                                    <th class="text-center">عدد الفواتير</th>
                                    <th class="text-end">الإجمالي</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bank in Model.TransferSalesByBank)
                                {
                                    <tr>
                                        <td>@bank.BankName</td>
                                        <td class="text-center">@bank.InvoiceCount</td>
                                        <td class="text-end">@bank.TotalLyd.ToString("0.00")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            <div class="col-md-3"><strong>تحصيلات نقدية:</strong> @Model.CashReceiptsLyd.ToString("0.00")</div>
            <div class="col-md-3"><strong>مصروفات/سلف نقدية:</strong> <span class="text-danger">@Model.CashExpensesLyd.ToString("0.00")</span></div>
            <div class="col-12">
                <div class="p-2 rounded bg-light border d-inline-block">
                    <strong>النقد المتوقع:</strong>
                    <span class="fs-4 fw-bold text-primary">@Model.ExpectedCashLyd.ToString("0.00")</span> دينار
                </div>
            </div>
            <div class="col-12"><small class="text-muted">النقد المتوقع = رصيد البداية + مبيعات النقدي + التحصيلات النقدية − المصروفات/السلف النقدية. يُحتسب الفرق تلقائياً عند إدخال النقد المعدود في خانة الإغلاق أدناه.</small></div>
        </div>
    </div>

    <div class="card border-danger-subtle">
        <div class="card-body">
            <h5 class="mb-3">إغلاق الوردية</h5>
            <form asp-action="Close" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label asp-for="ClosingCashLyd" class="form-label">النقد عند الإغلاق (دينار)</label>
                    <input asp-for="ClosingCashLyd" class="form-control" type="number" step="0.01" min="0"
                           id="closing-cash-input"
                           data-expected="@Model.ExpectedCashLyd.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                    <span asp-validation-for="ClosingCashLyd" class="text-danger"></span>
                </div>
                <div class="col-md-5 align-self-center">
                    <div class="p-2 rounded border bg-white">
                        <strong>الفرق:</strong> <span id="close-diff-val" class="fw-bold">— أدخل النقد المعدود</span>
                    </div>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-danger" onclick="return confirm('هل تريد إغلاق الوردية الحالية الآن؟');">إغلاق الوردية</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var input = document.getElementById('closing-cash-input');
            var out = document.getElementById('close-diff-val');
            if (!input || !out) return;
            var expected = parseFloat(input.getAttribute('data-expected')) || 0;
            function fmt(n) { return n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
            function update() {
                var raw = input.value;
                if (raw === '' || raw === null || isNaN(parseFloat(raw))) {
                    out.textContent = '— أدخل النقد المعدود';
                    out.className = 'fw-bold text-muted';
                    return;
                }
                var diff = Math.round((parseFloat(raw) - expected) * 100) / 100;
                var label = diff === 0 ? ' (مطابق)' : (diff > 0 ? ' (زيادة)' : ' (عجز)');
                out.textContent = (diff > 0 ? '+' : '') + fmt(diff) + ' دينار' + label;
                out.className = 'fw-bold ' + (diff === 0 ? 'text-success' : (diff > 0 ? 'text-warning' : 'text-danger'));
            }
            input.addEventListener('input', update);
            update();
        })();
    </script>
}
