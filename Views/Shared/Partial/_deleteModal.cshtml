@model Guid?
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L


<div class="modal fade" id="DeleteModal" tabindex="-1" aria-labelledby="DeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DeleteModalLabel">@L["Delete Item"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
            </div>
            <div class="modal-body">
                @L["Are you sure you want to delete this?"]
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">@L["Close"]</button>
                @if (Model.HasValue)
                {
                    <form  asp-action="Delete" asp-route-id="@Model.Value" method="post" class="d-inline">
                        <button type="submit" class="btn btn-danger">@L["Delete"]</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>


