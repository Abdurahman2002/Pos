@inject IUnitOfWork<SiteInfo> _siteInfo
@using System.Globalization
@{
    var siteInfo = _siteInfo.Repository.GetAll().SingleOrDefault();
    ViewBag.SiteName = siteInfo?.Name ?? "Perfect POS";
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POS</title>
    
    <!-- Bootstrap 5 -->
    @if (isRtl) {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
        <style>body { font-family: 'Cairo', sans-serif; }</style>
    } else {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
        <link href="https://fonts.googleapis.com/css?family=Nunito:400,600,700,800&display=swap" rel="stylesheet" />
        <style>body { font-family: 'Nunito', sans-serif; }</style>
    }
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://use.fontawesome.com/releases/v6.3.0/css/all.css" rel="stylesheet" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet" />
    
    <style>
        /* ==========================================================
           THE PERFECT POS OVERRIDES (Layout Specific)
           Transforms standard views into a Full-Screen Dashboard
           ========================================================== */
        body {
            background-color: #e2e8f0;
            height: 100vh;
            margin: 0;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        
        header.pos-header {
            background: #0f172a;
            color: #fff;
            height: 65px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            z-index: 100;
            flex-shrink: 0;
        }
        
        .pos-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden; /* Prevent body scroll */
            padding: 10px;
        }
        
        .erp-page-body {
            flex: 1;
            overflow-y: auto; 
            display: flex;
            flex-direction: column;
            width: 100%;
        }
        
        /* ----------------------------------------------------
           Targeting Create.cshtml Elements (NO HTML REWRITE NEEDED)
           ---------------------------------------------------- */
        form.invoice-create-form {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin: 0;
        }
        
        /* Eliminate top margin/padding on form elements */
        h1:first-of-type { display: none; } /* Hide duplicate title */
        
        /* Main Grid Row */
        form.invoice-create-form > .row.mb-3 {
            flex: 1;
            margin: 0;
            padding: 0;
        }
        
        /* Left Pane (Table) & Right Pane (Totals) */
        form.invoice-create-form > .row.mb-3 > .col-lg-8,
        form.invoice-create-form > .row.mb-3 > .col-lg-4 {
            display: flex;
            flex-direction: column;
            height: calc(100vh - 160px); /* Fill remaining height exactly */
        }
        
        /* ---------------- Left Panel Components ---------------- */
        .col-lg-8 .card { flex-shrink: 0; border: none; box-shadow: 0 4px 8px rgba(0,0,0,0.03); border-radius: 12px; }
        
        /* Flex Table Container */
        .col-lg-8 .card.shadow-sm.border-0 { 
            flex: 1; 
            display: flex; 
            flex-direction: column; 
            overflow: hidden; 
            margin-bottom: 0;
        }
        .col-lg-8 .table-responsive { 
            flex: 1; 
            overflow-y: auto; 
            max-height: none !important; 
        }
        .col-lg-8 .table-responsive::-webkit-scrollbar { width: 8px; }
        .col-lg-8 .table-responsive::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        
        #lines-table th { 
            background: #f8fafc; color: #475569; 
            padding: 15px 10px; font-size: 0.9rem; 
            text-transform: uppercase; font-weight: 800;
            position: sticky; top: 0; border-bottom: 2px solid #e2e8f0; z-index: 10;
        }
        #lines-table td { padding: 12px; vertical-align: middle; border-bottom: 1px solid #f1f5f9; font-weight: 600; }
        
        /* Inputs in Grid */
        .qty-input, .price-input, .line-total { 
            text-align: center; font-weight: 800; font-size: 1.15rem; border-color: #cbd5e1; border-radius: 8px;
        }
        .qty-input::placeholder,
        .price-input::placeholder,
        .sell-price-input::placeholder {
            color: #94a3b8;
            opacity: 1;
            font-weight: 600;
        }
        .line-total { background: #f8fafc; color: #2563eb; }
        .qty-input:focus, .price-input:focus { box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2); border-color: #10b981; }
        
        /* ---------------- Right Panel Components (Checkout) ---------------- */
        .col-lg-4 .card {
            height: 100%;
            overflow-y: auto;
            border: none;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.08); /* Heavier float effect */
            background: #fff;
        }
        .col-lg-4 .card::-webkit-scrollbar { width: 5px; }
        .col-lg-4 .card::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 5px; }
        
        /* Top Totals Board */
        #live-total-secondary { 
            font-size: 4rem !important; color: #10b981 !important; 
            font-weight: 900; text-shadow: 1px 1px 0px rgba(0,0,0,0.05); 
            line-height: 1; margin: 10px 0;
        }
        #live-total-eur { font-size: 1.5rem !important; color: #64748b; font-weight: 700;}
        .border-primary.border-opacity-25 { 
            border: none !important; background: #f8fafc; border-radius: 12px; padding: 25px !important;
        }
        
        /* Payment Toggles */
        #payment-method-buttons { gap: 10px !important; }
        #payment-method-buttons .form-check-label {
            font-size: 1.1rem;
            padding: 12px 5px !important; /* Made taller and wider inside */
            border-radius: 10px;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            font-weight: 800;
            background: #f1f5f9;
            color: #64748b;
            border: 2px solid transparent !important;
            min-width: 0 !important;
        }
        #payment-method-buttons .form-check-input:checked + .form-check-label {
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
            border-color: #10b981 !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(16, 185, 129, 0.15);
        }
        
        /* Big Checkout Button */
        #submit-pos-btn {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            border: none;
            font-size: 1.5rem;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 6px 15px rgba(16, 185, 129, 0.3);
            transition: all 0.3s;
            margin-top: 15px;
        }
        #submit-pos-btn:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
        }
        
        /* Top Input Barcode Area */
        #barcode-input { font-size: 1.35rem; padding: 15px; font-weight: bold; border-width: 2px; border-radius: 10px; }
        #barcode-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15); }
        
        /* Held Drafts outside form styling */
        .card.mt-4.border-secondary { 
            margin-top: 15px !important;
            border: none !important; 
            box-shadow: 0 4px 6px rgba(0,0,0,0.05); 
            border-radius: 12px;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body class="perfect-pos-mode">
    
    <!-- Minimal Top Header for POS -->
    <header class="pos-header">
        <div class="d-flex align-items-center">
            @if (ViewBag.LogoUrl != null)
            {
                <img src="~/upload/@ViewBag.LogoUrl" style="width:36px; height:36px; border-radius:8px; margin-left:12px;" alt="Logo" />
            }
            else
            {
                <i class="bi bi-shop fs-3 px-2 text-info rtl-ms-2"></i>
            }
            <div class="lh-1">
                <div class="fw-bold fs-5">@ViewBag.SiteName <span class="d-none d-md-inline text-info fs-6">| نظام الكاشير الذكي (POS)</span></div>
            </div>
        </div>
        
        <div class="d-flex align-items-center gap-4">
            <div class="text-info d-none d-md-block fw-bold fs-5 font-monospace" dir="ltr" id="pos-clock"></div>
            <a href="@Url.Action("Index", "StockBalances")" class="btn btn-danger btn-sm px-3 py-2 fw-bold shadow-sm" style="border-radius: 8px;">
                <i class="bi bi-box-arrow-right me-1"></i> <span class="d-none d-sm-inline">العودة للوحة الإدارة</span>
            </a>
        </div>
    </header>

    <!-- Grid Container -->
    <div class="pos-wrapper">
        <div class="erp-page-body">
            @RenderBody()
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ar.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    
    <script>
        (function () {
            function initSelect(el) {
                if (!el || el.tomselect || el.dataset.noTs !== undefined) return;
                new TomSelect(el, {
                    create: false,
                    allowEmptyOption: true,
                    sortField: { field: "text", direction: "asc" },
                    dropdownParent: 'body',
                    placeholder: el.dataset.placeholder || '',
                    hidePlaceholder: true
                });
            }

            document.querySelectorAll('select.form-select').forEach(initSelect);
            document.addEventListener('ts:refresh', function () {
                document.querySelectorAll('select.form-select').forEach(initSelect);
            });
        })();

        // Live Clock Script
        function updateClock() {
            const now = new Date();
            document.getElementById('pos-clock').textContent = now.toLocaleTimeString('en-US', { hour12: true, hour: '2-digit', minute:'2-digit', second:'2-digit' });
        }
        setInterval(updateClock, 1000);
        updateClock();
        
        // Auto Focus UX - Keeps scanner active when typing anywhere except inputs
        $(document).on('keydown', function(e) {
            // If user types directly and focus is not on input/textarea, focus barcode
            if (!$(e.target).is('input, textarea, select')) {
                // Ensure we don't interfere with Ctrl/Alt keys
                if(!e.ctrlKey && !e.altKey && !e.metaKey) {
                    $('#barcode-input').focus();
                }
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
    <partial name="Partial/_toast"></partial>
</body>
</html>
