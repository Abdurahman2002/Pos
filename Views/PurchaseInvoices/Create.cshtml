@model NewsApp2.ViewModels.Purchasing.PurchaseCreateVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@{
    ViewData["Title"] = "شاشة المشتريات";
    var lineCount = Model?.Lines?.Count > 0 ? Model.Lines.Count : 1;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var canCreateItem = User.IsInRole("Admin") || User.IsInRole("Prog") || User.IsInRole("SalesManager");
    var canCreateSupplier = User.IsInRole("Admin") || User.IsInRole("Prog") || User.IsInRole("SalesManager");
    var createItemUrl = Url.Action("Create", "Items", new { returnUrl }) ?? "/Items/Create";
    var createSupplierUrl = Url.Action("Create", "Suppliers", new { returnUrl }) ?? "/Suppliers/Create";
    var itemDefaultPricesJson = ViewBag.ItemDefaultPricesJson as string ?? "{}";
    var itemSalePricesJson = ViewBag.ItemSalePricesJson as string ?? "{}";      
    var localDraftKey = "purchase.create." + ((User?.Identity?.Name ?? "anonymous").Trim().ToLowerInvariant());
}

<!-- NEW CSS for Dashboard/POS-like Layout -->
<style>
    .pos-layout {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 15px;
    }
    
    .pos-main-panel {
        flex: 1 1 65%;
        min-width: 320px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .pos-side-panel {
        flex: 1 1 30%;
        min-width: 320px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .invoice-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.04);
        border: none;
        overflow: hidden;
    }

    .invoice-card-header {
        background: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        padding: 14px 20px;
        font-weight: 800;
        color: #1e293b;
        font-size: 1.15rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .barcode-input-group {
        border-radius: 50px;
        overflow: hidden;
        border: 2px solid #4f46e5;
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.15);
    }
    .barcode-input-group input {
        border: none !important;
        box-shadow: none !important;
        padding: 14px 24px;
        font-size: 1.2rem;
        font-weight: bold;
    }
    .barcode-input-group .btn {
        border-radius: 0;
        padding: 0 25px;
        font-weight: bold;
        font-size: 1.1rem;
    }

    .purchase-lines-table {
        max-height: calc(100vh - 300px);
        overflow-y: auto;
        width: 100%;
        background: #fff;
    }
    
    .purchase-lines-table table { 
        margin: 0; 
        table-layout: fixed;
        width: 100%;
    }
    .purchase-lines-table thead th {
        position: sticky;
        top: 0;
        background: #f4f4f5;
        color: #475569;
        font-weight: 800;
        z-index: 5;
        padding: 15px;
        border-bottom: 2px solid #cbd5e1;
        text-transform: uppercase;
        font-size: 0.9rem;
    }
    
    .purchase-lines-table tbody td {
        vertical-align: middle;
        padding: 12px 15px;
        border-bottom: 1px solid #f8fafc;
    }

    .qty-input, .price-input, .sell-price-input, .line-total {
        border-radius: 8px;
        text-align: center;
        font-weight: 800;
    }
    
    .qty-input { border-color: #cbd5e1; color: #0f172a; }
    .qty-input:focus { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2); }
    
    .line-total { background: #f8fafc !important; color: #1e40af; border: 1px dashed #cbd5e1; }

    .qty-input::placeholder,
    .price-input::placeholder,
    .sell-price-input::placeholder {
        color: #94a3b8;
        opacity: 1;
        font-weight: 600;
    }

    .invoice-date-input {
        direction: ltr;
        unicode-bidi: isolate;
        text-align: center;
        font-weight: 800;
        letter-spacing: 0.3px;
    }
    
    /* Hide number arrows */
    input[type=number]::-webkit-inner-spin-button, 
    input[type=number]::-webkit-outer-spin-button { 
        -webkit-appearance: none; 
        margin: 0; 
    }
    input[type=number] {
        -moz-appearance: textfield;
    }
    
    .summary-card {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        color: #fff;
        border-radius: 14px;
        padding: 24px;
        position: relative;
        overflow: hidden;
    }
    
    /* Decoration circles for summary card */
    .summary-card::before {
        content: ""; position: absolute; top: -30px; right: -30px;
        width: 100px; height: 100px; border-radius: 50%;
        background: rgba(255,255,255,0.05);
    }
    .summary-card::after {
        content: ""; position: absolute; bottom: -20px; left: -20px;
        width: 80px; height: 80px; border-radius: 50%;
        background: rgba(255,255,255,0.05);
    }

    .summary-val {
        font-size: 2.2rem;
        font-weight: 900;
        color: #34d399;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }
    
    .summary-secondary-val {
        font-size: 1.3rem;
        font-weight: 700;
        color: #cbd5e1;
    }

    .action-btn {
        padding: 16px;
        font-size: 1.25rem;
        font-weight: 800;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        transition: all 0.2s;
    }
    .action-btn:hover { transform: translateY(-3px); box-shadow: 0 8px 15px rgba(0,0,0,0.1); }
    .action-btn:active { transform: translateY(0); }

</style>

<div class="d-flex justify-content-between align-items-center mb-1">
    <h2 class="mb-0 fw-bold text-dark"><i class="mdi mdi-cart-arrow-down text-primary mdi-36px align-middle"></i> شاشة إدخال المشتريات</h2>
    <div class="text-muted fw-bold d-none d-md-block">
        <span class="badge bg-white shadow-sm text-dark border px-3 py-2 me-1"><i class="mdi mdi-keyboard text-primary"></i> F9 حفظ</span>
        <span class="badge bg-white shadow-sm text-dark border px-3 py-2 me-1"><i class="mdi mdi-keyboard text-primary"></i> F4 إضافة سطر</span>
        <span class="badge bg-white shadow-sm text-dark border px-3 py-2"><i class="mdi mdi-keyboard text-primary"></i> F2 الباركود</span>
    </div>
</div>

<script id="item-default-prices-json" type="application/json">@Html.Raw(itemDefaultPricesJson)</script>
<script id="item-sale-prices-json" type="application/json">@Html.Raw(itemSalePricesJson)</script>

<form asp-action="Create" method="post" class="invoice-create-form w-100"
    data-resolve-url="@Url.Action("Resolve", "BarcodeScan")"
    data-map-url="@Url.Action("Map", "BarcodeScan")"
    data-create-item-url="@createItemUrl"
    data-can-create-item="@(canCreateItem ? "true" : "false")"
    data-msg-barcode-mapping-unavailable="خدمة ربط الباركود غير متاحة."
    data-msg-select-existing-item-first="اختر صنفا موجودا أولا."
    data-msg-unable-map-barcode="تعذر ربط الباركود بالصنف المحدد."
    data-msg-barcode-service-unavailable="خدمة الباركود غير متاحة."
    data-msg-unable-resolve-barcode="تعذر قراءة الباركود."
    data-msg-barcode-not-found="الباركود غير موجود."
    data-msg-camera-unavailable="ماسح الكاميرا غير متاح."
    data-msg-scan-or-type-first="امسح أو اكتب الباركود أولا."
    data-msg-unknown-with-create="الباركود {code} غير مربوط بصنف. يمكنك ربطه بصنف موجود أو إنشاء صنف جديد."
    data-msg-unknown-without-create="الباركود {code} غير مربوط بصنف. يمكنك ربطه بصنف موجود."
    data-create-supplier-url="@Url.Action("CreateSupplierInline", "PurchaseInvoices")"
    data-msg-supplier-name-required="اسم المورد مطلوب."
    data-msg-unable-create-supplier="تعذر إضافة المورد."
    data-item-default-prices='@Html.Raw(itemDefaultPricesJson)'
    data-item-sale-prices='@Html.Raw(itemSalePricesJson)'
    data-local-draft-key="@localDraftKey"
    data-local-draft-ttl-minutes="720">
    <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3"></div>

    <div class="pos-layout">
        <!-- ==== Main Panel (Barcode & Items Table) ==== -->
        <div class="pos-main-panel">
            
            <!-- Barcode Scanner Block -->
            <div class="invoice-card p-3 p-md-4" style="background: #eef2ff;">
                <div class="input-group barcode-input-group">
                    <span class="input-group-text bg-white border-0 text-indigo"><i class="mdi mdi-barcode-scan mdi-24px"></i></span>
                    <input type="text" id="barcode-input" class="form-control" placeholder="امسح أو اكتب باركود الصنف هنا... (F2)" autocomplete="off" autofocus />
                    <button type="button" class="btn btn-primary" id="barcode-add-btn">إضافة</button>
                    <button type="button" class="btn btn-dark" id="barcode-camera-btn"><i class="mdi mdi-camera"></i> مسح ضوئي</button>
                    @if (canCreateItem) {
                        <a href="@createItemUrl" class="btn btn-success" target="_blank"><i class="mdi mdi-plus-thick"></i> صنف جديد</a>
                    }
                </div>
                
                <div id="barcode-warning" class="alert alert-warning mt-3 mb-0 d-none fw-bold"></div>
                <div id="barcode-unknown-wrapper" class="alert alert-info border-info mt-3 mb-0 d-none shadow-sm">
                    <div class="d-flex flex-column gap-2">
                        <span id="barcode-unknown-message" class="fw-bold fs-5"></span>
                        <div class="row g-2 align-items-center">
                            <div class="col-md-6">
                                <select id="barcode-map-item-select" class="form-select form-select-lg fw-bold">
                                    <option value="">اختر صنف موجود...</option>     
                                    @if (ViewData["Items"] is SelectList mapItems)  
                                    {
                                        foreach (var item in mapItems)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 d-grid">
                                <button type="button" id="barcode-map-existing-btn" class="btn btn-success btn-lg fw-bold">ربط بصنف موجود</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items Table Block -->
            <div class="invoice-card flex-grow-1 d-flex flex-column shadow-lg">
                <div class="invoice-card-header d-flex justify-content-between">
                    <span><i class="mdi mdi-format-list-bulleted text-primary"></i> قائمة المشتريات</span>
                    <span class="badge bg-primary rounded-pill" id="items-count-badge">@lineCount</span>
                </div>
                <div class="purchase-lines-table">
                    <table class="table table-hover mb-0" id="lines-table">
                        <thead>
                            <tr>
                                <th style="width: 40%;">الصنف الوارد</th>
                                <th style="width: 12%;" class="text-center">الكمية</th>
                                <th style="width: 16%;" class="text-center">سعر الشراء</th>
                                <th style="width: 16%;" class="text-center">سعر البيع</th>
                                <th style="width: 16%;" class="text-center">إجمالي السطر</th>
                                <th style="width: 5%;" class="text-center"><i class="mdi mdi-cog"></i></th>
                            </tr>
                        </thead>
                        <tbody>
                        @for (int i = 0; i < lineCount; i++)
                        {
                            <tr>
                                <td>
                                    <select asp-for="Lines[i].ItemId" asp-items="@(ViewData["Items"] as SelectList)" class="form-select form-select-lg item-select fw-bold border-secondary shadow-none">
                                        <option value="">اختر الصنف...</option>
                                    </select>
                                    <span asp-validation-for="Lines[i].ItemId" class="text-danger small fw-bold"></span>
                                </td>
                                <td>
                                    <input asp-for="Lines[i].Qty" class="form-control qty-input bg-light" type="number" step="1" min="1" inputmode="numeric" placeholder="0" />
                                    <span asp-validation-for="Lines[i].Qty" class="text-danger small fw-bold"></span>
                                </td>
                                <td>
                                    <input asp-for="Lines[i].UnitPriceEur" class="form-control price-input fw-bold border-primary shadow-sm" type="number" step="0.01" min="0" placeholder="0.00" />
                                    <span asp-validation-for="Lines[i].UnitPriceEur" class="text-danger small fw-bold mt-1 d-block"></span>
                                </td>
                                <td>
                                    <input asp-for="Lines[i].SellPriceLyd" class="form-control sell-price-input fw-bold border-success shadow-sm" type="number" step="0.01" min="0" placeholder="0.00" />
                                    <span asp-validation-for="Lines[i].SellPriceLyd" class="text-danger small fw-bold mt-1 d-block"></span>
                                </td>
                                <td>
                                    <input class="form-control line-total fw-bold text-center" type="text" value="0.00" readonly tabindex="-1" />
                                </td>
                                <td class="text-center align-middle">
                                    <button type="button" class="btn btn-outline-danger btn-sm remove-line rounded-3 px-3 shadow-sm"><i class="mdi mdi-trash-can mdi-18px"></i></button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="p-3 border-top" style="background:#f8fafc;">
                    <button type="button" class="btn btn-primary fw-bold px-4 py-2 rounded-pill shadow-sm" id="add-line"><i class="mdi mdi-plus-thick"></i> إضافة صنف يدوياً (F4)</button>
                </div>
            </div>

        </div>

        <!-- ==== Sidebar Panel (Details & Actions) ==== -->
        <div class="pos-side-panel">
            
            <!-- Summary Block -->
            <div class="summary-card shadow-lg position-relative">
                <div class="text-uppercase tracking-wider mb-2" style="color: #94a3b8; font-size: 0.95rem; font-weight: 800;"><i class="mdi mdi-calculator"></i> إجمالي فاتورة المورد</div>
                <div class="d-flex align-items-baseline gap-2 mb-4">
                    <span id="live-total-eur" class="summary-val">0.00</span> 
                    <span class="fs-4 text-white fw-bold">د.ل</span>
                </div>
                <div class="pt-3 border-top border-secondary">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-light fw-bold fs-5">الصافي للدفع:</span>
                        <span id="live-total-secondary" class="summary-secondary-val">0.00</span>
                    </div>
                </div>
            </div>

            <!-- Invoice Details Block -->
            <div class="invoice-card flex-grow-1 border border-light">
                <div class="invoice-card-header">
                    <i class="mdi mdi-file-document-edit text-primary"></i> بيانات المعاملة
                </div>
                <div class="p-4">
                    <div class="mb-4">
                        <label asp-for="InvoiceDate" class="form-label fw-bold text-dark fs-6"></label>
                        @* Old readonly display-only date block kept for reference
                        @* <input asp-for="InvoiceDate" type="hidden" value="@Model.InvoiceDate.ToString("dd/MM/yyyy")" /> *@
                        @* <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white text-primary"><i class="mdi mdi-calendar-clock mdi-24px"></i></span>
                            <input id="InvoiceDateDisplay" class="form-control invoice-date-display" type="text" value="@Model.InvoiceDate.ToString("dd/MM/yyyy")" readonly lang="en-GB" />
                        </div> *@
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white text-primary"><i class="mdi mdi-calendar-clock mdi-24px"></i></span>
                            <input asp-for="InvoiceDate" type="date" class="form-control invoice-date-input" value="@Model!.InvoiceDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <span asp-validation-for="InvoiceDate" class="text-danger fw-bold mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PaymentMethod" class="form-label fw-bold text-dark fs-6">طريقة الدفع</label>
                        <select asp-for="PaymentMethod" class="form-select form-select-lg shadow-sm" id="payment-method">
                            <option value="Cash">نقدي</option>
                            <option value="Transfer">تحويل</option>
                            <option value="Credit">آجل</option>
                        </select>
                    <div class="mb-4 d-none" id="bank-wrapper">
                        <label asp-for="BankId" class="form-label fw-bold text-dark fs-6">المصرف</label>
                        <select asp-for="BankId" asp-items="@(ViewData["Banks"] as SelectList)" class="form-select form-select-lg shadow-sm" id="bank-id">
                            <option value="">اختر المصرف...</option>
                        </select>
                        <span asp-validation-for="BankId" class="text-danger fw-bold mt-1 d-block"></span>
                    </div>

                        <span asp-validation-for="PaymentMethod" class="text-danger fw-bold mt-1 d-block"></span>
                    </div>

                    <div class="mb-4" id="supplier-wrapper">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="SupplierId" class="form-label fw-bold text-dark fs-6 mb-0">المورد</label>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#quick-supplier-modal">+ إضافة مورد</button>
                        </div>
                        <select asp-for="SupplierId" asp-items="@(ViewData["Suppliers"] as SelectList)" class="form-select form-select-lg shadow-sm" id="supplier-id">
                            <option value="">اختر المورد...</option>
                        </select>
                        @if (canCreateSupplier)
                        {
                            <a href="@createSupplierUrl" class="small fw-bold mt-2 d-inline-block" target="_blank"><i class="mdi mdi-plus-circle"></i> إضافة مورد جديد</a>
                        }
                        <span asp-validation-for="SupplierId" class="text-danger fw-bold mt-1 d-block"></span>
                    </div>

                    <div class="mb-4" id="due-date-wrapper">
                        <label asp-for="DueDate" class="form-label fw-bold text-dark fs-6">تاريخ الاستحقاق</label>
                        <input asp-for="DueDate" type="date" class="form-control form-control-lg shadow-sm invoice-date-input" value="@(Model.DueDate.HasValue ? Model.DueDate.Value.ToString("yyyy-MM-dd") : string.Empty)" />
                        <small class="text-muted d-block mt-1">تاريخ الاستحقاق يعني آخر موعد سداد الفاتورة في حالة الشراء الآجل.</small>
                        <span asp-validation-for="DueDate" class="text-danger fw-bold mt-1 d-block"></span>
                    </div>
                    
                    <input asp-for="CurrencyCode" type="hidden" value="LYD" />      
                    <input asp-for="EurToDinarRateSnapshot" type="hidden" value="1" />

                    <div>
                        <label asp-for="Note" class="form-label fw-bold text-dark fs-6"></label>   
                        <textarea asp-for="Note" class="form-control form-control-lg shadow-sm" rows="3" placeholder="اكتب الملاحظات أو رقم فاتورة المورد هنا..." style="border-radius: 12px; font-weight:500;"></textarea>
                        <span asp-validation-for="Note" class="text-danger fw-bold mt-1 d-block"></span> 
                    </div>
                </div>
            </div>

            <!-- Actions Block -->
            <div class="mt-auto d-grid gap-3 pt-2">
                <button type="submit" class="btn btn-success action-btn text-white shadow-lg bg-gradient"><i class="mdi mdi-check-decagram mdi-36px"></i> ترحيل واعتماد (F9)</button>
                <a asp-action="Index" class="btn btn-secondary action-btn text-white shadow-sm"><i class="mdi mdi-keyboard-return mdi-24px"></i> رجوع للقائمة</a>
            </div>

        </div>
    </div>
</form>

<template id="line-template">
    <td>
        <select name="Lines[__index__].ItemId" class="form-select form-select-lg item-select fw-bold border-secondary shadow-none"> 
            <option value="">اختر الصنف...</option>
            @if (ViewData["Items"] is SelectList items)
            {
                foreach (var item in items)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            }
        </select>
    </td>
    <td><input name="Lines[__index__].Qty" class="form-control qty-input bg-light" type="number" step="1" min="1" inputmode="numeric" placeholder="0" /></td>
    <td>
        <input name="Lines[__index__].UnitPriceEur" class="form-control price-input fw-bold border-primary shadow-sm" type="number" step="0.01" min="0" placeholder="0.00" />
    </td>
    <td>
        <input name="Lines[__index__].SellPriceLyd" class="form-control sell-price-input fw-bold border-success shadow-sm" type="number" step="0.01" min="0" placeholder="0.00" />
    </td>
    <td><input class="form-control line-total fw-bold text-center" type="text" value="0.00" readonly tabindex="-1" /></td>
    <td class="text-center align-middle"><button type="button" class="btn btn-outline-danger btn-sm remove-line rounded-3 px-3 shadow-sm"><i class="mdi mdi-trash-can mdi-18px"></i></button></td>
</template>

<div class="modal fade" id="barcode-camera-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white border-0">
                <h5 class="modal-title"><i class="mdi mdi-qrcode-scan"></i> مسح الباركود بالكاميرا</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="ratio ratio-4x3 bg-black">
                    <video id="barcode-video" playsinline></video>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 justify-content-center">
                <div class="fw-bold text-muted"><i class="mdi mdi-information"></i> وجّه الكاميرا إلى الباركود وسيتم إضافة الصنف تلقائياً.</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="quick-supplier-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">إضافة مورد سريع</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="quick-supplier-error" class="alert alert-danger d-none"></div>
                <div class="mb-2">
                    <label class="form-label">اسم المورد</label>
                    <input id="quick-supplier-name" class="form-control" />
                </div>
                <div>
                    <label class="form-label">الهاتف</label>
                    <input id="quick-supplier-phone" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="quick-supplier-save">حفظ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/lines-table.js"></script>
    <script src="https://unpkg.com/@@zxing/library@latest"></script>

    @* إضافة اختصارات لوحة المفاتيح السحرية وتحديث العداد *@
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const updateItemsCount = () => {
                const rows = document.querySelectorAll('#lines-table tbody tr');
                const badge = document.getElementById('items-count-badge');
                if(badge) badge.innerText = rows.length;
            };

            // Observer to track table changes for items count
            const observer = new MutationObserver(updateItemsCount);
            const tbody = document.querySelector('#lines-table tbody');
            if(tbody) {
                observer.observe(tbody, { childList: true });
            }
        });

        document.addEventListener('keydown', function(e) {
            // F9 لترحيل الفاتورة
            if (e.key === 'F9') {
                e.preventDefault();
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'أمر إعتماد (F9)',
                        text: 'هل أنت متأكد من ترحيل فاتورة المشتريات بشكل نهائي؟',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: '<i class="mdi mdi-check"></i> نعم، رحِّل الفاتورة',
                        cancelButtonText: 'إلغاء',
                        confirmButtonColor: '#10b981',
                        cancelButtonColor: '#64748b'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            document.querySelector('.invoice-create-form').submit();
                        }
                    });
                } else {
                    if (confirm('هل أنت متأكد من ترحيل الفاتورة؟ (F9)')) {      
                        document.querySelector('.invoice-create-form').submit();
                    }
                }
            }

            // F4 لإضافة سطر يدوياً والتركيز عليه
            if (e.key === 'F4') {
                e.preventDefault();
                document.getElementById('add-line').click();
                setTimeout(() => {
                    const selects = document.querySelectorAll('#lines-table tbody select.item-select');
                    if (selects.length > 0) selects[selects.length - 1].focus();
                }, 100);
            }

            // التركيز على حقل الباركود بـ F2
            if (e.key === 'F2') {
                e.preventDefault();
                document.getElementById('barcode-input').focus();
            }
        });

        (function initPurchaseCreditUi() {
            const paymentMethod = document.getElementById('payment-method');
            const supplierWrapper = document.getElementById('supplier-wrapper');
            const bankWrapper = document.getElementById('bank-wrapper');
            const dueDateWrapper = document.getElementById('due-date-wrapper');
            const dueDateInput = document.getElementById('DueDate');
            const supplierInput = document.getElementById('supplier-id');
            const bankInput = document.getElementById('bank-id');
            if (!paymentMethod || !supplierWrapper || !dueDateWrapper || !dueDateInput || !supplierInput || !bankWrapper || !bankInput) return;

            const refresh = () => {
                const isCredit = (paymentMethod.value || '').toLowerCase() === 'credit';
                const isTransfer = (paymentMethod.value || '').toLowerCase() === 'transfer';
                supplierWrapper.classList.toggle('d-none', !isCredit);
                bankWrapper.classList.toggle('d-none', !isTransfer);
                dueDateWrapper.classList.toggle('d-none', !isCredit);
                dueDateInput.required = isCredit;
                supplierInput.required = isCredit;
                bankInput.required = isTransfer;
                if (!isCredit) {
                    supplierInput.value = '';
                    dueDateInput.value = '';
                }
                if (!isTransfer) {
                    bankInput.value = '';
                }
            };

            paymentMethod.addEventListener('change', refresh);
            refresh();
        })();

        (function initQuickSupplierCreate() {
            const form = document.querySelector('.invoice-create-form');
            const createUrl = form ? (form.dataset.createSupplierUrl || '') : '';
            const supplierSelect = document.getElementById('supplier-id');
            const modalEl = document.getElementById('quick-supplier-modal');
            const modal = modalEl ? new bootstrap.Modal(modalEl) : null;
            const nameInput = document.getElementById('quick-supplier-name');
            const phoneInput = document.getElementById('quick-supplier-phone');
            const saveBtn = document.getElementById('quick-supplier-save');
            const errorBox = document.getElementById('quick-supplier-error');
            const msgNameRequired = form ? (form.dataset.msgSupplierNameRequired || 'اسم المورد مطلوب.') : 'اسم المورد مطلوب.';
            const msgCreateFailed = form ? (form.dataset.msgUnableCreateSupplier || 'تعذر إضافة المورد.') : 'تعذر إضافة المورد.';
            if (!form || !createUrl || !supplierSelect || !modal || !nameInput || !saveBtn) return;

            const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const setError = (msg) => {
                if (!errorBox) return;
                errorBox.textContent = msg || '';
                errorBox.classList.toggle('d-none', !msg);
            };

            saveBtn.addEventListener('click', async function () {
                const name = (nameInput.value || '').trim();
                const phone = phoneInput ? (phoneInput.value || '').trim() : '';
                setError('');
                if (!name) {
                    setError(msgNameRequired);
                    return;
                }

                try {
                    const response = await fetch(createUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ name, phone })
                    });
                    const data = await response.json();
                    if (!response.ok || !data.success) {
                        setError((data && data.error) || msgCreateFailed);
                        return;
                    }

                    const option = document.createElement('option');
                    option.value = data.supplierId;
                    option.text = data.supplierName;
                    supplierSelect.appendChild(option);
                    supplierSelect.value = data.supplierId;
                    supplierSelect.dispatchEvent(new Event('change', { bubbles: true }));
                    document.dispatchEvent(new Event('ts:refresh'));

                    nameInput.value = '';
                    if (phoneInput) phoneInput.value = '';
                    setError('');
                    modal.hide();
                } catch {
                    setError(msgCreateFailed);
                }
            });
        })();
    </script>
}
