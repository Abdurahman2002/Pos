@model NewsApp2.ViewModels.Sales.SalesCreateVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L
@{
    Layout = "_LayoutPOS";
    ViewData["Title"] = "نقطة البيع";
    var lineCount = Model?.Lines?.Count > 0 ? Model.Lines.Count : 1;
    var simplePosMode = ViewBag.SimplePosMode is bool mode && mode;
    var maxCashierDiscountPercent = ViewBag.MaxCashierDiscountPercent is decimal d ? d : 10m;
    var maxCashierDiscountPercentText = maxCashierDiscountPercent.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var itemDefaultPricesJson = ViewBag.ItemDefaultPricesJson as string ?? "{}";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var canCreateItem = false;
    var canManagePricing = User.IsInRole("Admin") || User.IsInRole("Prog") || User.IsInRole("SalesManager") || User.IsInRole("Cashier");
    var createItemUrl = Url.Action("Create", "Items", new { returnUrl }) ?? "/Items/Create";
    var shiftReturnUrl = ViewBag.ShiftReturnUrl as string ?? Url.Action("Create", "SalesInvoices") ?? "/SalesInvoices/Create";
    var heldDrafts = ViewBag.HeldDrafts as IEnumerable<NewsApp2.ViewModels.Sales.SalesInvoiceDraftSummaryVM> ?? Enumerable.Empty<NewsApp2.ViewModels.Sales.SalesInvoiceDraftSummaryVM>();
    var createUrl = Url.Action("Create", "SalesInvoices") ?? "/SalesInvoices/Create";
    var autoPrintInvoiceId = ViewBag.AutoPrintInvoiceId as Guid?;
    var receiptUrlTemplate = Url.Action("Receipt", "SalesInvoices", new { id = "__invoiceId__", autoPrint = true }) ?? "/SalesInvoices/Receipt/__invoiceId__?autoPrint=true";
    var soundUserKey = (User?.Identity?.Name ?? "anonymous").Trim().ToLowerInvariant();
}

<h1>شاشة نقطة البيع</h1>
<script id="item-default-prices-json" type="application/json">@Html.Raw(itemDefaultPricesJson)</script>
<form asp-action="Create" method="post" class="invoice-create-form"
    data-resolve-url="@Url.Action("Resolve", "BarcodeScan")"
    data-map-url="@Url.Action("Map", "BarcodeScan")"
    data-create-item-url="@createItemUrl"
    data-can-create-item="@(canCreateItem ? "true" : "false")"
    data-hold-url="@Url.Action("Hold", "SalesInvoices")"
    data-new-url="@createUrl"
    data-text-post-sale="ترحيل البيع"
    data-text-post-return="ترحيل المرتجع"
    data-msg-barcode-mapping-unavailable="خدمة ربط الباركود غير متاحة."
    data-msg-select-existing-item-first="اختر صنفا موجودا أولا."
    data-msg-unable-map-barcode="تعذر ربط الباركود بالصنف المحدد."
    data-msg-hold-service-unavailable="خدمة تعليق الفاتورة غير متاحة."
    data-msg-unable-hold-invoice="تعذر تعليق الفاتورة."
    data-msg-barcode-service-unavailable="خدمة الباركود غير متاحة."
    data-msg-unable-resolve-barcode="تعذر قراءة الباركود."
    data-msg-barcode-not-found="الباركود غير موجود."
    data-msg-camera-unavailable="ماسح الكاميرا غير متاح."
    data-msg-scan-or-type-first="امسح أو اكتب الباركود أولا."
    data-msg-unknown-with-create="الباركود {code} غير مربوط بصنف. يمكنك ربطه بصنف موجود أو إنشاء صنف جديد."
    data-msg-unknown-without-create="الباركود {code} غير مربوط بصنف. يمكنك ربطه بصنف موجود."
    data-simple-pos-mode="@(simplePosMode ? "true" : "false")"
    data-max-cashier-discount-percent="@maxCashierDiscountPercentText"
    data-sound-user-key="@soundUserKey"
    data-item-default-prices='@itemDefaultPricesJson'>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="DraftId" type="hidden" />

    <div class="card mb-3 border-success-subtle shadow-sm" style="border-radius: 10px;">
        <div class="card-body d-flex flex-wrap gap-3 align-items-center bg-light">
            @if (!simplePosMode)
            {
                <div class="d-flex align-items-center gap-3 border rounded px-3 py-1 bg-white shadow-sm">
                    <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                        <input asp-for="IsReturn" class="form-check-input mt-0 fs-5" id="is-return-toggle" style="cursor: pointer;" />
                        <label class="form-check-label fw-bold text-danger m-0" for="is-return-toggle" style="cursor: pointer;">
                            <i class="mdi mdi-keyboard-return"></i> إسترجاع
                        </label>
                    </div>
                    <div class="vr mx-1 bg-secondary opacity-25"></div>
                    <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                        <input asp-for="AutoPrintReceipt" class="form-check-input mt-0 fs-5" id="auto-print-toggle" style="cursor: pointer;" />
                        <label class="form-check-label fw-bold text-primary m-0" for="auto-print-toggle" style="cursor: pointer;">
                            <i class="mdi mdi-printer"></i> طباعة تلقائية
                        </label>
                    </div>
                </div>
                <!-- Hold Invoice Button -->
                <button type="button" class="btn btn-warning fw-bold d-flex align-items-center shadow-sm" id="hold-invoice-btn" title="تعليق الفاتورة (F4)">
                    <i class="mdi mdi-pause-circle fs-5 me-1"></i> تعليق مؤقت
                </button>
                
                <!-- Held Drafts Button Trigger for Offcanvas -->
                <button type="button" class="btn btn-info text-white fw-bold d-flex align-items-center position-relative shadow-sm" data-bs-toggle="offcanvas" data-bs-target="#draftsOffcanvas" aria-controls="draftsOffcanvas" title="عرض الفواتير المعلقة (F9)">
                    <i class="mdi mdi-list-status fs-5 me-1"></i> المعلقة
                    @if (heldDrafts.Any())
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light">
                            @heldDrafts.Count()
                            <span class="visually-hidden">فواتير معلقة</span>
                        </span>
                    }
                </button>

                <!-- New Sale -->
                <a asp-action="Create" class="btn btn-primary fw-bold d-flex align-items-center shadow-sm" id="restore-invoice-btn" title="فاتورة جديدة">
                    <i class="mdi mdi-plus-box fs-5 me-1"></i> بيع جديد
                </a>

                @if (canManagePricing)
                {
                    <a asp-controller="Pricing" asp-action="Index" class="btn btn-secondary fw-bold d-flex align-items-center shadow-sm" title="التسعير">
                         <i class="mdi mdi-tag-multiple fs-5 me-1"></i> سياسة التسعير
                    </a>
                }
            }
            else
            {
                <div class="d-flex align-items-center gap-3 border rounded px-3 py-1 bg-white shadow-sm">
                    <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                        <input asp-for="IsReturn" class="form-check-input mt-0 fs-5" id="is-return-toggle-pos" style="cursor: pointer;" />
                        <label class="form-check-label fw-bold text-danger m-0" for="is-return-toggle-pos" style="cursor: pointer;">
                            <i class="mdi mdi-keyboard-return"></i> إسترجاع
                        </label>
                    </div>
                    <div class="vr mx-1 bg-secondary opacity-25"></div>
                    <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                        <input asp-for="AutoPrintReceipt" class="form-check-input mt-0 fs-5" id="auto-print-toggle-pos" style="cursor: pointer;" />
                        <label class="form-check-label fw-bold text-primary m-0" for="auto-print-toggle-pos" style="cursor: pointer;">
                            <i class="mdi mdi-printer"></i> طباعة تلقائية
                        </label>
                    </div>
                </div>
                <button type="button" class="btn btn-warning fw-bold d-flex align-items-center shadow-sm" id="hold-invoice-btn" title="تعليق">
                    <i class="mdi mdi-pause-circle fs-5 me-1"></i> تعليق
                </button>
                <a asp-action="Create" class="btn btn-primary fw-bold d-flex align-items-center shadow-sm" title="جديد">
                    <i class="mdi mdi-plus-box fs-5 me-1"></i> جديد
                </a>
                <a asp-action="Drafts" class="btn btn-info text-white fw-bold d-flex align-items-center shadow-sm position-relative">
                     <i class="mdi mdi-list-status fs-5 me-1"></i> المعلقات
                     @if (heldDrafts.Any())
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light">@heldDrafts.Count()</span>
                    }
                </a>
                <a asp-controller="PosShifts" asp-action="Current" asp-route-returnUrl="@shiftReturnUrl" class="btn btn-secondary fw-bold d-flex align-items-center shadow-sm">
                    <i class="mdi mdi-cash-register fs-5 me-1"></i> الوردية
                </a>
                @if (canManagePricing)
                {
                    <a asp-controller="Pricing" asp-action="Index" class="btn btn-outline-dark fw-bold d-flex align-items-center shadow-sm">سياسة التسعير</a>
                }
                <span class="text-muted small fw-bold ms-auto bg-white px-2 py-1 rounded border">كاشير سريع</span>
            }
        </div>
    </div>

    <div class="row mb-3">
        <!-- Main Area: Barcode & Items -->
        <div class="col-lg-8 mb-3 mb-lg-0">
            <div class="card mb-3">
                <div class="card-body p-2 p-md-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-6">
                            <label for="barcode-input" class="form-label form-label-sm fw-bold">إضافة صنف بالباركود</label>
                            <input type="text" id="barcode-input" class="form-control form-control-sm" placeholder="امسح أو اكتب الباركود" autocomplete="off" autofocus />
                        </div>
                        <div class="col-md-2 d-grid">
                            <button type="button" class="btn btn-primary btn-sm" id="barcode-add-btn">إضافة</button>
                        </div>
                        <div class="col-md-2 d-grid">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="barcode-camera-btn">الكاميرا</button>
                        </div>
                        <div class="col-md-2 d-grid">
                            <button type="button" class="btn btn-outline-warning btn-sm" id="barcode-undo-btn" title="Ctrl+Z">تراجع آخر مسح</button>
                        </div>
                        @if (canCreateItem)
                        {
                            <div class="col-md-2 d-grid">
                                <a href="@createItemUrl" class="btn btn-outline-primary btn-sm" target="_blank">جديد</a>
                            </div>
                        }
                    </div>
                    <div id="barcode-warning" class="alert alert-warning mt-2 mb-0 d-none py-2 px-3"></div>
                    <div id="barcode-last-added" class="alert alert-success mt-2 mb-0 d-none py-2 px-3">
                        <span class="fw-semibold">تمت الإضافة:</span>
                        <span id="barcode-last-added-text"></span>
                    </div>
                    <div class="small text-muted mt-2">
                        اختصارات الكاشير: <span class="fw-semibold">F2</span> للتركيز على الباركود - <span class="fw-semibold">Ctrl+Z</span> للتراجع عن آخر مسح.
                    </div>
                    <div class="form-check form-switch mt-2 mb-0">
                        <input class="form-check-input" type="checkbox" id="barcode-sound-toggle" checked />
                        <label class="form-check-label small text-muted" for="barcode-sound-toggle">تشغيل صوت المسح (محفوظ لهذا المستخدم)</label>
                    </div>
                    <div id="barcode-unknown-wrapper" class="alert alert-info mt-2 mb-0 d-none py-2 px-3">
                        <div class="d-flex flex-column gap-2">
                            <span id="barcode-unknown-message"></span>
                            <div class="row g-2 align-items-center">
                                <div class="col-md-6">
                                    <select id="barcode-map-item-select" class="form-select form-select-sm">
                                        <option value="">اختر صنف موجود...</option>
                                        @if (ViewData["Items"] is SelectList mapItems)
                                        {
                                            foreach (var item in mapItems)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3 d-grid">
                                    <button type="button" id="barcode-map-existing-btn" class="btn btn-sm btn-success">ربط بصنف موجود</button>
                                </div>
                                <div class="col-md-3 d-grid">
                                    <a id="barcode-create-item-link" class="btn btn-sm btn-primary @(canCreateItem ? "" : "d-none")" target="_blank">إضافة صنف جديد</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-3">
                <div class="table-responsive" style="min-height: 200px; max-height: calc(100vh - 450px); overflow-y: auto;">
                    <table class="table table-sm table-hover mb-0" id="lines-table">
                        <thead class="table-light sticky-top" style="z-index: 5;">
                            <tr>
                                <th>الصنف</th>
                                <th style="width: 100px;">الكمية</th>
                                <th style="width: 120px;">سعر الوحدة</th>
                                <th style="width: 120px;">إجمالي السطر</th>
                                <th style="width: 60px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @for (int i = 0; i < lineCount; i++)
                        {
                            <tr>
                                <td>
                                    <select asp-for="Lines[i].ItemId" asp-items="@(ViewData["Items"] as SelectList)" class="form-select form-select-sm item-select">
                                        <option value="">اختر الصنف...</option>
                                    </select>
                                    <span asp-validation-for="Lines[i].ItemId" class="text-danger small"></span>
                                </td>
                                <td>
                                    <input asp-for="Lines[i].Qty" class="form-control form-control-sm qty-input" type="number" step="1" min="1" inputmode="numeric" placeholder="0" />
                                    <span asp-validation-for="Lines[i].Qty" class="text-danger small"></span>
                                </td>
                                <td>
                                    <input asp-for="Lines[i].UnitPriceEur" class="form-control form-control-sm price-input" type="number" step="0.01" min="0" placeholder="0.00" readonly="@(simplePosMode ? "readonly" : null)" />
                                    <span asp-validation-for="Lines[i].UnitPriceEur" class="text-danger small"></span>
                                </td>
                                <td>
                                    <input class="form-control form-control-sm line-total" type="text" value="0.00" readonly />
                                </td>
                                <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-line px-2" title="حذف"><i class="bi bi-trash"></i>حذف</button></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white p-2 text-center text-md-start">
                    <button type="button" class="btn btn-sm btn-outline-primary fw-bold" id="add-line" title="إضافة صنف يدوياً من القائمة">
                        <i class="mdi mdi-plus-box-outline"></i> إضافة صنف يدوياً
                    </button>
                </div>
            </div>
        </div>

        <!-- Side Panel: Settings & Totals -->
        <div class="col-lg-4">
            <div class="card bg-light shadow-sm sticky-top" style="top: 1rem; z-index: 10;">
                <div class="card-body p-3">
                    <!-- Totals Header -->
                    <div class="bg-white p-3 rounded mb-3 text-center border border-2 border-primary border-opacity-25 pb-2">
                        <div class="mb-1 text-muted small fw-bold">الإجمالي</div>
                        <div id="live-total-eur" class="fs-5 fw-semibold mb-2">0.00</div>
                        <div class="mb-1 text-muted small fw-bold">الصافي</div>
                        <div id="live-total-secondary" class="fs-2 text-primary fw-bold lh-1 mb-1">0.00</div>
                        
                        <span id="live-discount-eur" class="d-none">0.00</span>
                        <span id="live-net-eur" class="d-none">0.00</span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="InvoiceDate" class="form-label form-label-sm mb-1 fw-bold text-muted small"></label>
                        @* Old line kept for reference: <input asp-for="InvoiceDate" type="hidden" value="@(Model.InvoiceDate.ToString("dd/MM/yyyy"))" /> *@
                        @* Old line kept for reference: <input id="InvoiceDateDisplay" class="form-control form-control-sm text-center fw-bold" type="text" value="@(Model.InvoiceDate.ToString("dd/MM/yyyy"))" readonly dir="ltr" lang="en-GB" style="unicode-bidi: plaintext;" /> *@
                        <input id="InvoiceDateDisplay" class="form-control form-control-sm text-center fw-bold" type="text" value="@((Model?.InvoiceDate ?? DateOnly.FromDateTime(DateTime.UtcNow)).ToString("dd/MM/yyyy"))" readonly dir="ltr" lang="en-GB" style="direction:ltr; unicode-bidi:isolate;" />
                    </div>
                    <input asp-for="CurrencyCode" type="hidden" />
                    <input asp-for="EurToDinarRateSnapshot" type="hidden" value="1" />
                    @if (simplePosMode)
                    {
                        <input asp-for="DiscountType" type="hidden" value="Percent" />
                    }
                    else
                    {
                        <input asp-for="DiscountType" type="hidden" value="Amount" />
                        <input asp-for="DiscountValue" type="hidden" value="0" />
                    }

                    <div class="mb-3">
                        <label asp-for="PaymentMethod" class="form-label form-label-sm mb-1 fw-bold text-muted small">طريقة الدفع</label>
                        <div class="d-flex flex-wrap gap-1" id="payment-method-buttons">
                            <div class="form-check payment-choice flex-fill m-0">
                                <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="Cash" id="pm-cash" />
                                <label class="form-check-label w-100 py-1 px-2 border rounded text-center small" for="pm-cash">نقدي</label>
                            </div>
                            <div class="form-check payment-choice flex-fill m-0">
                                <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="Card" id="pm-card" />
                                <label class="form-check-label w-100 py-1 px-2 border rounded text-center small" for="pm-card">بطاقة</label>
                            </div>
                            <div class="form-check payment-choice flex-fill m-0">
                                <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="Transfer" id="pm-transfer" />
                                <label class="form-check-label w-100 py-1 px-2 border rounded text-center small" for="pm-transfer">تحويل</label>
                            </div>
                            <div class="form-check payment-choice flex-fill m-0 mt-1 w-100">
                                <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="Credit" id="pm-credit" />
                                <label class="form-check-label w-100 py-1 px-2 border rounded text-center small" for="pm-credit">آجل (غير مدفوع)</label>
                            </div>
                        </div>
                        <span asp-validation-for="PaymentMethod" class="text-danger small d-block mt-1"></span>
                    </div>

                    @if (simplePosMode)
                    {
                        <div class="mb-3">
                            <label asp-for="DiscountValue" class="form-label form-label-sm mb-1 fw-bold text-muted small">نسبة الخصم %</label>
                            <input asp-for="DiscountValue" class="form-control form-control-sm" type="number" step="0.01" min="0" max="@maxCashierDiscountPercentText" />
                            <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                            <div class="form-text mt-0 very-small">أقصى حد: @maxCashierDiscountPercent.ToString("0.##")%</div>
                        </div>
                    }

                    @if (!simplePosMode)
                    {
                        <div class="mb-3">
                            <label asp-for="Note" class="form-label form-label-sm mb-1 fw-bold text-muted small"></label>
                            <textarea asp-for="Note" class="form-control form-control-sm" rows="2"></textarea>
                            <span asp-validation-for="Note" class="text-danger small"></span>
                        </div>
                    }
                    else
                    {
                        <input asp-for="Note" type="hidden" />
                    }

                    <div class="mb-3 d-none" id="customer-section">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <label asp-for="CustomerId" class="form-label form-label-sm mb-0 fw-bold text-muted small">العميل (للبيع الآجل)</label>
                        </div>
                        <select asp-for="CustomerId" asp-items="@(ViewData["Customers"] as SelectList)" class="form-select form-select-sm">
                            <option value="">اختر العميل</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mt-4 pt-2 border-top">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold w-100" id="submit-pos-btn">ترحيل البيع</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@if (!simplePosMode)
{
    <!-- Offcanvas for Held Drafts -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="draftsOffcanvas" aria-labelledby="draftsOffcanvasLabel">
        <div class="offcanvas-header bg-light border-bottom">
            <h5 class="offcanvas-title fw-bold text-secondary" id="draftsOffcanvasLabel">
                <i class="mdi mdi-pause-circle-outline me-1"></i> الفواتير المعلقة
                <span class="badge bg-danger rounded-pill ms-2" style="font-size: 0.8rem;">@heldDrafts.Count()</span>
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            @if (!heldDrafts.Any())
            {
                <div class="p-4 text-center text-muted">لا توجد فواتير معلقة حالياً.</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var draft in heldDrafts)
                    {
                        <div class="list-group-item p-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="fw-bold fs-6">
                                        @draft.Title
                                        @if (draft.IsReturn)
                                        {
                                            <span class="badge bg-danger ms-2">ترجيع</span>
                                        }
                                    </div>
                                    <div class="small text-muted mt-1"><i class="mdi mdi-calendar"></i> <span dir="ltr">@draft.InvoiceDate.ToString("dd/MM/yyyy")</span></div>
                                </div>
                                <div class="fw-bold text-success fs-6">@draft.NetDinar.ToString("0.00") د.ل</div>
                            </div>
                            @if (draft.ItemNames.Any())
                            {
                                <div class="small text-secondary mb-3 bg-light p-2 rounded" style="white-space: normal; line-height: 1.4;">
                                    <i class="mdi mdi-format-list-bulleted me-1"></i> @draft.LineCount أصناف: <br/>
                                    @string.Join("، ", draft.ItemNames)
                                </div>
                            }
                            <div class="d-flex gap-2">
                                <a class="btn btn-sm btn-primary flex-grow-1 fw-bold" asp-action="Create" asp-route-draftId="@draft.Id" title="استرجاع الفاتورة للمتابعة">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> إسترجاع
                                </a>
                                <form asp-action="DeleteDraft" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@draft.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('هل أنت متأكد من حذف هذه الفاتورة المعلقة نهائياً؟');" title="حذف الفاتورة">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<template id="line-template">
    <td>
        <select name="Lines[__index__].ItemId" class="form-select form-select-sm item-select">
            <option value="">اختر الصنف...</option>
            @if (ViewData["Items"] is SelectList items)
            {
                foreach (var item in items)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            }
        </select>
    </td>
    <td><input name="Lines[__index__].Qty" class="form-control form-control-sm qty-input" type="number" step="1" min="1" inputmode="numeric" placeholder="0" /></td>
    <td><input name="Lines[__index__].UnitPriceEur" class="form-control form-control-sm price-input" type="number" step="0.01" min="0" placeholder="0.00" readonly="@(simplePosMode ? "readonly" : null)" /></td>
    <td><input class="form-control form-control-sm line-total" type="text" value="0.00" readonly /></td>
    <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-line px-2" title="حذف"><i class="bi bi-trash"></i>حذف</button></td>
</template>

<div class="modal fade" id="barcode-camera-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">مسح الباركود</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="ratio ratio-4x3 bg-dark">
                    <video id="barcode-video" playsinline></video>
                </div>
                <div class="small text-muted mt-2">وجّه الكاميرا إلى الباركود وسيتم إضافة الصنف تلقائيا.</div>
            </div>
        </div>
    </div>
</div>

<style>
    #payment-method-buttons .payment-choice {
        margin: 0;
    }

    #payment-method-buttons .payment-choice .form-check-input {
        display: none;
    }

    #payment-method-buttons .payment-choice .form-check-label {
        border: 1px solid #ced4da;
        border-radius: 0.6rem;
        padding: 0.65rem 1.1rem;
        font-weight: 600;
        cursor: pointer;
        user-select: none;
        min-width: 120px;
        text-align: center;
        background: #fff;
    }

    #payment-method-buttons .payment-choice .form-check-input:checked + .form-check-label {
        background: #0d6efd;
        border-color: #0d6efd;
        color: #fff;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/lines-table.js"></script>
    <script src="https://unpkg.com/@@zxing/library@latest"></script>
    <script>
        (function () {
            var autoPrintInvoiceId = '@(autoPrintInvoiceId?.ToString() ?? string.Empty)';
            if (!autoPrintInvoiceId) {
                return;
            }

              var receiptUrlTemplate = '@Html.Raw(receiptUrlTemplate)';
              var receiptUrl = receiptUrlTemplate.replace('__invoiceId__', autoPrintInvoiceId);
              
              // إضافة متغير لمعرفة أنها في نافذة خفية والطباعة الصامتة
              receiptUrl += "&isIframe=true";

              // إنشاء نافذة خفية للطباعة بدون تغيير الصفحة الحالية ولا نوافذ منبثقة جديدة
              var printFrame = document.createElement("iframe");
              printFrame.style.position = "absolute";
              printFrame.style.width = "0px";
              printFrame.style.height = "0px";
              printFrame.style.border = "none";
              printFrame.src = receiptUrl;
              
              document.body.appendChild(printFrame);
              
              // بمجرد أن يحصل الطباعة سيظل ال iframe موجودا لفترة ثم يحذف لتنظيف الصفحة من الذاكرة
              setTimeout(function () {
                  if (document.body.contains(printFrame)) {
                      document.body.removeChild(printFrame);
                  }
              }, 10000);
        })();
    </script>
}


