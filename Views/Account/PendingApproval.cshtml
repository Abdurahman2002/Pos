@inject Microsoft.Extensions.Localization.IStringLocalizer<NewsApp2.SharedViewResource> L

@{
    ViewData["Title"] = L["Pending Approval"];
}

<div class="container py-5" style="min-height:75vh">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-lg-5 text-center">
                    <div class="mb-3">
                        <i class="bi bi-hourglass-split" style="font-size:48px;"></i>
                    </div>
                    <h3 class="fw-bold mb-3">@L["Your request is pending approval"]</h3>
                    <p class="text-muted">
                        @L["Your account was created successfully, but you cannot access inventory features until an admin approves your request."]
                    </p>
                    <div class="alert alert-info d-inline-block mt-3">
                        @L["Please wait for approval from the administrator."]
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
