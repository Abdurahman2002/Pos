@model List<UserRolesVM>


    @*انتبه لا تضع اسم الاكشن في الفورم يكون في البوتون فقط لأن هذه الصفحة جزء من صفحة EditUser*@
<form method="post">

    <input type="hidden" name="UserId" value="@ViewBag.UserId" />

    <div class="roles-wrapper">

        @for (int i = 0; i < Model.Count; i++)
        {
            bool isReadonlyRole =
            Model[i].RoleName == "EmployeePending";

            <input type="hidden" asp-for="@Model[i].RoleId" />
            <input type="hidden" asp-for="@Model[i].RoleName" />

            <div class="role-row 
                         @(Model[i].IsSelected ? "active" : "")
                         @(isReadonlyRole ? "readonly" : "")">

                <div class="role-info">
                    <div class="role-icon">
                        <i class="bi  @(Model[i].IsSelected ? "bi-shield-check" : "bi-shield")"></i>
                    </div>

                    <div class="role-text">
                        <div class="role-name">
                            @Model[i].RoleName
                        </div>
                    </div>
                </div>

                <div class="role-action">
                    <div class="form-check form-switch">

                        <input asp-for="@Model[i].IsSelected"
                               class="form-check-input role-switch"
                               type="checkbox"
                               disabled="@isReadonlyRole" />
                        @*عندما يكون disabled لا ينقل القيمة للسيرفر لهذا يتم تخزينها داخل input hidden*@
                        @if (isReadonlyRole)
                        {
                            <input type="hidden" asp-for="@Model[i].IsSelected" />
                        }

                    </div>

                </div>

            </div>
        }

    </div>

    <div class="mt-4 d-flex justify-content-end">
        <button type="submit"
                asp-controller="Users"
                asp-action="EditUserRoles"
                class="btn btn-primary px-4 py-2 fw-semibold rounded-3">
            <i class="bi bi-check2-circle me-2"></i>
            Apply Changes
        </button>
    </div>

</form>

<style>
    .roles-wrapper {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .role-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 22px;
        border-radius: 18px;
        background: linear-gradient(180deg, #ffffff, #f8f9fb);
        border: 1px solid #e6e9ef;
        transition: all .25s ease;
    }

        .role-row:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(0,0,0,.08);
        }

        .role-row.active {
            background: linear-gradient(135deg, #e6f5ea, #f0f9f4);
            border-color: #28a745;
            box-shadow: 0 12px 30px rgba(40,167,69,.25);
        }

            .role-row.active .role-name {
                color: #28a745;
            }

            .role-row.active .role-icon {
                background: linear-gradient(135deg, #28a745, #218838);
                box-shadow: 0 8px 22px rgba(40,167,69,.45);
                color: #fff;
            }

        .role-row.readonly {
            opacity: .65;
            cursor: not-allowed;
        }

            .role-row.readonly:hover {
                transform: none;
                box-shadow: none;
            }

            .role-row.readonly .role-switch {
                cursor: not-allowed;
            }

    .role-info {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .role-icon {
        width: 50px;
        height: 50px;
        border-radius: 16px;
        background: #eef2f7;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        transition: .25s;
    }

    .role-name {
        font-weight: 700;
        font-size: 17px;
        color: #212529;
    }

    .role-switch {
        width: 54px;
        height: 26px;
        cursor: pointer;
    }
</style>



